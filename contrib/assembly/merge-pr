#!/bin/sh
# merge-pr: merges the pull request a pr bead tracks, on GitHub, as the yard's
# GitHub App, when the bead is in approved and carries the label merge-ok. Run
# it as the cmd of an exec group (pr-merges, limit 1: one merge at a time),
# routed for the pr flow's approved stage (type pr, label merge-ok). The
# contributors pack's flows/pr/approved.md says who gives the label: the
# reviewer, for a bot's bump of Go modules, or a maintainer, whose yes is
#
#   yardr bead update <bead> --add-label merge-ok --meta merge_head=<sha>
#
# with the sha of the head commit they looked at on the pull request's page.
#
# The pull request is the one the bead tracks (its tracks link, whose URL must
# be https://github.com/<owner>/<repo>/pull/<n> and nothing else), never one
# found by a name in metadata or by a branch. GitHub is asked as an installation
# token of the App scoped to that repository, minted by contrib/github-mint
# (the github source's mint_command, or YARDR_GITHUB_MINT in the group's cmd) from
# GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY_FILE, which the group's env_file
# supplies: no secret of its own, and the operator's own gh login is never
# used. Needs gh and jq on PATH. The token is narrowed to contents write and
# pull_requests read (PERMS below): merging wants Contents write of it,
# deleting the branch wants Contents write, and reading the pull request
# wants Pull requests read (GitHub's REST docs, "Merge a pull request" and
# "Get a pull request"; "Permissions required for GitHub Apps" for the
# deleted branch).
#
# Whose head is merged: the live head when the author is a bot and the head
# branch is in the pull request's own repository (Dependabot's, which rebases
# all the time, so that a recorded sha would hold every one of them); for
# anything else, a human's fork or a human's branch in the repository, or a
# bot's pull request from a fork, only the commit the maintainer's yes
# recorded (the bead's metadata merge_head, a full sha), and a head that is
# another commit now is held: "moved since your yes". The yard's CI must have
# passed on that commit: the bead's metadata ci_head, which pr-ci records in
# ciwait, is it, and GitHub's check runs are not asked (one source of truth is
# enough, Actions or not). A fork is merged with a merge commit and its
# branch is left alone, being its author's; a branch of the repository's own is
# rebased on and deleted. --match-head-commit closes the gap between the look
# and the merge.
#
# Option, set in the group's cmd:
#
#   YARDR_LAND  rebase (default) or squash: how a branch of the repository's own
#               is merged. With squash it becomes one commit on the base whose
#               subject and message are the pull request's title and body, as
#               the pull request has them when it is merged: the public line's
#               open-pr writes them as the squash commit merge-local would have
#               written (docs/line.md, "The public line"). A fork is merged with
#               a merge commit either way. Any other value holds the bead before
#               anything is merged.
#
# The outcomes at approved are merged and dropped, and nothing here reports
# anything else. A pull request already merged reports merged, one closed
# unmerged reports dropped; every other thing that stops the merge (no label,
# no yes, a head that moved, CI not passed on it, the App without the
# permissions it needs, GitHub's refusal) holds the bead with a note, for a
# maintainer to act on, on GitHub or by sending the bead back to ciwait, then
# unhold (pr-ci tests only a head a reviewer read, and holds one none did).
# Nothing here retries.
#
# It reads the environment the exec runner gives it: YARDR_BEAD and YARDR_BIN.
# The depot's checkout is never touched: GitHub is the whole of it.
#
# Every outcome ends in a report or a hold: exiting without one counts as a
# failed session, and three of those hold the bead.
set -u
: "${YARDR_BEAD:?not run by an exec group}"
Y=${YARDR_BIN:-yardr}
BEAD=$YARDR_BEAD
echo "== $(date '+%Y-%m-%dT%H:%M:%S%z') merge-pr $BEAD"

# bye takes away everything the script made, whichever of it exists. It is the
# first thing hold and report do, so that nothing is left to do once the
# session ends (the daemon stops the script as soon as it has reported), and
# the EXIT trap, for every other way out. The directory the script works in
# goes from outside it. TERM and INT are ignored while it runs, so that a stop
# of the session that comes meanwhile cannot leave it half done.
bye() {
  trap '' TERM INT
  cd /
  [ -z "${work:-}" ] || rm -rf "${work:?}"
  return 0
}
trap 'bye' EXIT
# A signal that kills the script does not run its EXIT trap in every shell
# (dash's does not), so TERM and INT exit, which does, as a shell would, 128+n.
trap 'exit 143' TERM
trap 'exit 130' INT

# Reporting ends this session (the daemon stops the script), so it is
# always the last thing done, and bye the first.
hold() { bye; echo "== hold $BEAD: $1"; "$Y" bead note "$BEAD" "merge-pr: $1"; "$Y" bead hold "$BEAD"; exit 0; }
report() {
  bye
  echo "== $BEAD $1"
  printf '%s\n' "merge-pr: $2" | "$Y" bead "done" "$BEAD" --outcome "$1" --note - && exit 0
  # The pull request's own event may have moved the bead first (GitHub tells
  # the hook of a merge before this script has reported it): a bead that
  # is closed is where the report would have taken it.
  [ "$("$Y" bead show "$BEAD" --json 2>/dev/null | jq -r '.status // empty')" = closed ] &&
    { echo "== $BEAD is closed already"; exit 0; }
  hold "could not report $1 (does the bead's flow name it for its stage?): $2"
}
work=$(mktemp -d) && errf=$work/err
# gh is run from a directory that is no checkout, so nothing it does to a
# local branch can reach anyone's work.
cd "$work" || exit 1

command -v gh >/dev/null 2>&1 || hold "gh is not on PATH; not merging."
command -v jq >/dev/null 2>&1 || hold "jq is not on PATH; not merging."
LAND=${YARDR_LAND:-rebase}
case $LAND in
rebase | squash) ;;
*) hold "YARDR_LAND is $LAND in this group's cmd, and a pull request is merged by rebase or by squash; not merging. Correct the cmd, then unhold." ;;
esac

# With --json yardr reports an error as {"error": ...} on stdout. Capture
# stderr for the hold note, then replay it so warnings stay in the group's log.
bead=$("$Y" bead show "$BEAD" --json 2>"$errf") || {
  reason=$({ cat "$errf"; printf '%s' "$bead"; } | head -c 500)
  cat "$errf" >&2
  hold "reading $BEAD failed: $reason"
}
cat "$errf" >&2

# merge-ok is the whole permission: a route sent the bead here, but a bead
# without the label (moved here by hand, a route gone wrong) is not merged.
printf '%s' "$bead" | jq -e '(.labels // []) | index("merge-ok")' >/dev/null ||
  hold "$BEAD does not carry merge-ok, which says the yard may merge its pull request. Not merging. A maintainer says yes with: yardr bead update $BEAD --add-label merge-ok --meta merge_head=<sha of the head commit they looked at>, then yardr bead unhold $BEAD."

NOT="not merging" STAGE=approved
# The token's permissions, the least the gh calls below need: merging a pull
# request wants Contents write of the token, deleting its branch wants
# Contents write, and reading one wants Pull requests read (GitHub's REST
# docs, "Merge a pull request" and "Get a pull request"; "Permissions
# required for GitHub Apps" for the deleted branch). The shared lines pass
# them to the mint, which posts them in the access_tokens body.
PERMS='{"contents":"write","pull_requests":"read"}'
# --- github_binding: the same text in merge-pr and pr-ci (a test holds them equal) ---
# NOT, STAGE and PERMS are each script's own: what it leaves undone and where
# the bead waits, and the least permissions its token needs; everything else
# is one text.
#
# The pull request is the one the bead tracks, by the URL of the link and
# nothing else: owner, repository and number are read from it, and a URL of
# another shape (another host, an issue, a path past the number) is refused.
url=$(printf '%s' "$bead" | jq -r '[.links[]? | select(.kind == "tracks" and .source == "github") | .url] | first // empty')
[ -n "$url" ] ||
  hold "$BEAD tracks no GitHub pull request (no tracks link of source github); $NOT. Link it with yardr link, or take the bead out of $STAGE."
printf '%s' "$url" | grep -Eq '^https://github\.com/[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?/[A-Za-z0-9._-]+/pull/[1-9][0-9]*$' ||
  hold "$BEAD tracks $url, which is not a pull request address (https://github.com/<owner>/<repo>/pull/<n>); $NOT."
path=${url#https://github.com/}
owner=${path%%/*}
rest=${path#*/}
repo=${rest%%/*}
case $repo in . | ..) hold "$BEAD tracks $url, which is not a pull request address (https://github.com/<owner>/<repo>/pull/<n>); $NOT." ;; esac
slug=$owner/$repo

# The token: minted for this repository alone, from the App's id and key file
# the group's env_file gives, and held in this process's memory for the calls
# below. It is passed to gh in its environment, never in an argument, and is
# printed nowhere. The mint command is the github source's own unless the
# group's cmd names another. The token is narrowed to the permissions PERMS
# names, each script's own least set above, which the mint posts in the
# access_tokens body; a name or level outside the mint's list refuses the mint.
[ -n "${GITHUB_APP_ID:-}" ] && [ -n "${GITHUB_APP_PRIVATE_KEY_FILE:-}" ] ||
  hold "this group's environment has no GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY_FILE, which the yard's GitHub App is minted from (the group's env_file); $NOT."
mint=${YARDR_GITHUB_MINT:-}
[ -n "$mint" ] || mint=$("$Y" source show github --json 2>/dev/null | jq -r '.source.mint_command // empty')
[ -n "$mint" ] ||
  hold "the github source has no mint_command and the group's cmd sets no YARDR_GITHUB_MINT; $NOT. Install contrib/github-mint, then yardr source set github mint_command=<its path>."
# mint_command has the same space-split, no-shell contract as yardr's source
# mint. Disable pathname expansion while forming argv so a configured `*`
# stays an argument and never grows into files in the runner's directory.
mint_token() {
  set -f
  # shellcheck disable=SC2086
  set -- $mint
  set +f
  [ "$#" -gt 0 ] || return 1
  YARDR_SOURCE_BASE=https://api.github.com "$@" 2>/dev/null
}
tokjson=$(jq -nc --arg id "$GITHUB_APP_ID" --arg key "$GITHUB_APP_PRIVATE_KEY_FILE" --arg scope "$slug" --argjson permissions "$PERMS" \
  '{inputs: {GITHUB_APP_ID: $id, GITHUB_APP_PRIVATE_KEY_FILE: $key}, scope: $scope, permissions: $permissions}' |
  mint_token) ||
  hold "minting a token for $slug failed; the mint's output is not copied to the bead. $NOT."
token=$(printf '%s' "$tokjson" | jq -r '.token // empty')
unset tokjson
[ -n "$token" ] || hold "minting a token for $slug answered no token; $NOT."
gh_() { GH_TOKEN=$token gh "$@"; }
# --- end of github_binding ---

pr=$(gh_ pr view "$url" --json number,state,headRefOid,headRepository,headRepositoryOwner,author,title,body 2>"$errf") ||
  hold "reading pull request $url failed: $(head -c 500 "$errf")"
state=$(printf '%s' "$pr" | jq -r '.state // empty')
head=$(printf '%s' "$pr" | jq -r '.headRefOid // empty')
headrepo=$(printf '%s' "$pr" | jq -r 'if .headRepositoryOwner.login and .headRepository.name then .headRepositoryOwner.login + "/" + .headRepository.name else empty end')
bot=$(printf '%s' "$pr" | jq -r '.author.is_bot // false')
author=$(printf '%s' "$pr" | jq -r '.author.login // "unknown"')
title=$(printf '%s' "$pr" | jq -r '.title // empty')
body=$(printf '%s' "$pr" | jq -r '.body // empty')

# A pull request that is not open is nothing to merge: the merge is done
# already (by a maintainer, or by an earlier run that could not report it), or
# it was closed.
case $state in
MERGED) report merged "$url is merged already." ;;
CLOSED) report dropped "$url is closed, unmerged." ;;
OPEN) ;;
*) hold "pull request $url is in state ${state:-unknown}, not OPEN; not merging." ;;
esac
[ -n "$head" ] || hold "GitHub gave no head commit for $url; not merging."
# The head goes into a path of the API and an argument of gh: a commit's sha
# and nothing else.
case $head in *[!0-9a-fA-F]*) head= ;; esac
case ${#head} in 40 | 64) ;; *) head= ;; esac
[ -n "$head" ] || hold "GitHub gave a head for $url that is no commit sha; not merging."

# Whose head is merged. A branch of the repository's own is told by the
# names, whatever their case.
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
samerepo=0
[ -n "$headrepo" ] && [ "$(lower "$headrepo")" = "$(lower "$slug")" ] && samerepo=1
short() { printf '%s' "$1" | cut -c1-7; }
yes="yardr bead update $BEAD --add-label merge-ok --meta merge_head=<sha of the head commit you looked at>, then yardr bead unhold $BEAD"
if [ "$bot" = true ] && [ "$samerepo" = 1 ]; then
  sha=$head
else
  # Everything else waits for a person's yes, and merges what they looked at.
  # An abbreviated sha is not accepted: a few hex digits are easy to collide.
  yesat=$(printf '%s' "$bead" | jq -r '.metadata.merge_head // empty')
  [ -n "$yesat" ] ||
    hold "$url is not a bot's pull request from a branch of $slug itself (author $author, head in ${headrepo:-no repository}), so the yard merges only the head commit a maintainer said yes to, and $BEAD has none (merge_head). The head is now $head. Not merging. To say yes: $yes."
  case $yesat in
  *[!0-9a-fA-F]*) yesat= ;;
  esac
  case ${#yesat} in 40 | 64) ;; *) yesat= ;; esac
  [ -n "$yesat" ] ||
    hold "merge_head on $BEAD is not a full commit sha (40 hex digits; 64 for a repository on sha256): an abbreviated one is not taken. Not merging. To say yes: $yes."
  [ "$(lower "$yesat")" = "$(lower "$head")" ] ||
    hold "$url moved since your yes (yes at $(short "$yesat"), head now $(short "$head")). Not merged. The head is now $head; look at what was pushed, then say yes again: $yes."
  sha=$head
fi

# CI: the yard's own. pr-ci runs the depot's test command on the head in ciwait,
# when a reviewer read that head, and records the head it passed on as the
# bead's metadata ci_head, which counts for that commit and no other: a head
# that is another commit (the pull request was pushed to since the run, or the
# bead was moved here by hand) has not passed. Nothing is asked of GitHub for
# it, Actions or not: one source of truth is enough.
ciat=$(printf '%s' "$bead" | jq -r '.metadata.ci_head // empty')
case $ciat in *[!0-9a-fA-F]*) ciat= ;; esac
case ${#ciat} in 40 | 64) ;; *) ciat= ;; esac
passed=nothing
[ -z "$ciat" ] || passed=$(short "$ciat")
{ [ -n "$ciat" ] && [ "$(lower "$ciat")" = "$(lower "$sha")" ]; } ||
  hold "CI has not passed on $(short "$sha") (yard CI passed $passed). Not merging. The yard runs CI on a pull request's head in ciwait (pr-ci), and only on a head a reviewer read; to have it run on the head as it is now: yardr bead advance $BEAD --to ciwait, then yardr bead unhold $BEAD. A head no reviewer read is held there, with the command that sends the bead to review."

# The merge. --match-head-commit makes GitHub refuse when the head is no
# longer the commit looked at; gh can merge and still exit non-zero (a local
# branch it could not delete, say), so what GitHub says the pull request is
# decides.
if [ "$samerepo" = 1 ] && [ "$LAND" = squash ]; then
  [ -n "$title" ] || hold "GitHub gave no title for $url, which is the squash commit's subject; not merging."
  how=squash
  out=$(gh_ pr merge "$url" --squash --delete-branch --match-head-commit "$sha" --subject "$title" --body "$body" 2>&1) && rc=0 || rc=$?
elif [ "$samerepo" = 1 ]; then
  how=rebase
  out=$(gh_ pr merge "$url" --rebase --delete-branch --match-head-commit "$sha" 2>&1) && rc=0 || rc=$?
else
  how="merge commit"
  out=$(gh_ pr merge "$url" --merge --match-head-commit "$sha" 2>&1) && rc=0 || rc=$?
fi
printf '%s\n' "$out"
if [ "$rc" != 0 ]; then
  now=$(gh_ pr view "$url" --json state,headRefOid 2>/dev/null)
  if [ "$(printf '%s' "$now" | jq -r '.state // empty')" != MERGED ]; then
    # Why GitHub refused is read from the head itself, not from gh's wording.
    live=$(printf '%s' "$now" | jq -r '.headRefOid // empty')
    if [ -n "$live" ] && [ "$live" != "$sha" ]; then
      hold "$url moved while it was being merged (looked at $(short "$sha"), head now $(short "$live")). Not merged. The head is now $live; if it is for the yard to merge, unhold $BEAD: it is looked at again."
    fi
    case $out in
    *"not accessible by integration"* | *"HTTP 403"*)
      hold "GitHub refused the yard's App on $slug: $out. The App needs Contents and Workflows read and write on the repository (the permissions raise); not merged." ;;
    esac
    hold "GitHub did not merge $url: $out. Not merged. Act on GitHub (conflicts, a review or a check it wants), then unhold $BEAD."
  fi
  echo "== gh exited $rc but $url is merged"
fi

report merged "merged $url at $sha ($how)."
