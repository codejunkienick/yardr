#!/bin/sh
# pr-merge: lands a train by merging its pull request on GitHub with a
# rebase, or a squash where the group says so, then brings the depot's local
# base up to it. Run it as the cmd of an
# exec group (yard-pr-merge, limit 1) routed for the train flow's land stage
# (type train). A train reaches land from in-pr, where a human (or, later,
# the daemon on a green CI) says "merge it". See docs/line.md, section
# Trains.
#
# The pull-request path is experimental and off by default: without
# YARDR_PR in the group's cmd, as for integrate-train, the train is held with
# a note and nothing is merged.
#
# It reads the environment the exec runner gives it: YARDR_BEAD (the train),
# YARDR_DEPOT_PATH, YARDR_BASE, YARDR_BRANCH and YARDR_BIN. Options, set in
# the group's cmd:
#
#   YARDR_PR       1: the switch for the pull-request path; held without it
#   YARDR_PUSH     the remote the pull request is on (default origin)
#   YARDR_LAND     rebase (default) or squash: how the pull request is merged
#
# It runs gh pr merge <pr_url> --rebase --delete-branch --match-head-commit
# <pr_reviewed_sha>, then fetches the remote and fast-forwards the base in
# the depot's checkout, and reports done (-> merged, which closes the train).
# With YARDR_LAND=squash it passes --squash instead, with the subject and the
# body of the Conventional Commit that merge-local writes for a bead (the same
# squash_message, here for the train and the commits of its pull request): the
# train is then one commit on the base, where a rebase leaves one for each of
# its children. A value that is neither holds the train before anything is
# merged.
# The sha is the commit pr-train pushed and stored when the train entered
# in-pr: only what the reviewer approved is merged. A pull request whose
# head is another commit, before the merge or when GitHub refuses it for
# that, holds the train, unmerged; a train with no reviewed sha reports
# failed. A merge GitHub refuses for anything else (checks
# pending, review required, conflicts) reports failed (-> open) with gh's
# message, once: nothing here retries. The depot's checkout must be on the
# base and clean, or the train is held before anything is merged; a base
# that will not fast-forward after the merge is held too, as the PR is
# merged by then. The PR is the one the train is bound to (pr_number,
# pr_head_repo, stored by integrate-train): a train bound to none reports
# failed, and one whose pr_url is another pull request is held, unmerged.
# Needs gh, logged in as the operator, and jq on PATH.
#
# Every outcome ends in a report or a hold: exiting without one counts as a
# failed session, and three of those hold the bead.
set -u
# A dir depot (YARDR_DEPOT_KIND=dir) has no branches: there is nothing here to
# land, integrate or open a pull request for. A route that hands one over is
# a mistake in the depot's flow, so refuse to run (exit 2) rather than guess.
if [ "${YARDR_DEPOT_KIND:-git}" = dir ]; then
  echo "pr-merge: depot ${YARDR_DEPOT:-?} is a dir depot, with no branch to work on; route its stages to other groups" >&2
  exit 2
fi
: "${YARDR_BEAD:?not run by an exec group}" "${YARDR_DEPOT_PATH:?bead has no depot}" "${YARDR_BASE:?}"
Y=${YARDR_BIN:-yardr}
TRAIN=$YARDR_BEAD
REPO=$YARDR_DEPOT_PATH
BASE=$YARDR_BASE
BR=${YARDR_BRANCH:-yard/$TRAIN}
PUSH=${YARDR_PUSH:-origin}
LAND=${YARDR_LAND:-rebase}
# The top-level directories that say nothing as the scope of a squash commit
# (squash_message): a change under internal/ alone is better named by its
# package. A depot's copy of this script changes the list.
CONTAINERS="internal contrib packs cmd pkg src lib"
echo "== $(date '+%Y-%m-%dT%H:%M:%S%z') pr-merge $TRAIN ($BR)"

# bye takes away everything the script made, whichever of it exists. It is the
# first thing hold and report do, so that nothing is left to do once the
# session ends (the daemon stops the script as soon as it has reported), and
# the EXIT trap, for every other way out. TERM and INT are ignored while it
# runs, so that a stop of the session that comes meanwhile cannot leave it
# half done.
bye() {
  trap '' TERM INT
  [ -z "${errf:-}" ] || rm -f "$errf"
  return 0
}
trap 'bye' EXIT
# A signal that kills the script does not run its EXIT trap in every shell
# (dash's does not), so TERM and INT exit, which does, as a shell would, 128+n.
trap 'exit 143' TERM
trap 'exit 130' INT

# Reporting ends this session (the daemon stops the script), so it is
# always the last thing done, and bye the first.
hold() { bye; echo "== hold $TRAIN: $1"; "$Y" bead note "$TRAIN" "pr: $1"; "$Y" bead hold "$TRAIN"; exit 0; }
report() {
  bye
  echo "== $TRAIN $1"
  printf '%s\n' "pr: $2" | "$Y" bead "done" "$TRAIN" --outcome "$1" --note - && exit 0
  hold "could not report $1 (does the train's flow name it for its stage?): $2"
}
errf=$(mktemp)

# Off unless switched on: a train that reached land by accident (a stray
# route, a move by hand) must not be merged on GitHub.
[ -n "${YARDR_PR:-}" ] ||
  hold "the pull-request path is experimental and off: YARDR_PR is not set in this group's cmd; not merging. Set YARDR_PR=1 in the cmd of every group on the path, then unhold, or send the train back to open and land it through the assembly (merge-local)."

# A value that is neither mode is a typo in the group's cmd: merging by the
# other mode would go unseen until the history shows it.
case $LAND in
rebase | squash) ;;
*) hold "YARDR_LAND is $LAND in this group's cmd, and a pull request is merged by rebase or by squash; not merging. Correct the cmd, then unhold." ;;
esac

# The base branch, without its remote: what the PR merged into and what the
# depot's checkout must be on.
prbase=$BASE
remote=${BASE%%/*}
[ "$remote" != "$BASE" ] && git -C "$REPO" remote | grep -qx "$remote" && prbase=${BASE#*/}

# The checkout is checked before merging: once GitHub has merged, a
# checkout that cannot follow would leave the train merged there but not here.
[ "$(git -C "$REPO" symbolic-ref -q --short HEAD)" = "$prbase" ] ||
  hold "$REPO is not on $prbase; not merging. Check out $prbase there, then unhold."
[ -z "$(git -C "$REPO" status --porcelain)" ] ||
  hold "$REPO has uncommitted changes; not merging. Commit or clean them, then unhold."

# With --json yardr reports an error as {"error": ...} on stdout. Capture
# stderr for the hold note, then replay it so warnings stay in the group's log.
train=$("$Y" bead show "$TRAIN" --json 2>"$errf") || {
  reason=$({ cat "$errf"; printf '%s' "$train"; } | head -c 500)
  cat "$errf" >&2
  hold "reading $TRAIN failed: $reason"
}
cat "$errf" >&2
# The train's pull request is the one integrate-train bound it to, by number
# and head repository, never one looked up by the branch's name: a fork's
# pull request can carry the same name. What GitHub says of it must match
# the binding, or it is not the train's to merge.
url=$(printf '%s' "$train" | jq -r '.metadata.pr_url // empty')
num=$(printf '%s' "$train" | jq -r '.metadata.pr_number // empty')
headrepo=$(printf '%s' "$train" | jq -r '.metadata.pr_head_repo // empty')
[ -n "$url" ] && [ -n "$num" ] && [ -n "$headrepo" ] ||
  report failed "no pull request bound to $TRAIN (pr_url, pr_number, pr_head_repo): integrating the train again opens one, or binds the one in pr_url"
pr=$(cd "$REPO" && gh pr view "$url" --json number,state,headRefName,headRefOid,headRepositoryOwner,headRepository 2>"$errf") ||
  report failed "reading pull request $url failed: $(cat "$errf")"
is="#$(printf '%s' "$pr" | jq -r .number) from $(printf '%s' "$pr" | jq -r 'if .headRepositoryOwner.login and .headRepository.name then .headRepositoryOwner.login + "/" + .headRepository.name else empty end'):$(printf '%s' "$pr" | jq -r .headRefName)"
[ "$is" = "#$num from $headrepo:$BR" ] ||
  hold "pull request $url is $is, but $TRAIN is bound to #$num from $headrepo:$BR. Not touched. Correct the train's pr_url, pr_number and pr_head_repo, then unhold."

# Only the commit the reviewer approved is merged: the one pr-train pushed
# and stored when the train entered in-pr. Commits pushed to the pull request
# since were reviewed by no one, so a head that moved is held, not merged
# and not sent round again by itself.
reviewed=$(printf '%s' "$train" | jq -r '.metadata.pr_reviewed_sha // empty')
[ -n "$reviewed" ] ||
  report failed "$TRAIN has no reviewed commit (pr_reviewed_sha, which pr-train stores as the train enters in-pr); not merging. It is integrated and reviewed again."
moved() {
  hold "the head of pull request $url is $1, not the reviewed $reviewed (pr_reviewed_sha): it moved after review. Not merged. Look at what was pushed to $BR on $PUSH: to have it reviewed, bring it into $BR in the depot and send the train back to open, where it is integrated and reviewed again; to drop it, put $PUSH/$BR back at $reviewed, then unhold."
}
head=$(printf '%s' "$pr" | jq -r '.headRefOid // empty')
[ "$head" = "$reviewed" ] || moved "${head:-unknown}"

# --- squash_message: the same text in merge-local and pr-merge (a test holds them equal) ---
# squash_message <bead> <base> <head> leaves in SQ_SUBJECT and SQ_BODY the
# Conventional Commits message that lands <bead> as one commit made of what
# <head> adds to <base>, and returns 1 with ERR set when it cannot be made. It
# is called in the shell itself, never in a command substitution, so that the
# caller can hold the bead on a failure. The format is fixed here, not
# configurable: a depot that wants another copies the script.
#
#   <type>[(<scope>)][!]: <bead title> (<bead id>)
#
#   <each commit's message since <base>, oldest first, its trailers removed>
#
#   BREAKING CHANGE: <as a commit carried it, each>
#   Refs: <each issue the bead tracks, then each it relates to>
#   Yardr-Bead: <bead id>
#   Yardr-Agent: <each distinct one on the branch, first seen first>
#
# The type is the bead's kind: label, else fix for a bug and chore for the
# rest. The scope is derived from the diff, never chosen: the last element of
# the deepest directory that holds every changed path (a rename counts both),
# none when that is the root, one of $CONTAINERS, or the type itself. The bead's
# fields are read from its JSON with awk, since the scripts run where only sh,
# git and yardr are promised; Go writes < > & in a JSON string as the escapes
# u003c, u003e and u0026 after a backslash, which unjson undoes.
SQ_UNJSON='
  function unjson(s,   out, c, h) {
    out = ""
    while (s != "") {
      c = substr(s, 1, 1)
      if (c != "\\") { out = out c; s = substr(s, 2); continue }
      c = substr(s, 2, 1)
      if (c == "u") {
        h = tolower(substr(s, 3, 4)); s = substr(s, 7)
        out = out (h == "003c" ? "<" : (h == "003e" ? ">" : (h == "0026" ? "&" : " ")))
      } else if (c == "\"" || c == "\\" || c == "/") {
        out = out c; s = substr(s, 3)
      } else {
        out = out " "; s = substr(s, 3)
      }
    }
    return out
  }
'
squash_message() {
  sq_bead=$1 sq_base=$2 sq_head=$3
  ERR=
  sq_nl='
'
  # With --json yardr reports an error as {"error": ...} on its stdout.
  sq_json=$("$Y" bead show "$sq_bead" --json) || { ERR="reading $sq_bead failed: $(printf '%s' "$sq_json" | head -c 500)"; return 1; }
  sq_fields=$(printf '%s\n' "$sq_json" | awk "$SQ_UNJSON"'
    match($0, /^  "[a-z_]+": "/) {
      key = substr($0, 4, RLENGTH - 7)
      val = substr($0, RLENGTH + 1); sub(/",?$/, "", val)
      if (key == "type") type = val
      if (key == "title") title = unjson(val)
    }
    /^  "labels": \[$/ { inlabels = 1; next }
    inlabels && /^  \]/ { inlabels = 0 }
    inlabels && kind == "" && /^    "kind:[A-Za-z0-9-]+",?$/ { kind = $0; sub(/^    "kind:/, "", kind); sub(/",?$/, "", kind) }
    END { print type; print kind; $0 = title; $1 = $1; print $0 }
  ')
  sq_btype=$(printf '%s\n' "$sq_fields" | sed -n 1p)
  sq_kind=$(printf '%s\n' "$sq_fields" | sed -n 2p)
  sq_title=$(printf '%s\n' "$sq_fields" | sed -n 3p)
  [ -n "$sq_title" ] || { ERR="found no title in the JSON of $sq_bead"; return 1; }
  if [ -n "$sq_kind" ]; then
    sq_type=$sq_kind
  elif [ "$sq_btype" = bug ]; then
    sq_type=fix
  else
    sq_type=chore
  fi

  # Links the bead made to outside issues. A bead of another yard that it is
  # at or came from is listed too (kind at, was at, from), and is no issue.
  sq_linkjson=$("$Y" link list "$sq_bead" --json) || { ERR="listing the links of $sq_bead failed"; return 1; }
  sq_refs=$(printf '%s\n' "$sq_linkjson" | awk "$SQ_UNJSON"'
    /^  [{]/ { kind = ""; url = "" }
    match($0, /^    "[a-z_]+": "/) {
      key = substr($0, 6, RLENGTH - 9)
      val = substr($0, RLENGTH + 1); sub(/",?$/, "", val)
      if (key == "kind") kind = val
      if (key == "url") url = unjson(val)
    }
    /^  [}]/ {
      if (url != "" && kind == "tracks") tracked[++nt] = url
      if (url != "" && kind == "relates") related[++nr] = url
    }
    END {
      for (i = 1; i <= nt; i++) print "Refs: " tracked[i]
      for (i = 1; i <= nr; i++) print "Refs: " related[i]
    }
  ')

  # The commits, one record each, split by awk into the lines that stay in the
  # body (b), a BREAKING CHANGE footer (x) and a Yardr-Agent value (a). A
  # commit's trailers are its last paragraph when that holds nothing but
  # footers (Token: value, or BREAKING CHANGE: value, with indented lines
  # folded into the one before). A BREAKING CHANGE is taken from wherever it
  # stands after the subject: the yard's commit hook puts its own trailers in a
  # paragraph of their own, so a footer written above them is no part of the
  # last paragraph. It runs to the next blank line or footer, and leaves the
  # body for the footer. A commit that is itself such a squash (an earlier
  # landing of this bead that came back red) gives up its subject line, which
  # the new one replaces.
  sq_msgs=$(git -C "$REPO" log --reverse --no-show-signature --format='%B%x1e' "$sq_base..$sq_head") ||
    { ERR="reading the commits of $sq_head since $sq_base failed"; return 1; }
  sq_parts=$(printf '%s\n' "$sq_msgs" | awk -v bead="$sq_bead" '
    function bc(l) { return l ~ /^BREAKING[ -]CHANGE:([ \t]|$)/ }
    function footer(l) { return bc(l) || l ~ /^[A-Za-z0-9-]+:([ \t]|$)/ }
    function blank(l) { return l ~ /^[ \t]*$/ }
    function ours(l,   tail, n) {
      tail = " (" bead ")"
      n = length(l) - length(tail)
      return n > 0 && substr(l, n + 1) == tail && l ~ /^[a-z]+(\([^)]*\))?!?: /
    }
    function flush(   n, t, i, l, first, ok, inbc, v) {
      n = cnt
      while (n > 0 && blank(line[n])) n--
      t = n
      while (t > 1 && !blank(line[t - 1])) t--
      first = n + 1
      if (t > 1 && n >= t && footer(line[t])) {
        ok = 1
        for (i = t; i <= n; i++) if (!footer(line[i]) && line[i] !~ /^[ \t]/) ok = 0
        if (ok) first = t
      }
      inbc = 0
      for (i = 1; i <= n; i++) {
        l = line[i]
        if (i >= first) {
          if (bc(l)) { inbc = 1; print "x" l }
          else if (inbc && l ~ /^[ \t]/) print "x" l
          else {
            inbc = 0
            if (l ~ /^Yardr-Agent:/) {
              v = l; sub(/^Yardr-Agent:[ \t]*/, "", v); sub(/[ \t]+$/, "", v)
              if (v != "" && !(v in agent)) { agent[v] = 1; print "a" v }
            }
          }
          continue
        }
        if (i == 1 && ours(l)) continue
        if (i > 1 && bc(l)) { inbc = 1; print "x" l; continue }
        if (inbc) {
          if (!blank(l) && !footer(l)) { print "x" l; continue }
          inbc = 0
        }
        if (blank(l)) pending = seen
        else { if (pending) print "b"; pending = 0; print "b" l; seen = 1 }
      }
      pending = seen
      cnt = 0
    }
    {
      p = index($0, "\036")
      if (p == 0) { line[++cnt] = $0; next }
      if (p > 1) line[++cnt] = substr($0, 1, p - 1)
      flush()
    }
    END { if (cnt > 0) flush() }
  ')
  sq_body=$(printf '%s\n' "$sq_parts" | sed -n 's/^b//p')
  sq_break=$(printf '%s\n' "$sq_parts" | sed -n 's/^x//p')
  sq_agents=$(printf '%s\n' "$sq_parts" | sed -n 's/^a//p')

  # The scope, from the paths the squash changes.
  sq_paths=$(git -c core.quotePath=false -C "$REPO" diff --name-only --no-renames "$sq_base...$sq_head") ||
    { ERR="listing what $sq_head changes since $sq_base failed"; return 1; }
  sq_dir=
  if [ -n "$sq_paths" ]; then
    sq_dir=$(printf '%s\n' "$sq_paths" | awk '
      {
        n = split($0, p, "/"); d = n - 1
        if (NR == 1) { len = d; for (i = 1; i <= d; i++) c[i] = p[i] }
        else {
          if (d < len) len = d
          for (i = 1; i <= len; i++) if (c[i] != p[i]) { len = i - 1; break }
        }
      }
      END { for (i = 1; i <= len; i++) printf "%s%s", (i > 1 ? "/" : ""), c[i]; print "" }
    ')
  fi
  sq_scope=${sq_dir##*/}
  case " $CONTAINERS " in *" $sq_dir "*) sq_scope= ;; esac
  [ "$sq_scope" != "$sq_type" ] || sq_scope=

  SQ_SUBJECT=$sq_type
  [ -z "$sq_scope" ] || SQ_SUBJECT="$SQ_SUBJECT($sq_scope)"
  [ -z "$sq_break" ] || SQ_SUBJECT="$SQ_SUBJECT!"
  SQ_SUBJECT="$SQ_SUBJECT: $sq_title ($sq_bead)"

  sq_footer=$({
    [ -z "$sq_break" ] || printf '%s\n' "$sq_break"
    [ -z "$sq_refs" ] || printf '%s\n' "$sq_refs"
    printf 'Yardr-Bead: %s\n' "$sq_bead"
    [ -z "$sq_agents" ] || printf '%s\n' "$sq_agents" | sed 's/^/Yardr-Agent: /'
  })
  SQ_BODY=$sq_footer
  [ -z "$sq_body" ] || SQ_BODY="$sq_body$sq_nl$sq_nl$sq_footer"
}
# --- end of squash_message ---

# With YARDR_LAND=squash the pull request is merged with a message written
# here, before anything is merged, so that a message that cannot be made holds
# the train with nothing done. The commits and the files that count are those
# the pull request adds to the base it goes into, which is fetched first.
set -- --rebase
how="a rebase"
if [ "$LAND" = squash ]; then
  git -C "$REPO" fetch --quiet "$PUSH" 2>"$errf" ||
    hold "could not fetch $PUSH to write the message of the squash commit: $(cat "$errf") Nothing was merged. Fix it, then unhold."
  squash_message "$TRAIN" "refs/remotes/$PUSH/$prbase" "$reviewed" ||
    hold "cannot write the message of the squash commit of $TRAIN: $ERR. Nothing was merged. Fix it, then unhold."
  set -- --squash --subject "$SQ_SUBJECT" --body "$SQ_BODY"
  how="a squash"
fi

# --match-head-commit closes the gap between the check above and the merge:
# GitHub refuses when the head is no longer the reviewed commit. gh can
# merge and still exit non-zero (deleting a local branch a worktree has
# checked out, say): what GitHub says the PR is decides.
out=$(cd "$REPO" && gh pr merge "$url" "$@" --delete-branch --match-head-commit "$reviewed" 2>&1) && rc=0 || rc=$?
printf '%s\n' "$out"
if [ "$rc" != 0 ]; then
  state=$(cd "$REPO" && gh pr view "$url" --json state --jq .state 2>/dev/null)
  if [ "$state" != MERGED ]; then
    # Why GitHub refused is read from the head itself, not from gh's wording.
    head=$(cd "$REPO" && gh pr view "$url" --json headRefOid --jq .headRefOid 2>/dev/null)
    [ -z "$head" ] || [ "$head" = "$reviewed" ] || moved "$head"
    report failed "GitHub did not merge $url: $out"
  fi
  echo "== gh exited $rc but $url is merged"
fi

# Bring the local base up to what GitHub merged. Fast-forward only: the
# base gains nothing locally that is not on the remote.
out=$(git -C "$REPO" fetch "$PUSH" 2>&1) ||
  hold "merged $url, but fetching $PUSH failed: $out
Fast-forward $prbase in $REPO to $PUSH/$prbase, then advance the train to merged."
out=$(git -C "$REPO" merge --ff-only "$PUSH/$prbase" 2>&1) ||
  hold "merged $url, but $prbase in $REPO does not fast-forward to $PUSH/$prbase: $out
Bring $prbase up to $PUSH/$prbase, then advance the train to merged."
sha=$(git -C "$REPO" rev-parse --short HEAD)

report "done" "merged $url at the reviewed $reviewed with $how; $prbase at $sha"
