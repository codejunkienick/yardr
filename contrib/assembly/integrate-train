#!/bin/sh
# integrate-train: brings a train's branch up to date with its depot's base
# and tests it, once its last child has landed on it, so the train goes to
# review as exactly what would land. Run it as the cmd of an exec group
# routed for the train flow's open stage (type train); limit 1 on the group
# integrates one train at a time. See docs/line.md, section Trains.
#
# It reads everything from the environment the exec runner gives it, as
# merge-local does: YARDR_BEAD (the train), YARDR_DEPOT, YARDR_DEPOT_PATH,
# YARDR_BASE (the depot's base), YARDR_BRANCH (yard/<train>), YARDR_WORKTREE,
# YARDR_BIN and YARDR_TEST, the depot's test command (yardr depot add
# --test), unset for a depot with none. Options, set in the group's cmd:
#
#   YARDR_PUSH          a remote to push the train branch to; off when empty
#   YARDR_NOTIFY        crew member mailed when that push fails (default: the
#                       yard's yardmaster setting, else yardmaster)
#   YARDR_PR            1: open a pull request for the pushed branch against
#                       the base, or update the one the train is bound to,
#                       and bind the train to it (pr_url, pr_number,
#                       pr_head_repo in its metadata); needs YARDR_PUSH, and
#                       gh and jq on PATH, gh logged in as the operator
#   YARDR_TEST_TIMEOUT  seconds the test command may run, besides what it
#                       waited for the race lock (default 1800)
#   YARDR_REWRITE_TIMEOUT
#                       seconds the file size table rewrite may run (default
#                       120); it waits on no race lock
#
# It fetches the base when it is a remote's, rebases the train branch onto
# the base, lowers the file size table of a test command that carries one to
# the branch's files (lowerrows, below: a commit of its own on the branch,
# and a hold when a row stands below its file or the rewrite outlasts its
# deadline), runs the depot's test command on the result, with
# YARDR_LANDING=1 and YARDR_TEST_BEADS (the train's children, which the run
# tests, where YARDR_BEAD names the train), and reports done (-> review). A
# red run reports failed (-> open) with the commit, the failing tests and
# the end of the output, and the full output attached beside it, after
# adding a child to fix it, which carries the same: the child blocks
# the train, so it is not integrated again until the fix has landed on its
# branch. A rebase that conflicts reports conflict (-> merge), as merge-local
# does for a bead: the mergers rebase the branch and send the train back to
# open, where it is integrated again. A test command that says it could not
# run (exit 2), or a branch it cannot work on, is held for a human; a run
# ended by a signal is run once more, and held if one ends it again. A depot
# with no test command goes to review untested, and the note says so.
#
# Every outcome ends in a report or a hold: exiting without one counts as a
# failed session, and three of those hold the bead.
set -u
# A dir depot (YARDR_DEPOT_KIND=dir) has no branches: there is nothing here to
# land, integrate or open a pull request for. A route that hands one over is
# a mistake in the depot's flow, so refuse to run (exit 2) rather than guess.
if [ "${YARDR_DEPOT_KIND:-git}" = dir ]; then
  echo "integrate-train: depot ${YARDR_DEPOT:-?} is a dir depot, with no branch to work on; route its stages to other groups" >&2
  exit 2
fi
: "${YARDR_BEAD:?not run by an exec group}" "${YARDR_DEPOT:?bead has no depot}"
: "${YARDR_DEPOT_PATH:?}" "${YARDR_BASE:?}"
Y=${YARDR_BIN:-yardr}
TRAIN=$YARDR_BEAD
DEPOT=$YARDR_DEPOT
REPO=$YARDR_DEPOT_PATH
BASE=$YARDR_BASE
BR=${YARDR_BRANCH:-yard/$TRAIN}
WT=${YARDR_WORKTREE:-${YARDR_HOME:-$HOME/.yardr}/worktrees/$DEPOT/$TRAIN}
PUSH=${YARDR_PUSH:-}
NOTIFY=${YARDR_NOTIFY:-}
PR=${YARDR_PR:-}
TAIL=200
# How many failing tests a red note keeps from the full log, ahead of the
# tail: a failure early in a long run would otherwise sit unseen above it.
FAILS=40
echo "== $(date '+%Y-%m-%dT%H:%M:%S%z') integrate $DEPOT $TRAIN ($BR onto $BASE)"

# tree prints a process and everything below it, in one order every time.
tree() {
  ps -A -o pid= -o ppid= | awk -v root="$1" '
    { parent[$1] = $2 }
    END {
      below[root] = 1
      do { more = 0; for (p in parent) if (!(p in below) && (parent[p] in below)) { below[p] = 1; more = 1 } } while (more)
      for (p in below) print p
    }' | sort -n
}
# unwatched kills the timeout watcher and its sleep, after a run and on
# every exit while one is in flight (the traps): a watcher left behind
# sleeps out its $LIMIT holding the run's inherited files, among them once
# the machine race lock (yardr-tsms). The sleep goes by the pid the watcher
# wrote, in case the watcher died without killing it, and both kills are
# silent: either may already be gone. What the file holds is signalled only
# if it is a number with a non-zero digit: kill 0 signals this script's whole
# process group, and kill reads 00 as 0 (yardr-0bd1).
unwatched() {
  [ -n "${watch:-}" ] || return 0
  kill "$watch" 2>/dev/null
  if [ -n "${napfile:-}" ] && [ -s "$napfile" ]; then
    nap=$(cat "$napfile" 2>/dev/null) || nap=
    case "$nap" in ''|*[!0-9]*) ;; *[1-9]*) kill "$nap" 2>/dev/null ;; esac
  fi
  wait "$watch" 2>/dev/null
  watch=
}
# cleanup removes the files the script made, whichever of them exist: when a
# run is over and by bye.
cleanup() {
  unwatched
  [ -z "${log:-}" ] || rm -f "$log"
  [ -z "${latefile:-}" ] || rm -f "$latefile"
  [ -z "${napfile:-}" ] || rm -f "$napfile"
  [ -z "${copy:-}" ] || rm -f "$copy"
  [ -z "${errf:-}" ] || rm -f "$errf"
  return 0
}
# stoprun stops the command the script started, and every process below it. A
# session can be stopped while its tests are still running; ending the script
# alone would leave them running with nobody to read the result, in a worktree
# that is removed once the train closes, and holding what they hold, the
# machine race lock among it.
stoprun() {
  [ -n "${pid:-}" ] || return 0
  seen=
  while t=$(tree "$pid") && [ "$t" != "$seen" ]; do
    # shellcheck disable=SC2086
    kill -STOP $t 2>/dev/null
    seen=$t
  done
  # shellcheck disable=SC2086
  kill -KILL ${seen:-$pid} 2>/dev/null
  wait "$pid" 2>/dev/null
  pid=
}
# bye takes away everything the script started and made, whichever of it
# exists. It is the first thing hold and report do, so that nothing is left to
# do once the session ends (the daemon stops the script as soon as it has
# reported), and the EXIT trap, for every other way out. TERM and INT are
# ignored while it runs, so that a stop of the session that comes meanwhile
# cannot leave it half done.
bye() {
  trap '' TERM INT
  unwatched
  stoprun
  cleanup
  return 0
}
# pid is only the command this script starts (the file size table rewrite, then
# the test command), never a handle inherited from the exec group's environment.
unset pid
pid=
trap 'bye' EXIT
# A signal that kills the script does not run its EXIT trap in every shell
# (dash's does not), so TERM and INT exit, which does, as a shell would, 128+n.
trap 'unwatched; exit 143' TERM
trap 'unwatched; exit 130' INT

# Reporting ends this session (the daemon stops the script), so it is
# always the last thing done, and bye the first.
hold() { bye; echo "== hold $TRAIN: $1"; "$Y" bead note "$TRAIN" "integrator: $1"; "$Y" bead hold "$TRAIN"; exit 0; }
report() {
  bye
  echo "== $TRAIN $1"
  printf '%s\n' "integrator: $2" | "$Y" bead "done" "$TRAIN" --outcome "$1" --note - && exit 0
  hold "could not report $1 (does the train's flow name it for its stage?): $2"
}

[ -z "$PR" ] || [ -n "$PUSH" ] ||
  hold "YARDR_PR is set without YARDR_PUSH: a pull request needs the branch on a remote. Set both in the group's cmd, then unhold."
git -C "$REPO" rev-parse --verify -q "refs/heads/$BR" >/dev/null ||
  hold "branch $BR does not exist: no child has landed on it yet. Add children (yardr dep add $TRAIN <child> -k parent), then unhold."

# Fetch the base when it is a remote's (origin/main), as the herdr runner
# does before a bead branches from it; a fetch that fails or hangs leaves the
# base as it is. A local base is what the assembly lands on: nothing to fetch.
remote=${BASE%%/*}
if [ "$remote" != "$BASE" ] && git -C "$REPO" remote | grep -qx "$remote"; then
  to=; command -v timeout >/dev/null && to="timeout 60"
  GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS=true $to git -C "$REPO" fetch --quiet "$remote" ||
    echo "== fetching $remote failed; integrating onto $BASE as it is"
fi
git -C "$REPO" rev-parse --verify -q "$BASE^{commit}" >/dev/null || hold "base $BASE does not resolve in $REPO"
# The branch a pull request targets: the base without its remote.
prbase=$BASE
[ "$remote" != "$BASE" ] && git -C "$REPO" remote | grep -qx "$remote" && prbase=${BASE#*/}

if [ ! -d "$WT" ]; then
  git -C "$REPO" worktree add "$WT" "$BR" || hold "cannot check out $BR at $WT"
fi
[ "$(git -C "$WT" symbolic-ref -q HEAD)" = "refs/heads/$BR" ] || hold "$WT is not on $BR"
[ -z "$(git -C "$WT" status --porcelain)" ] || hold "worktree $WT has uncommitted changes"
[ -n "$(git -C "$REPO" rev-list -n 1 "$BASE..$BR")" ] ||
  hold "$BR has nothing $BASE lacks: no child's work to land"

# Rebase onto the base when it moved since the train branched. A conflict
# here is between the train as a whole and main, which no single child owns:
# it goes to the mergers like any other, who rebase the branch in its
# worktree and report done (-> open), so the integrator tests it again.
was=$(git -C "$REPO" rev-parse "$BR")
if ! git -C "$REPO" merge-base --is-ancestor "$BASE" "$BR"; then
  if ! git -C "$WT" rebase "$BASE"; then
    files=$(git -C "$WT" diff --name-only --diff-filter=U | tr '\n' ' ')
    git -C "$WT" rebase --abort
    report conflict "rebase of $BR onto $BASE conflicts in: $files
$BR is at $(git -C "$REPO" rev-parse --short "$BR"), $BASE at $(git -C "$REPO" rev-parse --short "$BASE").
Rebase $BR onto $BASE in $WT keeping both sides' intent, and do not push it: back in open, the integrator tests and pushes it. The tip you start from is old tip: $(git -C "$REPO" rev-parse "$BR"); note it too, as a merger's note does: the push replaces $PUSH/$BR only when everything there is in a tip noted this way."
  fi
fi

# --- closefds: the same text in merge-local, integrate-train, pr-ci, deploy-dokku and deploy-void (a test holds them equal) ---
# closefds closes every descriptor above 2 that the subshell it is called in
# inherited, so that what the subshell starts holds none the landing did not
# give it: the daemon's leaked resolver sockets once reached the tests and
# starved them (yardr-b4ep), and an orphaned sleep once held the machine race
# lock (yardr-tsms).
#
# 3 to 9 are closed by name, which every sh reads. Above them /dev/fd is
# enumerated, so that no number is missed; the loop has no redirection, since
# the shell saves fd 2 above 10 for one and would close the save from under
# itself. When the listing itself fails, closefds refuses what it never
# saw: a run that cannot prove its descriptors closed must not start.
# But dash reads one digit as a redirection's number: there
# `exec 10>&-` is the command `10` with its output closed, and a special
# builtin that fails ends the shell. A subshell asks first. An sh that cannot
# name them leaves them open, and closefds returns 1 with their numbers in
# $leftover; given the name of what the caller is about to start, it says so
# and exits 2 instead, the code for a run that could not be made rather than
# a failed one (the assembly scripts hold on it: no builder can fix it).
# Nothing hands this script such a descriptor since the daemon marks its own
# close-on-exec before it starts one, so one that arrives comes from a source
# that has regressed, which is why it is refused and not skipped.
closefds() {
  exec 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&-
  leftover=
  highok=1
  (eval 'exec 10>&-') >/dev/null 2>&1 || highok=
  for path in /dev/fd/*; do
    if [ "$path" = "/dev/fd/*" ]; then
      # An unmatched glob expands to itself: the listing failed, so no
      # descriptor was seen, let alone closed. Refuse rather than
      # report them closed.
      leftover="$leftover ?"
      break
    fi
    fd=${path##*/}
    case "$fd" in ''|*[!0-9]*|?) continue ;; esac
    if [ -n "$highok" ]; then
      eval "exec $fd>&-"
    elif [ -e "$path" ] || [ -L "$path" ]; then
      leftover="$leftover $fd"
    fi
  done
  [ -z "$leftover" ] && return 0
  [ -n "${1:-}" ] || return 1
  echo "${0##*/}: descriptors$leftover are open above 9 and this sh cannot close them; not starting $1 with them" >&2
  exit 2
}
# --- end of closefds ---

# --- lowerrows: the same text in merge-local and integrate-train (a test holds them equal) ---
# lowerrows lowers the file size table of the depot's test command to the files
# of the branch, so that a change that shrinks or deletes a listed file never
# edits its row, and two that shrink neighbouring files cannot conflict on those
# lines. It acts where the test command is one file of the branch that carries
# such a table (a line `filesizes='`), and asks that file for it: `sh <it> sizes
# --rewrite` in the worktree. The branch's copy, since it is the branch's own
# table that is rewritten; what judges the branch stays the base's copy. A
# change to the file is made a commit of the branch: `amend` takes it into the
# branch's head, `commit` makes a commit of its own, for a head that is not the
# assembly's to rewrite. The script is the branch's own, and runs after
# closefds with no stdin; it may only leave its own table changed, since what
# it left elsewhere would land in the file that judges the next bead, which
# this run never executes. Neither branch nor base may move, the worktree stays
# on the branch, and it may not stage changes, touch another path, or change a
# line outside the table. Only the run's last bytes are kept, for the hold a
# failing run ends in. A table already right prints nothing and
# touches nothing. A rewrite that fails holds: it says a row stands below its
# file, which no landing may paper over and only a person settles.
#
# The run is bounded as the tests' is (runtest): in the background beside a
# watcher that sleeps YARDR_REWRITE_TIMEOUT seconds (120 unless set), and then
# stops and kills the run's whole tree (stoprun) and holds with what it had
# printed. The rewrite waits on nothing, so there is no race lock to credit. It
# runs ahead of the tests, whose deadline does not reach it, and one that never
# ended would stall the queue of landings. The run, its watcher and their files
# are the script's own pid, watch, napfile, log and latefile, so that bye takes
# them away on any way out, as it does for the tests.
lowerrows() {
  lr_test=${YARDR_TEST:-}
  [ -n "$lr_test" ] || return 0
  [ "$(git -C "$WT" cat-file -t "HEAD:$lr_test" 2>/dev/null)" = blob ] || return 0
  [ -f "$WT/$lr_test" ] && [ ! -L "$WT/$lr_test" ] || return 0
  grep -q "^filesizes='\$" "$WT/$lr_test" || return 0
  lr_limit=${YARDR_REWRITE_TIMEOUT:-120}
  case $lr_limit in
  *[!0-9]*) hold "YARDR_REWRITE_TIMEOUT is $lr_limit in this group's cmd, and it is a whole number of seconds; nothing lands. Correct the cmd, then unhold." ;;
  esac
  lr_head=$(git -C "$REPO" rev-parse "refs/heads/$BR") || hold "cannot record $BR before lowering its file size table"
  lr_base=$(git -C "$REPO" rev-parse "refs/heads/$BASE") || hold "cannot record $BASE before lowering the file size table"
  log=$(mktemp "${TMPDIR:-/tmp}/lowerrows.XXXXXX") || hold "cannot make a file for the file size table rewrite's output"
  latefile=$(mktemp "${TMPDIR:-/tmp}/lowerrows.XXXXXX") || hold "cannot make a file for the file size table rewrite's timeout watcher"
  napfile=$(mktemp "${TMPDIR:-/tmp}/lowerrows.XXXXXX") || hold "cannot make a file for the file size table rewrite's timeout watcher"
  (cd "$WT" && { closefds "the file size table rewrite"; sh "$lr_test" sizes --rewrite; }) >"$log" 2>&1 </dev/null &
  pid=$!
  (
    nap=
    trap 'kill "$nap" 2>/dev/null; exit 0' TERM
    closefds
    sleep "$lr_limit" &
    nap=$!
    echo "$nap" >"$napfile"
    wait "$nap"
    echo late >"$latefile"
    stoprun
  ) &
  watch=$!
  # The watcher records its sleep before it waits on it; hold until it has (a
  # bounded wait), so that unwatched never kills a watcher whose sleep is not
  # yet known.
  lr_i=0
  while [ ! -s "$napfile" ] && [ "$lr_i" -lt 100 ]; do sleep 0.05; lr_i=$((lr_i + 1)); done
  wait "$pid" && lr_ok=1 || lr_ok=
  pid=
  unwatched
  lr_out=$(tail -c 4000 "$log")
  # A run that passed as its deadline came has passed: the marker is empty
  # until the watcher writes to it.
  lr_late=
  [ ! -s "$latefile" ] || [ -n "$lr_ok" ] || lr_late=1
  rm -f "$log" "$latefile" "$napfile"
  log=
  latefile=
  napfile=
  [ -z "$lr_late" ] ||
    hold "the file size table rewrite in $lr_test ran past its deadline of ${lr_limit}s and was killed, so nothing lands:
$lr_out
Correct the rewrite, or raise YARDR_REWRITE_TIMEOUT in this group's cmd, then unhold."
  [ -n "$lr_ok" ] ||
    hold "the file size table in $lr_test cannot be lowered to the files of $BR, so nothing lands:
$lr_out
Correct the table, or split the file it names, then unhold."
  [ -f "$WT/$lr_test" ] && [ ! -L "$WT/$lr_test" ] ||
    hold "the file size table rewrite removed or replaced $lr_test; nothing lands"
  [ "$(git -C "$WT" symbolic-ref -q HEAD)" = "refs/heads/$BR" ] ||
    hold "the file size table rewrite moved the worktree off $BR; nothing lands"
  lr_now=$(git -C "$REPO" rev-parse "refs/heads/$BR") || hold "cannot read $BR after lowering its file size table"
  [ "$lr_now" = "$lr_head" ] || hold "the file size table rewrite moved $BR from $lr_head to $lr_now; nothing lands"
  lr_now_base=$(git -C "$REPO" rev-parse "refs/heads/$BASE") || hold "cannot read $BASE after lowering the file size table"
  [ "$lr_now_base" = "$lr_base" ] || hold "the file size table rewrite moved $BASE from $lr_base to $lr_now_base; nothing lands"
  git -C "$WT" diff --cached --quiet || hold "the file size table rewrite staged changes; nothing lands"
  lr_changes=$(git -C "$WT" status --porcelain --untracked-files=all) || hold "cannot check the worktree after lowering the file size table"
  lr_table_change=$(git -C "$WT" status --porcelain --untracked-files=all -- ":(literal)$lr_test") || hold "cannot check $lr_test after lowering the file size table"
  [ "$lr_changes" = "$lr_table_change" ] || hold "the file size table rewrite changed paths outside $lr_test; nothing lands:
$lr_changes
Correct the rewrite command, then unhold."
  lr_old=$(git -C "$WT" show "HEAD:$lr_test" | awk '$0=="filesizes=\047"&&!found{intable=1;found=1;next} intable&&$0=="\047"{intable=0;next} !intable' | git -C "$WT" hash-object --stdin) ||
    hold "cannot read the committed $lr_test to check the file size table rewrite"
  lr_new=$(awk '$0=="filesizes=\047"&&!found{intable=1;found=1;next} intable&&$0=="\047"{intable=0;next} !intable' "$WT/$lr_test" | git -C "$WT" hash-object --stdin) ||
    hold "cannot read the rewritten $lr_test to check the file size table rewrite"
  [ "$lr_old" = "$lr_new" ] || hold "the file size table rewrite changed lines outside the filesizes table in $lr_test; nothing lands"
  git -C "$WT" diff --quiet -- ":(literal)$lr_test" && return 0
  printf '%s\n' "$lr_out"
  git -C "$WT" add -- "$lr_test" || hold "cannot add the lowered file size table in $lr_test to $BR"
  if [ "$1" = amend ]; then
    git -C "$WT" commit -q --amend --no-edit --no-verify
  else
    git -C "$WT" commit -q --no-verify -m "assembly: lower filesizes rows to actual"
  fi || {
    git -C "$WT" checkout -q HEAD -- "$lr_test"
    hold "cannot commit the lowered file size table in $lr_test to $BR"
  }
  echo "== lowered the file size table in $lr_test ($1 on $BR)"
}
# --- end of lowerrows ---
# The rows are lowered here for the whole train, after the rebase whether or not
# it was needed: a wagon landing on the train's branch leaves them (merge-local),
# and a commit of its own, not an amend, since the head is a child's landed
# commit. The tests below run on the lowered branch, and what lands is it.
lowerrows commit

# The depot's test command runs on exactly what goes to review and then
# lands, as merge-local runs it for a bead and with YARDR_LANDING=1: the
# train is what moves the depot's base. Where the command is the path of a
# file the base has, the base's copy of that file is what runs, with sh, in
# the train's worktree; anything else is a command for sh -c. With no test
# command the train goes to review untested.
#
# Exit 2 is the command saying it could not run at all (closefds says it too,
# for a descriptor above 9 that this sh cannot close), which no child can
# fix. An exit above 128 means the run was ended by a signal from outside,
# which says nothing about the branch and which no child can fix either: as
# in merge-local, it is run once more, after a note with the first run's
# tail, and ended by a signal twice the train is held. The kill at the
# deadline is not this: it is a red run.
TEST=${YARDR_TEST:-}
LIMIT=${YARDR_TEST_TIMEOUT:-1800}
# The beads the tests are of, which the test command is told in
# YARDR_TEST_BEADS: set before the run, below.
BEADS=
# trainbeads prints the train's children, sorted and joined by commas, for
# YARDR_TEST_BEADS. The test command runs with YARDR_BEAD set to the train, and
# a command that records which change a run tested (depot yardr's gate does,
# so its flaky log line names the children rather than the train) would take
# the train for a change of its own, apart from the children it is made of.
# Nothing is printed when the children cannot be read (yardr not answering)
# or there are none, and the variable is then set and empty: it tells that
# test command that there is nothing to name, where an unset variable would
# send it back to YARDR_BEAD, the train.
trainbeads() {
  if json=$("$Y" bead show "$TRAIN" --json 2>/dev/null) &&
      kids=$(printf '%s' "$json" | sed -n '/^  "children": \[/,/^  \]/p' | sed -n -e 's/^    "\([^"]*\)",$/\1/p' -e 's/^    "\([^"]*\)"$/\1/p'); then
    printf '%s\n' "$kids" | LC_ALL=C sort -u | paste -sd, -
  else
    echo "== could not read the children of $TRAIN (yardr must answer); the tests are told no beads" >&2
  fi
}
# gradle_fails prints the failing tests a Gradle run left in the worktree:
# each testcase carrying a failure or an error in a TEST-*.xml file under
# $WT, named classname.name. Gradle's own output says only how many failed,
# so without this a red note names no test. One line per test, in the
# files' sorted order; nothing when there are no such files.
gradle_fails() {
  [ -n "${WT:-}" ] && [ -d "$WT" ] || return 0
  find "$WT" -name 'TEST-*.xml' -type f 2>/dev/null | LC_ALL=C sort | while IFS= read -r xf; do
    awk '
      function attr(line, key,   m) {
        if (match(line, "[ \t]" key "=\"[^\"]*\"")) {
          m = substr(line, RSTART + length(key) + 3, RLENGTH - length(key) - 4)
          return m
        }
        return ""
      }
      /<testcase[^>]*>/ {
        cls = attr($0, "classname"); nm = attr($0, "name")
        failed = ($0 ~ /<failure[ >\/]/ || $0 ~ /<error[ >\/]/) ? 1 : 0
        if ($0 ~ /<\/testcase>/) {
          if (failed) {
            if (cls != "" && nm != "") print cls "." nm
            else if (nm != "") print nm
          }
          cls = ""; nm = ""; failed = 0; incase = 0
        } else if ($0 ~ /\/>[ \t]*$/) {
          cls = ""; nm = ""; failed = 0; incase = 0
        } else {
          incase = 1
        }
        next
      }
      incase && (/<failure[ >\/]/ || /<error[ >\/]/) { failed = 1 }
      incase && /<\/testcase>/ {
        if (failed) {
          if (cls != "" && nm != "") print cls "." nm
          else if (nm != "") print nm
        }
        cls = ""; nm = ""; failed = 0; incase = 0
      }
    ' "$xf" 2>/dev/null
  done
}
# runtest runs the test command in the worktree and leaves its exit status in
# $rc, the last $TAIL lines of its output in $out, how many lines there were
# in $lines, the failing tests in $fails (the full log's FAIL and XCTest
# lines, and the Gradle names, deduped, at most $FAILS, only when the log
# runs past the tail), and $late set when it ran past $LIMIT seconds besides
# what it waited for the race lock. A red run's full log stays in $log until
# the outcome attaches it to the train; a green run's is removed at once, as
# ever. The bound is sh's own, as in merge-local, which says why it is made
# this way.
runtest() {
  # Each file of the run is made by a mktemp of its own, never named from
  # another's: mktemp creates a file exclusively, but a local user of a shared
  # TMPDIR who sees the log's name can plant a symlink or a script at that
  # name with .late or .sh added before it is used (yardr-gb50).
  log=$(mktemp "${TMPDIR:-/tmp}/integrate-train.XXXXXX") || hold "cannot make a file for the tests' output"
  napfile=$(mktemp "${TMPDIR:-/tmp}/integrate-train.XXXXXX") || hold "cannot make a file for the timeout watcher"
  latefile=$(mktemp "${TMPDIR:-/tmp}/integrate-train.XXXXXX") || hold "cannot make a file for the timeout watcher"
  copy=
  if [ "$WHAT" = "the base's copy of $TEST" ]; then
    copy=$(mktemp "${TMPDIR:-/tmp}/integrate-train.XXXXXX") || hold "cannot make a file for the copy of $TEST"
    git -C "$REPO" show "$BASE:$TEST" >"$copy" || hold "cannot read $TEST from $BASE"
  fi
  (
    cd "$WT" || exit 2
    export YARDR_LANDING=1 YARDR_TEST_BEADS="$BEADS"
    # The test command starts with no descriptor above 2 that the run did
    # not give it, or does not start, as merge-local's does for a landing.
    closefds "the tests"
    if [ -n "$copy" ]; then exec sh "$copy"; else exec sh -c "$TEST"; fi
  ) >"$log" 2>&1 </dev/null &
  pid=$!
  (
    nap=
    trap 'kill "$nap" 2>/dev/null; exit 0' TERM
    # The sleep holds none of the run's inherited files. What this sh cannot
    # close stays open here, and the test command's start above refuses it,
    # so a watcher left holding one belongs to a run that is already over.
    closefds
    # The deadline counts only time not spent waiting for the race lock: a
    # train late in the queue would otherwise be killed with every test
    # green. Sleep $LIMIT, then sleep again for the waited seconds not yet
    # credited, repeating until no new wait is found; only then mark late
    # and kill. The gate prints a start marker while it waits and a final
    # `test: waited N s` line when it acquires the lock; account for the
    # elapsed active wait too, since it may outlast LIMIT. The loop is
    # merge-local's, copied: the scripts are installed one file each, and
    # merge-local also ships in the packs, so there is no shared file for
    # them to source. A fix to one is made in both (a test holds them equal).
    credited=0
    parred=0
    wait_for=$LIMIT
    while :; do
      sleep "$wait_for" &
      nap=$!
      echo "$nap" >"$napfile"
      wait "$nap"
      waited=$(awk -v now="$(date +%s)" '
        /^test: race lock wait started at [0-9]+$/ { active=$NF; next }
        /^test: waited [0-9]+ s for the race lock$/ { total+=$3; active="" }
        END { if (active != "") total += now-active; print total+0 }
      ' "$log" 2>/dev/null)
      case "$waited" in ''|*[!0-9]*) waited=0 ;; esac
      # A race leg the gate throttled with -p runs slower by design, so the
      # deadline follows it: cores over -p, floored at 1, times LIMIT. The
      # gate says the throttle in one line; without it the factor is 1 and
      # nothing changes. Normalize the decimal timeout before shell
      # arithmetic, which otherwise treats a value such as 08 as octal.
      # A nonnumeric LIMIT holds the factor at 1 so the fuse remains active.
      throttle=$(awk '
        /^test: go test -p=[0-9]+ [(]load [0-9.]+ on [0-9]+ cores[)]$/ {
          p = $4; sub(/^-p=/, "", p); c = $8
          if (p > 0 && c > 0) { f = int(c / p); if (f < 1) f = 1; fact = f; par = p; cores = c }
        }
        END { if (fact != "") print fact":"par":"cores }
      ' "$log" 2>/dev/null)
      fact=${throttle%%:*}
      parcores=${throttle#*:}
      par=${parcores%%:*}
      cores=${parcores#*:}
      case "$fact" in ''|*[!0-9]*) fact=1 ;; esac
      case "$LIMIT" in
        ''|*[!0-9]*) fact=1; limitnum=0 ;;
        *)
          limitnum=$LIMIT
          while [ "${limitnum#0}" != "$limitnum" ]; do limitnum=${limitnum#0}; done
          [ -n "$limitnum" ] || limitnum=0
          ;;
      esac
      extension=0
      [ "$fact" -gt 1 ] && extension=$(((fact - 1) * limitnum))
      extra=$((waited - credited + extension - parred))
      if [ "$extra" -le 0 ]; then
        break
      fi
      # Past the break the deadline grew: say so once, in the run's log.
      if [ "$parred" -eq 0 ] && [ "$fact" -gt 1 ]; then
        echo "deadline $LIMIT s x $fact for -p=$par on $cores cores" >>"$log"
      fi
      credited=$waited
      parred=$extension
      wait_for=$extra
    done
    echo late >"$latefile"
    seen=
    while t=$(tree "$pid") && [ "$t" != "$seen" ]; do
      # shellcheck disable=SC2086
      kill -STOP $t 2>/dev/null
      seen=$t
    done
    # Whatever ps said, the command itself goes.
    # shellcheck disable=SC2086
    kill -KILL ${seen:-$pid} 2>/dev/null
  ) &
  watch=$!
  # The watcher records its sleep before it waits on it; hold until it has
  # (a bounded wait), so the cleanup never kills a watcher whose sleep is
  # not yet known.
  i=0
  while [ ! -s "$napfile" ] && [ "$i" -lt 100 ]; do sleep 0.05; i=$((i + 1)); done
  wait "$pid" && rc=0 || rc=$?
  pid=
  unwatched
  # A command that passed as its deadline came has passed. The marker is
  # empty until the watcher writes to it, so the deadline came if it holds
  # something.
  late=
  if [ -s "$latefile" ] && [ "$rc" != 0 ]; then
    late=1
    echo "integrate-train: the tests ran past their deadline of ${LIMIT}s and were killed" >>"$log"
  fi
  lines=$(wc -l <"$log" | tr -d ' ')
  out=$(tail -n "$TAIL" "$log")
  # The failing tests a red note keeps ahead of the tail: the full log's
  # FAIL lines (go test's, a shell gate's FAIL:, XCTest's), and the Gradle
  # names from the worktree, deduped and capped, so a failure above the tail
  # still shows. Only when the log runs past the tail; a short run's tail
  # already holds the log's names.
  fails=
  if [ "$lines" -gt "$TAIL" ]; then
    fails=$( { grep -E -e '--- FAIL' -e '^FAIL' -e "Test Case '-\[.*\]' failed" "$log" 2>/dev/null; gradle_fails; } | awk '!seen[$0]++' | head -n "$FAILS" || true)
  fi
  if [ "$rc" = 0 ]; then
    cleanup
    log=
  else
    # A red run's full log stays standing until the outcome attaches it to
    # the train (attach_log); the run's other files go as ever.
    kept=$log
    log=
    cleanup
    log=$kept
  fi
  latefile=
  napfile=
  copy=
  printf '%s\n' "$out"
}
# What a note says of a run's output: all of it, or its end.
shown() {
  if [ "$lines" -gt "$TAIL" ]; then echo "the last $TAIL of $lines lines of output"; else echo "its output"; fi
}
# attach_log carries a red run's full log to the train, so the names and the
# tail in the outcome's note stay readable after the worktree and the run's
# files are gone. It runs before the outcome moves the train (bye takes the
# log with it), and never fails the outcome: a refused attach leaves a note
# saying the output was too large to keep instead.
attach_log() {
  [ -n "${log:-}" ] && [ -f "$log" ] || return 0
  "$Y" bead note "$TRAIN" "integrator: full gate output of the failed run on $BR at $at ($WHAT, exit $rc)" --file "$log" >/dev/null 2>&1 && return 0
  "$Y" bead note "$TRAIN" "integrator: the full gate output of the failed run on $BR at $at ($WHAT, exit $rc) was too large to keep" >/dev/null 2>&1 || true
  return 0
}
tested=$(git -C "$REPO" rev-parse "refs/heads/$BR") || hold "cannot read $BR"
at=$(git -C "$REPO" rev-parse --short "$tested")
if [ -z "$TEST" ]; then
  echo "== depot $DEPOT has no test command: $TRAIN goes to review untested"
  ran="untested: no test command on the depot"
else
  if [ "$(git -C "$REPO" cat-file -t "$BASE:$TEST" 2>/dev/null)" = blob ]; then
    WHAT="the base's copy of $TEST"
  else
    WHAT="the command $TEST"
  fi
  BEADS=$(trainbeads)
  echo "== the tests on $BR at $at: $WHAT, with YARDR_LANDING=1 and YARDR_TEST_BEADS=$BEADS"
  runtest
  if [ "$rc" -gt 128 ] && [ -z "$late" ]; then
    now=$(git -C "$REPO" rev-parse "refs/heads/$BR") || hold "cannot read $BR"
    [ "$now" = "$tested" ] || hold "$BR moved while the tests ran: tested $at, now $(git -C "$REPO" rev-parse --short "$now"). Cannot retry on the same commit."
    first="the tests on $BR at $at ($WHAT) were ended by signal $((rc - 128)) (exit $rc), not by a failing test"
    echo "== $first; running them once more"
    "$Y" bead note "$TRAIN" "integrator: $first; running them once more on the same commit. Of the first run, $(shown):
${fails:+$fails
}$out" || echo "== could not note the first run on $TRAIN"
    out1=$out fails1=$fails
    # The first run's log is noted; only the second run's decides the
    # outcome, so only it is attached. Gone before the second run starts, it
    # cannot leak whatever the second does.
    rm -f "$log"
    log=
    runtest
    [ "$rc" -le 128 ] || [ -n "$late" ] || { attach_log; hold "$first, and again by signal $((rc - 128)) (exit $rc) when run once more. The branch is not at fault: find what sends the signal, then unhold to test it again.
First run:
${fails1:+$fails1
}$out1
Second run:
${fails:+$fails
}$out"; }
  fi
  why="exit $rc"
  [ -z "$late" ] || why="they ran past their deadline of ${LIMIT}s and were killed"
  case $rc in
  0) ;;
  2)
    [ -n "$late" ] || { attach_log; hold "the tests could not run on $BR at $at ($WHAT said so: exit 2); $(shown):
${fails:+$fails
}$out"; }
    ;;
  esac
  if [ "$rc" != 0 ]; then
    # The fix is a child: it lands on the train branch through the usual
    # flow, and blocks the train until it closes, so the train is not
    # integrated again unchanged. It starts in backlog, for the yardmaster
    # to shape.
    msg="the tests failed on $BR at $at rebased onto $BASE ($WHAT, $why); $(shown):
${fails:+$fails
}$out"
    # The hold below runs when either the create or the dep-add fails, which
    # is the intent: both must succeed for the train to have its fix child.
    # shellcheck disable=SC2015
    fix=$(printf '%s\n' "The tests failed on train $TRAIN's branch $BR at $at rebased onto $BASE ($WHAT, $why). Make them pass on $BR. Of the run, $(shown):

${fails:+$fails
}$out" | "$Y" bead create "Fix the tests on train $TRAIN" -d "$DEPOT" -t bug -s backlog -b -) &&
      "$Y" dep add "$TRAIN" "$fix" -k parent ||
      { attach_log; hold "$msg
(adding a child to fix it failed; add one, then unhold)"; }
    attach_log
    report failed "$msg
Added child $fix to fix it; the train is integrated again once it lands."
  fi
  ran="tests passed ($WHAT)"
fi
sha=$(git -C "$REPO" rev-parse --short "$BR")
msg="integrated $BR at $sha onto $BASE; $ran. Review $BASE..$BR."

# Publish the rebased branch, before reporting. A rebase rewrote it, so the
# push may replace the remote's branch, but only when everything there is in
# what was integrated: in $BR as it was before this rebase, or in a tip a
# merger started from. A merger rebases the branch in its worktree without
# pushing it (the merger's role says so), so the remote still has the tip it
# started from, which the conflict note above and the merger's own note
# record as "old tip: <sha>"; those commits are in the branch as rebased.
# Anything else on the remote is someone's commits: never forced over.
if [ -n "$PUSH" ]; then
  tips=$was
  for t in $("$Y" prime --bead "$TRAIN" | grep -o 'old tip: [0-9a-f]\{7,40\}' | awk '{print $3}'); do
    t=$(git -C "$REPO" rev-parse --verify -q "$t^{commit}") && tips="$tips $t"
  done
  within() { for t in $tips; do git -C "$REPO" merge-base --is-ancestor "$1" "$t" 2>/dev/null && return 0; done; return 1; }
  theirs=$(git -C "$REPO" ls-remote "$PUSH" "refs/heads/$BR" | cut -f1)
  if [ -n "$theirs" ] && ! within "$theirs"; then
    why="$PUSH/$BR has commits $BR did not have before the rebase (nor any old tip a merger noted)"
  elif git -C "$REPO" push --force-with-lease="refs/heads/$BR:$theirs" "$PUSH" "$BR" 2>&1; then
    echo "== pushed $BR to $PUSH"
    why=
  else
    why="pushing $BR to $PUSH failed"
  fi
  if [ -n "$why" ] && [ -n "$PR" ]; then
    # A pull request of a branch the remote does not have as integrated
    # would be reviewed and merged as something else.
    case $why in
    *"did not have"*) hold "$msg But $why: not forced, and no pull request opened. Check $PUSH/$BR, then unhold." ;;
    *) report failed "$msg But $why, so no pull request was opened or updated; the next integration retries." ;;
    esac
  fi
  if [ -n "$why" ]; then
    msg="$msg $why (not forced)."
    # Asked only now: a yard names its yardmaster as it likes, and most
    # landings mail nobody.
    [ -n "$NOTIFY" ] || NOTIFY=$("$Y" settings get yardmaster 2>/dev/null) || NOTIFY=yardmaster
    "$Y" mail "$NOTIFY" "integrator: $TRAIN integrated at $sha but $why. Not forced; check $PUSH/$BR." ||
      echo "== could not mail $NOTIFY"
  fi
fi

# The pull request, once the branch it shows is on the remote. Run from the
# depot so gh finds the GitHub repository from its remote. The train's PR is
# the one stored on it, never one looked up by the branch's name: a fork's
# pull request can carry the same name.
if [ -n "$PR" ]; then
  train=$("$Y" bead show "$TRAIN" --json) || report failed "$msg But reading $TRAIN for the pull request failed."
  title=$(printf '%s' "$train" | jq -r .title)
  body=$(
    printf '%s' "$train" | jq -r '.body // ""'
    printf '\n## Children\n\n'
    for c in $(printf '%s' "$train" | jq -r '.children[]?'); do
      printf -- '- %s %s\n' "$c" "$("$Y" bead show "$c" --json | jq -r .title)"
    done
    printf '\nTrain: %s\n' "$TRAIN"
  )
  # stderr apart, so a warning gh prints is not taken for the URL.
  errf=$(mktemp)
  prview() { (cd "$REPO" && gh pr view "$1" --json number,state,headRefName,headRepositoryOwner,headRepository 2>"$errf"); }
  url=$(printf '%s' "$train" | jq -r '.metadata.pr_url // empty')
  bound_num=$(printf '%s' "$train" | jq -r '.metadata.pr_number // empty')
  bound_headrepo=$(printf '%s' "$train" | jq -r '.metadata.pr_head_repo // empty')
  pr=
  if [ -n "$url" ]; then
    pr=$(prview "$url") || report failed "$msg But reading pull request $url failed: $(cat "$errf")"
    # Closed or merged, it is not where this integration goes: a new one is
    # opened and the train bound to that.
    [ "$(printf '%s' "$pr" | jq -r .state)" = OPEN ] || { url=; pr=; }
    if [ -n "$url" ]; then
      actual_num=$(printf '%s' "$pr" | jq -r '.number // empty')
      actual_headrepo=$(printf '%s' "$pr" | jq -r 'if .headRepositoryOwner.login and .headRepository.name then .headRepositoryOwner.login + "/" + .headRepository.name else empty end')
      actual_branch=$(printf '%s' "$pr" | jq -r '.headRefName // empty')
      [ -n "$actual_num" ] && [ -n "$actual_headrepo" ] && [ "$actual_branch" = "$BR" ] ||
        hold "pull request $url no longer has the expected head $BR (GitHub reports #${actual_num:-?} from ${actual_headrepo:-?}:$actual_branch); not touched. Correct the train's pr_url, pr_number and pr_head_repo, then unhold."
      [ -z "$bound_num" ] || [ "$actual_num" = "$bound_num" ] ||
        hold "pull request $url is #$actual_num, but $TRAIN is bound to #$bound_num; not touched. Correct the train's pr_url, pr_number and pr_head_repo, then unhold."
      [ -z "$bound_headrepo" ] || [ "$actual_headrepo" = "$bound_headrepo" ] ||
        hold "pull request $url is from $actual_headrepo, but $TRAIN is bound to $bound_headrepo; not touched. Correct the train's pr_url, pr_number and pr_head_repo, then unhold."
    fi
  fi
  if [ -n "$url" ]; then
    out=$(cd "$REPO" && printf '%s\n' "$body" | gh pr edit "$url" --body-file - 2>&1) ||
      report failed "$msg But updating pull request $url failed: $out"
    msg="$msg Updated pull request $url."
  else
    out=$(cd "$REPO" && printf '%s\n' "$body" |
      gh pr create --base "$prbase" --head "$BR" --title "$title ($TRAIN)" --body-file - 2>&1) || {
      # One is open for the branch that the train is not bound to (opened by
      # hand, or by an integration that could not store it). Whether it is
      # the train's is a human's call, and no retry changes it.
      case $out in
      *"already exists"*) hold "$msg But a pull request for $BR is open that $TRAIN is not bound to: $out
If it is the train's, bind it (yardr bead update $TRAIN --meta pr_url=<its url>) and unhold; the next integration stores its number and head repository. Otherwise close it, then unhold." ;;
      esac
      report failed "$msg But opening a pull request for $BR failed: $out"
    }
    url=$(printf '%s\n' "$out" | grep -o 'https://[^[:space:]]*' | tail -n 1)
    [ -n "$url" ] || report failed "$msg But gh pr create printed no URL: $out"
    msg="$msg Opened pull request $url."
  fi
  # Bind the train to this pull request: its number and the repository its
  # head is in are what pr-train, pr-merge and the daemon's github rules
  # hold every later lookup and event against.
  [ -n "$pr" ] || pr=$(prview "$url") || report failed "$msg But reading pull request $url failed: $(cat "$errf")"
  num=$(printf '%s' "$pr" | jq -r '.number // empty')
  headrepo=$(printf '%s' "$pr" | jq -r 'if .headRepositoryOwner.login and .headRepository.name then .headRepositoryOwner.login + "/" + .headRepository.name else empty end')
  [ -n "$num" ] && [ -n "$headrepo" ] ||
    report failed "$msg But pull request $url has no number or head repository: $pr"
  "$Y" bead update "$TRAIN" --meta "pr_url=$url" --meta "pr_number=$num" --meta "pr_head_repo=$headrepo" >/dev/null ||
    report failed "$msg But binding $TRAIN to pull request $url failed."
fi

report "done" "$msg"
