#!/bin/sh
# server-yard: set up a yard on a fresh Linux server, from the steps of
# docs/install.md ("On a server (no desktop)"), so that it comes back after
# a reboot:
#
#   server-yard --harness <kind> --operator <name> [--wait <duration>] [--permissions <label>]
#
# On a machine that has yardr, herdr, git and a harness on PATH it writes
# herdr's server as a systemd user unit, lets the user's services run with
# nobody logged in (linger), creates the yard and starts it
# (yardr init --harness <kind> --operator <name> --start), installs the
# daemon and the web view as login services, and ends with yardr doctor.
#
# --permissions <label> is passed to yardr init as it stands: the yard is
# made with that harness permission preset for its new agents (a hosted
# box that must run unwatched), where without it the yard keeps the
# harness's unattended flags as any yard made by hand does. Whether the
# label names a preset of the harness is init's to refuse, before it
# writes anything.
#
# herdr's unit carries the PATH of the shell the script runs in and, behind
# an egress proxy, the proxy and CA variables that shell has: the
# agents' panes inherit herdr's server's environment, and a pane without
# them reaches no model. A proxy's address can hold a password, so the unit
# is mode 0600, as the service files yardr writes are.
#
# The harness login is the operator's step, in the yardmaster's pane once
# the yard exists; the script does not wait for it. When init --start does
# not see the yardmaster come up, the script goes on: the daemon starts it
# once the login is there. The last word is doctor's, and so is the exit
# status: 0 when doctor names no fault, 1 when it still lacks something
# (on a fresh machine, the harness login).
#
# Doctor is asked once the daemon the service manager started holds its
# lock: systemd returns from starting a unit before its process runs, and
# on a slow machine doctor, asked at once, would find no daemon. The script
# looks once a second, for up to SERVER_YARD_DAEMON_WAIT seconds (60 when
# unset). A daemon that is not up by then is a failure, not a missing piece
# like the login: the run ends there with exit status 1, naming the daemon.
#
# A daemon holds its lock before it has started the yardmaster. Where
# init --start gave up on the yardmaster (a slow machine), the daemon the
# manager started may not have got to it yet, and doctor faults that moment:
# the yardmaster is "not running, and no start has failed: the daemon may
# still be at it", which the machine does not lack. So the script asks doctor
# again, once a second, for as long as it says that, for up to
# SERVER_YARD_DAEMON_WAIT seconds as well, counted on the clock because each
# ask is a doctor run. A yardmaster the daemon has not started by then ends
# the run with exit status 1, naming the daemon's log, as a daemon that is not
# up does. Anything else doctor says of the yardmaster, a session that runs
# without its harness's login included, ends the wait.
#
# A second run with the same flags changes nothing: each step looks at what
# is there first and says "already" where there is nothing to do. A changed
# PATH, or proxy or CA variable, is written into herdr's unit again; it
# reaches the daemon's and the web view's services the way it always does, by
# running `yardr daemon install` and `yardr web install` again
# (docs/install.md); the script does not reinstall what is loaded.
set -eu

desired=
trap 'rm -f "$desired"' EXIT

usage() {
  echo "usage: server-yard --harness <kind> --operator <name> [--wait <duration>] [--permissions <label>]" >&2
  exit 2
}

harness=
operator=
wait=
permissions=
have_permissions=
while [ $# -gt 0 ]; do
  case "$1" in
  --harness=*) harness=${1#--harness=} ;;
  --harness) [ $# -ge 2 ] || usage; harness=$2; shift ;;
  --operator=*) operator=${1#--operator=} ;;
  --operator) [ $# -ge 2 ] || usage; operator=$2; shift ;;
  --wait=*) wait=${1#--wait=} ;;
  --wait) [ $# -ge 2 ] || usage; wait=$2; shift ;;
  --permissions=*) permissions=${1#--permissions=}; have_permissions=1 ;;
  --permissions) [ $# -ge 2 ] || usage; permissions=$2; have_permissions=1; shift ;;
  -h | --help) usage ;;
  *) usage ;;
  esac
  shift
done
[ -n "$harness" ] && [ -n "$operator" ] || usage
[ "$have_permissions" != 1 ] || [ -n "$permissions" ] || usage
# The waits below compare this value as a shell integer. Keep it in the
# signed range every POSIX shell supports, or an oversized number could make
# the comparison fail on every poll.
daemon_wait=${SERVER_YARD_DAEMON_WAIT:-60}
case $daemon_wait in
*[!0-9]*)
  echo "server-yard: SERVER_YARD_DAEMON_WAIT must be a whole number of seconds from 0 to 999999999" >&2
  exit 2
  ;;
esac
if [ "${#daemon_wait}" -gt 9 ]; then
  echo "server-yard: SERVER_YARD_DAEMON_WAIT must be a whole number of seconds from 0 to 999999999" >&2
  exit 2
fi
: "${HOME:?HOME is not set}"
user=${USER:-$(id -un)}

# The harness's program is its kind, except cursor, which herdr starts as
# cursor-agent: the one entry of agents.Executable that is not itself.
exe=$harness
[ "$harness" = cursor ] && exe=cursor-agent

# Every program the steps need, named at once when one is missing. The ones
# a user installed for themselves are in ~/.local/bin, which a login shell has
# on its PATH through ~/.profile and a shell without one (ssh host cmd) does
# not: they are named apart, since installing them again is not the way on.
missing=
in_local_bin=
for p in yardr herdr git "$exe" systemctl loginctl; do
  if ! command -v "$p" >/dev/null 2>&1; then
    missing="$missing $p"
    if [ -x "$HOME/.local/bin/$p" ]; then
      in_local_bin="$in_local_bin $p"
    fi
  fi
done
if [ -n "$missing" ]; then
  echo "server-yard: these are not on PATH:$missing" >&2
  if [ -n "$in_local_bin" ]; then
    echo "server-yard: in $HOME/.local/bin, which this shell's PATH lacks:$in_local_bin" >&2
    echo "server-yard: run this from a login shell (an ssh session is one; ssh host cmd is not), or put that directory on PATH" >&2
  fi
  echo "server-yard: install what is not there first (docs/install.md)" >&2
  exit 1
fi
herdr_bin=$(command -v herdr)
echo "server-yard: yardr=$(command -v yardr) herdr=$herdr_bin git=$(command -v git) $exe=$(command -v "$exe")"

# A systemd user session to talk to, before anything is written. ssh opens
# one, and so do sudo -i and su -; sudo -u and su without the dash leave
# XDG_RUNTIME_DIR unset, and the first systemctl --user would end the script
# with "Failed to connect to bus" after the unit file was rewritten.
if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "server-yard: systemctl --user reaches no systemd user session of $user" >&2
  echo "server-yard: log in as the account does for one (ssh, or sudo -iu $user): sudo -u and su without a dash give none" >&2
  echo "server-yard: with linger on (as root: loginctl enable-linger $user) its manager runs without a session; export XDG_RUNTIME_DIR=/run/user/\$(id -u) lets systemctl --user find it" >&2
  exit 1
fi

# unit_escape is s as one word of a systemd unit's line, as yardr's unitWord
# writes an Environment value: what systemd would expand in it (a %
# specifier, a quote outside quotes) is written so that it is not. unit_cmd
# is the same for a command line, where a $ is escaped too.
unit_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/%/%%/g'
}
unit_cmd() {
  unit_escape "$1" | sed -e 's/\$/$$/g'
}

# unit_env is the unit's Environment lines: the PATH, then each proxy and CA
# variable this environment has. They are the nine that yardr hands on to its
# server and its login services, in the order of egressVars in
# internal/server/server.go (docs/configuration.md, "Behind an egress
# proxy"). One that is set and empty goes on as it is, as yardr hands it on,
# and one that is not set gets no line, since the box may need none: printenv
# tells them apart, and reads the environment the script was started with.
unit_env() {
  printf 'Environment="PATH=%s"\n' "$(unit_escape "$PATH")"
  for name in HTTPS_PROXY https_proxy HTTP_PROXY http_proxy NO_PROXY no_proxy \
    SSL_CERT_FILE SSL_CERT_DIR NODE_EXTRA_CA_CERTS; do
    if value=$(printenv "$name"); then
      printf 'Environment="%s=%s"\n' "$name" "$(unit_escape "$value")"
    fi
  done
}

# herdr's server as a systemd user unit: the unit of docs/install.md ("Keep
# it running after a reboot"), with the values quoted as systemd needs.
# Beside a server that already runs, the file is only enabled: it takes
# effect at the next login, and the running server is left alone.
unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
unit=$unit_dir/herdr.service
desired=$(mktemp)
cat >"$desired" <<UNIT
# Written by contrib/server-yard/server-yard; see docs/install.md, "Keep it running after a reboot".
[Unit]
Description=herdr server

[Service]
ExecStart="$(unit_cmd "$herdr_bin")" "server"
$(unit_env)
Restart=on-failure

[Install]
WantedBy=default.target
UNIT
# An earlier run may have written the same unit while it was still 0644.
# Close an existing file before comparing it, even when its contents match.
if [ -f "$unit" ]; then
  chmod 600 "$unit"
fi
if [ -f "$unit" ] && cmp -s "$desired" "$unit"; then
  echo "server-yard: already: $unit is written"
else
  mkdir -p "$unit_dir"
  # The unit can hold the password of a proxy's address, so it is 0600 as the
  # service files yardr writes are, and before anything goes into it: a
  # redirect keeps the mode of a file that is there (one an earlier script left
  # 0644) and gives a new one the umask's.
  : >>"$unit"
  chmod 600 "$unit"
  cat "$desired" >"$unit"
  echo "server-yard: wrote $unit"
  systemctl --user daemon-reload
fi
rm -f "$desired"
server_up() {
  herdr status server 2>/dev/null | grep -q "^status: running"
}
if systemctl --user is-enabled herdr >/dev/null 2>&1; then
  if server_up; then
    echo "server-yard: already: herdr's server starts at login and runs"
  else
    systemctl --user start herdr
  fi
elif server_up; then
  systemctl --user enable herdr
  echo "server-yard: herdr's server runs already; the unit starts it from the next login on"
else
  systemctl --user enable --now herdr
fi
i=0
until server_up; do
  i=$((i + 1))
  if [ "$i" -gt 50 ]; then
    echo "server-yard: herdr's server is not running after enabling the unit" >&2
    herdr status server 2>&1 | sed 's/^/server-yard: /' >&2 || true
    echo "server-yard: see journalctl --user -u herdr" >&2
    exit 1
  fi
  sleep 0.2
done
echo "server-yard: herdr's server runs ($(herdr status server 2>/dev/null | grep '^socket: ' || echo "socket unknown"))"

# Linger: a user unit runs while its user is logged in, and from boot to
# shutdown with it. A server without polkit lets root turn it on and nobody
# else, the account itself included: "Could not enable linger: Access
# denied" says nothing of that, so the script does.
if loginctl show-user "$user" -p Linger 2>/dev/null | grep -q "^Linger=yes"; then
  echo "server-yard: already: linger is on for $user"
elif loginctl enable-linger "$user"; then
  echo "server-yard: linger is on for $user"
else
  echo "server-yard: could not turn linger on for $user: as root, loginctl enable-linger $user, then run this again" >&2
  exit 1
fi

# daemon_up is whether a daemon holds the yard's lock, as yardr daemon status
# says; doctor judges the same lock.
daemon_up() {
  yardr daemon status 2>/dev/null | grep -q "^daemon  *running (pid "
}

# yardmaster_pending is whether doctor says the yardmaster is still to come:
# the daemon runs, the yardmaster's session does not, and no start of it has
# failed (docs/doctor.md). That is the one fault of the yardmaster's that
# passes by itself; anything else doctor says of it, a fault of its own
# included, is the last word.
yardmaster_pending() {
  yardr doctor 2>&1 | grep -q "no start has failed: the daemon may still be at it"
}

# The yard, started. Without the harness login the yardmaster does not come
# up, and that is the operator's next step, not the script's failure: what
# matters here is the yard and its daemon, which starts the yardmaster once
# the login is there. --no-chat: in a terminal init would otherwise open
# yardr chat on the yardmaster and wait in it. Its stdin is /dev/null for the
# same reason: with a terminal on it, init stops to ask whether to make one
# real call to the harness first (a model call, and a harness without its
# login fails it), which a script that goes on without the login must not
# wait for. Without a terminal init asks nothing; yardr doctor --try is
# that call, made when the login is there.
# The preset, where one was named, as init's own words after the fixed
# ones: a label with a space in it ("accept edits") stays one word. Without
# one, init is called exactly as before.
if [ -n "$permissions" ]; then
  set -- --permissions "$permissions"
else
  set --
fi
set +e
if [ -n "$wait" ]; then
  yardr init --harness "$harness" --operator "$operator" --start --no-chat --wait "$wait" "$@" </dev/null
else
  yardr init --harness "$harness" --operator "$operator" --start --no-chat "$@" </dev/null
fi
rc=$?
set -e
if [ "$rc" -ne 0 ]; then
  if daemon_up; then
    echo "server-yard: init --start did not see the yardmaster come up; going on: the daemon starts it once the harness is logged in"
  else
    echo "server-yard: init --start failed and no daemon runs; see above and <home>/daemon.log" >&2
    exit 1
  fi
fi

# The daemon and the web view as login services, unless they already are:
# an install over one loaded would stop and start it again.
if yardr daemon status 2>/dev/null | grep "^service " | grep -q "installed and loaded"; then
  echo "server-yard: already: the daemon starts at login"
else
  yardr daemon install
fi
if yardr web status 2>/dev/null | grep "^service " | grep -q "installed and loaded"; then
  echo "server-yard: already: the web view starts at login"
else
  yardr web install
fi

# The install returns when the manager has loaded the unit, not when the
# daemon holds its lock: systemd returns from starting a unit before its
# process runs. Doctor, asked at once, can find no daemon where one is a
# moment from up, so wait for the effect, bounded.
i=0
until daemon_up; do
  if [ "$i" -ge "$daemon_wait" ]; then
    echo "server-yard: the daemon did not come up in $daemon_wait s" >&2
    yardr daemon status 2>&1 | sed 's/^/server-yard: /' >&2 || true
    echo "server-yard: see <home>/daemon.log and journalctl --user -u 'yardr-daemon-*'; SERVER_YARD_DAEMON_WAIT=<seconds> waits longer" >&2
    exit 1
  fi
  if [ "$i" -eq 0 ]; then
    echo "server-yard: waiting for the daemon to come up (up to $daemon_wait s)"
  fi
  i=$((i + 1))
  sleep 1
done

# The daemon holds its lock before it has started the yardmaster, so doctor,
# asked now, can fault a start that is on its way. Wait for the effect,
# bounded, on the clock: each look is a doctor run, which on a loaded machine
# takes more than the second slept after it.
began=$(date +%s)
i=0
while yardmaster_pending; do
  if [ "$i" -eq 0 ]; then
    echo "server-yard: waiting for the yardmaster to start (up to $daemon_wait s)"
  fi
  if [ $(($(date +%s) - began)) -ge "$daemon_wait" ]; then
    echo "server-yard: the yardmaster did not start in $daemon_wait s" >&2
    echo "server-yard: see <home>/daemon.log and yardr crew list; SERVER_YARD_DAEMON_WAIT=<seconds> waits longer" >&2
    exit 1
  fi
  i=$((i + 1))
  sleep 1
done

# The last word is doctor's: what this machine still lacks, and the exit
# status with it.
echo "server-yard: what is still missing:"
yardr doctor
