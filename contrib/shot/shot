#!/bin/sh
# shot: a window-sized PNG of a web page, with headless Chrome.
#
# shot <url> <file> writes <file> as a 1280x800 PNG of <url>; SHOT_WIDTH
# pixels changes the width (390 is a phone's), and the height stays 800. It
# refuses a page that is not there and a file that cannot be written, with the
# reason, before Chrome runs; afterwards a shot Chrome wrote nothing to is
# refused the same way, since headless Chrome exits 0 however the page loaded.
# Under 500 wide the page is shot inside a frame of that width, since Chrome
# on macOS lays every narrower window out 500 wide; a page that forbids
# framing is refused instead, naming the header.
#
# A page that answers 4xx or 5xx is a page that is not there, whatever it
# sends: an error page and a missing route can answer alike, so only the
# person shooting can say the page is meant to. SHOT_ANY_STATUS=1 says so: a
# page that sends a body is shot, and one that sends none is refused as an
# empty answer, since there is nothing to render and Chrome shoots nothing for
# it, or its own error page. Unset, empty or 0 leaves the switch off, and any
# other value is refused.
#
# A page whose assets arrive late can be shot before they do: headless
# Chrome shoots as the page finishes loading, so a CDN typeface still on
# its way shows as its fallback face, or as no text at all. SHOT_WAIT
# seconds waits them out (SHOT_WAIT=5 holds the shot five virtual seconds
# for late arrivals); unset or empty, the shot goes as Chrome finishes
# loading, as before.
#
# Chrome is SHOT_CHROME where that names an executable, else the first of
# google-chrome, google-chrome-stable, chromium and chromium-browser on PATH,
# else the macOS application. The page is fetched first with curl, which must
# be on PATH. Chrome runs against a throwaway profile, so the shot never
# touches the operator's own. Chrome gets SHOT_TIMEOUT seconds to finish, a
# minute when that is unset; a slower shot fails with the reason and what
# Chrome printed so far.
set -u

[ $# -eq 2 ] || { echo "shot: a URL and a file: shot <url> <file>" >&2; exit 2; }
url=$1
out=$2
[ -n "$out" ] || { echo "shot: the file must not be empty" >&2; exit 2; }
# The URL is a web page's and nothing else: one that starts with a dash is
# an option to curl and to Chrome, and a file: URL shoots a file of this
# machine.
case "$url" in
  http://*|https://*) ;;
  *) echo "shot: $url: the URL must start with http:// or https://" >&2; exit 2 ;;
esac

# The file first: it is decided on this machine, and the page may hang.
# A symbolic link is not followed: the shot empties and overwrites its file.
[ ! -L "$out" ] || { echo "shot: $out: is a symbolic link" >&2; exit 1; }
if [ -e "$out" ]; then
  [ -f "$out" ] || { echo "shot: $out: is not a regular file" >&2; exit 1; }
  [ -w "$out" ] || { echo "shot: $out: is not writable" >&2; exit 1; }
else
  case "$out" in */*) dir=${out%/*} ;; *) dir=. ;; esac
  [ -e "$dir" ] || { echo "shot: $out: its directory $dir does not exist" >&2; exit 1; }
  [ -d "$dir" ] || { echo "shot: $out: its directory $dir is not a directory" >&2; exit 1; }
  [ -w "$dir" ] || { echo "shot: $out: its directory $dir is not writable" >&2; exit 1; }
fi

# in_127_8 reports whether $1 is a dotted quad in 127.0.0.0/8, read the
# way Go's clients read it: four decimal parts, the first 127, each of
# the rest without leading zeros and 0-255. A name that merely starts
# with 127. is not one, and stays on the proxy.
valid_octet() {
  case $1 in
    0|[1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) return 0 ;;
    *) return 1 ;;
  esac
}

in_127_8() {
  case $1 in
    127.*) rest=${1#127.} ;;
    *) return 1 ;;
  esac
  i=0
  while [ "$i" -lt 2 ]; do
    case $rest in
      *.*) part=${rest%%.*}; rest=${rest#*.} ;;
      *) return 1 ;;
    esac
    valid_octet "$part" || return 1
    i=$((i+1))
  done
  case $rest in *.*) return 1 ;; esac
  valid_octet "$rest"
}

# The throwaway profile is made before the page check: besides Chrome's
# profile it holds the check's headers and, under 500 wide, the frame page.
prof=$(mktemp -d "${TMPDIR:-/tmp}/shot.XXXXXX") ||
  { echo "shot: cannot make a profile directory" >&2; exit 1; }
trap 'rm -rf "${prof:?}"' EXIT

# Then the page, with curl's reason when it is not there.
command -v curl >/dev/null 2>&1 || { echo "shot: curl is not on PATH: it checks the page before the shot" >&2; exit 1; }
# A loopback page needs no proxy, and the box's may not reach it: curl
# honours the proxy variables for every host, where Go's clients never
# send loopback to one, so with a proxy set the check of a served page
# fails however the page is. Bypass the proxy with --noproxy when the
# page's host is loopback, Go's own set (127.0.0.0/8, ::1 and localhost);
# a remote page goes through the proxy as before, which it may need.
authority=${url#*://}
authority=${authority%%[/?#]*}
host=${authority##*@}
case "$host" in
  \[*\]*) host=${host#\[}; host=${host%%\]*} ;;
  *) host=${host%%:*} ;;
esac
noproxy=
case "$host" in
  [lL][oO][cC][aA][lL][hH][oO][sS][tT]) noproxy=localhost ;;
  ::1) noproxy=$host ;;
  127.*) in_127_8 "$host" && noproxy=$host ;;
esac
# The flag replaces NO_PROXY, so it is passed only for a loopback page,
# whose only fetch is this one. Unquoted: empty it passes nothing, and a
# matched host holds no spaces or glob characters.
noproxy_flags=
[ -n "$noproxy" ] && noproxy_flags="--noproxy $noproxy"
# -f is what refuses a page that answers 4xx or 5xx, with its status, so
# SHOT_ANY_STATUS=1 is the one thing that drops it. It then keeps the final
# answer's body, which the empty-answer check after the fetch judges an error
# status by; otherwise the body is discarded, as it always was. A value that is
# neither 1 nor off is refused, before the page is fetched, rather than read as
# off: whoever wrote yes would otherwise be told the page is missing.
fail=-f body=/dev/null
case "${SHOT_ANY_STATUS:-0}" in
  0) ;;
  1) fail='' body=$prof/body ;;
  *) echo "shot: SHOT_ANY_STATUS=$SHOT_ANY_STATUS is not 1 (on) or 0 (off)" >&2; exit 1 ;;
esac
# A SHOT_WAIT that is not a positive number of seconds is refused, before
# the page is fetched, rather than read as no wait: whoever wrote it would
# otherwise be told the page is missing, or handed a shot the wait was
# meant to save.
wait_flags=
if [ -n "${SHOT_WAIT:-}" ]; then
  case "$SHOT_WAIT" in
    ""|*[!0-9]*) { echo "shot: SHOT_WAIT=$SHOT_WAIT is not a positive number of seconds" >&2; exit 1; } ;;
  esac
  [ "$SHOT_WAIT" -gt 0 ] 2>/dev/null || { echo "shot: SHOT_WAIT=$SHOT_WAIT is not a positive number of seconds" >&2; exit 1; }
  # The budget is milliseconds: seconds with three zeros, not arithmetic, in
  # which a leading zero reads as octal and 08 is no number.
  wait_flags="--virtual-time-budget=${SHOT_WAIT}000"
fi
# The headers are kept for the framing check on the wrapper path below. The
# status goes to stdout and curl's reason to a file, which is what a refusal
# prints.
# shellcheck disable=SC2086
code=$(umask 077; curl -sS $fail -L -o "$body" -w '%{http_code}' -D "$prof/headers" --max-time 60 --proto =http,https --proto-redir =http,https $noproxy_flags -- "$url" 2>"$prof/reason") ||
  { echo "shot: $url: $(cat "$prof/reason")" >&2; exit 1; }
# Without -f an error status is an answer like another, and what makes it a
# page is its body: a bare one has nothing to render, and Chrome shoots nothing
# for it, or its own error page, neither of them a shot of this page. -o holds
# the final answer's body alone, so the body of a redirect on the way does not
# count.
case "$code" in
  [45]??)
    [ -s "$body" ] ||
      { echo "shot: $url: empty answer: it said $code with no body, so there is nothing to shoot" >&2; exit 1; } ;;
esac

# Then Chrome. A name on PATH is resolved to its path, so the check below
# holds the binary and not the working directory.
if [ -n "${SHOT_CHROME:-}" ]; then
  chrome=$SHOT_CHROME
  [ -x "$chrome" ] || { echo "shot: SHOT_CHROME=$chrome is not executable" >&2; exit 1; }
else
  chrome=
  for c in google-chrome google-chrome-stable chromium chromium-browser; do
    if p=$(command -v "$c"); then chrome=$p; break; fi
  done
  if [ -z "$chrome" ]; then
    app="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    [ -x "$app" ] && chrome=$app
  fi
  [ -n "$chrome" ] || {
    echo "shot: no headless Chrome found (looked for google-chrome, google-chrome-stable, chromium, chromium-browser and the macOS application); set SHOT_CHROME to its path" >&2
    exit 1
  }
fi

# Chrome gets SHOT_TIMEOUT seconds, a minute when that is unset: under load
# headless Chrome can take minutes to answer or never do, and the shot must
# not hang with it.
: "${SHOT_TIMEOUT:=60}"
case "$SHOT_TIMEOUT" in
  ""|*[!0-9]*) { echo "shot: SHOT_TIMEOUT=$SHOT_TIMEOUT is not a positive number of seconds" >&2; exit 1; } ;;
esac
[ "$SHOT_TIMEOUT" -gt 0 ] 2>/dev/null || { echo "shot: SHOT_TIMEOUT=$SHOT_TIMEOUT is not a positive number of seconds" >&2; exit 1; }

# The window is SHOT_WIDTH pixels wide, 1280 when that is unset, and 800 high.
# A page lays itself out for the width of its window, so a phone-width check
# needs a window that narrow, not a crop of a wider shot. Only the width is a
# setting: it is what a layout changes with.
: "${SHOT_WIDTH:=1280}"
case "$SHOT_WIDTH" in
  ""|*[!0-9]*) { echo "shot: SHOT_WIDTH=$SHOT_WIDTH is not a positive number of pixels" >&2; exit 1; } ;;
esac
[ "$SHOT_WIDTH" -gt 0 ] 2>/dev/null || { echo "shot: SHOT_WIDTH=$SHOT_WIDTH is not a positive number of pixels" >&2; exit 1; }

# Under 500 wide the page is shot through a frame: Chrome on macOS will not
# make a window narrower than 500, so a direct shot at such a width lays the
# page out 500 wide and the PNG is its left slice. The wrapper is one iframe
# at the shot's width, shot by file:// with the same window flag; the PNG's
# left edge is then the frame's, at the exact width. At 500 and above the
# page is shot direct, as before.
shoot=$url
if [ "$SHOT_WIDTH" -lt 500 ]; then
  # file:// is never same-origin with the page, so any framing opt-out
  # forbids the wrapper, whatever its value; the shot is refused naming it,
  # before Chrome runs and before the out file is touched.
  if grep -qi '^x-frame-options:' "$prof/headers" 2>/dev/null; then
    echo "shot: $url: X-Frame-Options forbids framing this page, so it cannot be shot under 500 pixels wide" >&2
    exit 1
  fi
  if grep -qi '^content-security-policy:.*frame-ancestors' "$prof/headers" 2>/dev/null; then
    echo "shot: $url: frame-ancestors forbids framing this page, so it cannot be shot under 500 pixels wide" >&2
    exit 1
  fi
  src=$(printf '%s' "$url" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')
  wrap=$prof/wrap.html
  cat >"$wrap" <<EOF || { echo "shot: cannot write the frame page for $url" >&2; exit 1; }
<!DOCTYPE html>
<html><head><meta charset="utf-8"><style>html,body{margin:0;padding:0}iframe{border:0;display:block}</style></head><body><iframe src="$src" width="$SHOT_WIDTH" height="800"></iframe></body></html>
EOF
  shoot="file://$wrap"
fi
# A stop in mid-shot stops Chrome too: the exit path below kills the
# watcher alone, so without this a Chrome that ignores TERM outlives the
# script. Each trap names its signal and exit code, and the handler stops
# the watcher, gives Chrome TERM with the watchdog's grace and then KILL
# whatever it did, removes the profile, and exits 128+n; it ends with
# exit, never falling through to the normal path. The watcher is stopped
# with USR1, which this shell does not trap, and not with TERM, which it does
# (see where the watcher is forked).
stop_shot() {
  kill -USR1 "${watcher:-}" 2>/dev/null
  wait "${watcher:-}" 2>/dev/null
  kill -TERM "${pid:-}" 2>/dev/null
  sleep 5
  kill -KILL "${pid:-}" 2>/dev/null
  rm -rf "${prof:?}"
  # Set by the TERM/INT/HUP traps below, the only callers of this handler.
  # shellcheck disable=SC2154
  echo "shot: stopped by SIG${stop_sig}; Chrome stopped" >&2
  # shellcheck disable=SC2154
  exit "$stop_code"
}
trap 'stop_sig=TERM; stop_code=143; stop_shot' TERM
trap 'stop_sig=INT; stop_code=130; stop_shot' INT
trap 'stop_sig=HUP; stop_code=129; stop_shot' HUP
# A previous shot at this path must not make a Chrome run that writes
# nothing look successful.
: >"$out" || { echo "shot: cannot prepare $out for Chrome" >&2; exit 1; }
# Chrome runs in the background under a watchdog: past SHOT_TIMEOUT seconds
# the watchdog stops it, first politely and then with force, so the shot
# fails instead of hanging. The watchdog's touch says the deadline passed:
# without it a Chrome that failed on its own keeps its own reason. If Chrome
# finishes first, the watchdog stops and reaps its timer instead of leaving
# a sleeper behind.
# Unquoted: empty wait_flags passes nothing, and set it is one flag with no
# spaces.
# shellcheck disable=SC2086
"$chrome" --headless --disable-gpu --user-data-dir="$prof" $wait_flags \
  --screenshot="$out" --window-size="$SHOT_WIDTH,800" "$shoot" </dev/null &
pid=$!
# The watcher and its timer are stopped with a signal that the shell which
# forked them does not trap. A fork is a copy of its shell until it resets the
# traps it copied, which a loaded machine can leave waiting a good while, and a
# signal that is trapped there reaches the copy as the trap of the shell it
# copies and is dropped when the copy resets them. A TERM to the watcher, which
# this shell traps, was dropped that way after a Chrome that had ended at once:
# the wait below then waited out the whole watchdog, SHOT_TIMEOUT and its grace,
# and reported that Chrome had not finished. The watcher is stopped with USR1,
# which this shell traps nowhere, so a copy that has not run yet dies of it by
# default and one that has takes it as its own trap; its timer, forked holding
# the watcher's traps, with KILL. Chrome is stopped with TERM and then, after
# the grace, KILL, which a TERM dropped in the same way does not outlast.
( timer=
  # Invoked by the subshell's TERM/INT/HUP/USR1 trap below, not by name.
  # shellcheck disable=SC2329
  stop_timer() {
    trap - TERM INT HUP USR1
    if [ -n "$timer" ]; then
      # KILL ends the timer whether it has exec'd sleep yet or is still a
      # copy of this subshell with its traps, and a sleep has nothing to
      # clean up.
      kill -KILL "$timer" 2>/dev/null
      wait "$timer" 2>/dev/null
    fi
    exit 0
  }
  trap 'stop_timer' TERM INT HUP USR1
  sleep "$SHOT_TIMEOUT" &
  timer=$!
  wait "$timer"
  timer=
  touch "$prof/timedout"
  kill -TERM "$pid" 2>/dev/null
  sleep 5 &
  timer=$!
  wait "$timer"
  timer=
  kill -KILL "$pid" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
watcher=$!
wait "$pid"
rc=$?
kill -USR1 "$watcher" 2>/dev/null
wait "$watcher" 2>/dev/null
if [ "$rc" -ne 0 ] && [ -f "$prof/timedout" ]; then
  echo "shot: chrome did not finish within ${SHOT_TIMEOUT}s" >&2
  exit 1
fi
if [ "$rc" -ne 0 ]; then
  echo "shot: $url: Chrome failed with exit $rc" >&2
  exit "$rc"
fi
[ -s "$out" ] || { echo "shot: $url: Chrome shot nothing to $out (exit $rc)" >&2; exit 1; }
