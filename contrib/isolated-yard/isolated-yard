#!/bin/sh
# isolated-yard: a throwaway yard with its own herdr server, for testing
# anything that starts agents. It is built so that a real agent cannot start
# and the caller's own herdr and yard cannot be reached:
#
#   isolated-yard up            builds it, proves it, prints its directory D
#   D/e <command> ...           runs a command inside it (D/e yardr init ...)
#   isolated-yard down D        stops everything in it by pid and removes D
#   isolated-yard bare          the yard without a herdr server: prints D
#   isolated-yard pids D        prints the pids down would stop, stops none
#   isolated-yard watchdog D    waits for the test binary that named itself to
#                               D to end, then runs down (started by up and
#                               bare, below; a test may run it by hand)
#
# A bare yard is for what starts no agent (a server, a daemon, the CLI): no
# herdr is on its PATH, so nothing in it can open a pane. It ends with `down`
# like any other.
#
# Run `up` from the worktree under test: D/bin/yardr is `go build` of the
# current directory. What keeps a run isolated:
#
#   - D/e is `env -i`: nothing of the calling session is inherited, so no
#     HERDR_SOCKET_PATH (which would reach the caller's herdr) and no YARDR_*.
#     It sets HOME, XDG_CONFIG_HOME, XDG_STATE_HOME and YARDR_HOME under D,
#     PATH to D/bin and the system directories only, and __CF_USER_TEXT_ENCODING
#     from the caller's environment (without it a fresh binary's first run
#     under the codex sandbox stalls in dyld, before main: yardr-ts2c).
#     The one other thing of the caller's it keeps is the name of a test
#     binary, YARDR_TEST_OWNER and YARDR_TEST_HOME_CHECK, when the environment
#     that made the yard has them: the yard's servers then stop with the binary.
#     It keeps that binary's YARDR_TEST_START_WAIT likewise: the long wait of
#     the yardr a test runs through D/e for a server it starts.
#     A watchdog that `up` and `bare` start for the yard goes by the same
#     name: when that binary is gone it runs `down`, which stops the herdr
#     server and the stand-in agents too, since they look for no owner.
#   - D/h/.profile sets PATH back to the same directories: what yardr asks
#     the yard's login shell for (a program its PATH lacks) is not found in
#     the machine's own directories, which the system's profile adds. A trial
#     of that lookup writes D/h/.profile itself, and only with directories
#     that hold no real herdr or agent.
#   - The isolated herdr starts pane shells as /bin/sh, non-login. A login
#     shell rebuilds PATH (macOS path_helper, the user's profile) and finds
#     the real agent in Homebrew's bin ahead of any fake; a non-login shell
#     keeps the server's PATH.
#   - D/bin/claude is the stand-in from ./fake. Use kind claude for groups and
#     crew members (`yardr init --harness claude`): no other agent kind is on
#     the pane's PATH, so any other kind fails to start instead of starting
#     the real one. An agent kind "the machine does not have" is no
#     protection: it may be installed tomorrow.
#
# What it does not isolate is TCP: D/e keeps environment and sockets under D,
# but a port is the machine's. A server a trial starts takes a free loopback
# port (listen on 127.0.0.1:0 and read the port back), never a fixed one:
# 8791 is yardr web's and 8790 the hooks'. A listener on 127.0.0.1 takes the
# loopback's connections from one bound to all addresses, so a stand-in on
# 8791 stands in front of the caller's web view, and what the trial sends
# there once the stand-in has stopped reaches the real one (yardr-9z02).
#
# `up` then checks, in a pane of the isolated herdr, that `command -v claude`
# is D/bin/claude and that the isolated agent list is empty, and prints both.
# If either fails it tears the yard down and exits 1.
#
# D is short (/tmp/iy.XXXXXX): a unix socket path has a length limit.
set -eu

usage() {
  echo "usage: isolated-yard up | isolated-yard bare | isolated-yard down <dir>" >&2
  exit 2
}

# match_home reads one process a line, "<pid> <its environment>", and prints
# the pids of those whose YARDR_HOME is $1 or a path inside it (on macOS
# also as /private$1, which is what /tmp is there). The home is compared as
# a string, never made into a pattern: a pattern built from a path was once
# empty where sed refused the expression that escaped it (GNU sed reads `[.`
# in a bracket as a collating symbol), and an empty pattern matched every
# process with any YARDR_HOME (yardr-6gyb). No home, a relative one and "/"
# are refused for the same reason: nothing here may match everything.
#
# The path comes to awk in its environment: on its command line, ps would
# show it and awk would find itself.
match_home() {
  D="$1" awk '
    BEGIN {
      d = ENVIRON["D"]
      if (d !~ /^\/[^\/]/ || d ~ /\/$/) {
        print "isolated-yard: \"" d "\" is not a home to look for processes by" > "/dev/stderr"
        bad = 1
        exit 2
      }
      a = " YARDR_HOME=" d; b = " YARDR_HOME=/private" d
    }
    $1 !~ /^[0-9]+$/ { next }
    { l = $0 " " }
    index(l, a "/") || index(l, a " ") || index(l, b "/") || index(l, b " ") { print $1 }
    END { if (bad) exit 2 }'
}

# accepted_or_removed is the yard down has checked and lists by its home
# alone: the mark of `up` was read at its top, and the yard may be gone
# already when a later listing runs (removed by this down, or by another
# remover between its listings). It is the one directory home_pids takes
# without the mark in it; pids for a caller-named directory stays strict.
accepted_or_removed=

# pids of the processes whose YARDR_HOME is $1 or inside it, whatever binary
# they run and whoever started them: a server started by the installed
# yardr with its home in the yard, or one whose D/bin/yardr was rebuilt
# under it (it then runs a file that has no name any more, which lsof on
# D/bin does not find). The environment is the one the process was started
# with, which is where a server and a daemon get their home from.
#
# It fails, printing nothing, for a directory that is not an isolated yard
# and when the processes cannot be listed: its caller signals what it
# prints, so no answer must never read as "these" or as "none".
home_pids() {
  case "$1" in
  /tmp/iy. | /tmp/iy.*/*) echo "isolated-yard: $1 is not an isolated yard" >&2; return 1 ;;
  /tmp/iy.*) ;;
  *) echo "isolated-yard: $1 is not an isolated yard" >&2; return 1 ;;
  esac
  if [ "$accepted_or_removed" != "$1" ] && [ "$(cat "$1/.isolated-yard" 2>/dev/null)" != "$1" ]; then
    echo "isolated-yard: $1 was not made by isolated-yard up" >&2
    return 1
  fi
  # Use ps on both platforms: it lists the environment with each process,
  # and checking its status means a failed listing cannot look like an empty
  # machine. The same form is accepted by BSD ps and procps.
  procs=$(ps axeww -o pid= -o command=) || { echo "isolated-yard: ps failed" >&2; return 1; }
  [ -n "$procs" ] || { echo "isolated-yard: no process listed, not even this one" >&2; return 1; }
  printf '%s\n' "$procs" | match_home "$1"
}

# exec_pids prints the pids of the yard's running exec scripts, one a
# line: the handles `yardr session list --running` reports for runner
# exec, each validated before it is printed. macOS's ps shows no
# environment for the system's own binaries, so a script the exec runner
# starts (sh -c, and what it runs) is found by neither the ps leg above
# nor the lsof leg in pids; its handle names it, and the daemon, its
# parent, proves it. $1 is the yard, $2 the home pids the validation
# reaches for, one a line.
#
# It fails soft, printing nothing: where the server is dead there are no
# handles to read, where no pidfile names one there is none to ask, and
# where jq is missing there is no answer that is not a guess. The server
# is only asked when it already answers (server status): any other command
# would start one where none runs. Each pid is printed only when it is
# alive and its parent chain, three hops at most, reaches one of the home
# pids: a stale handle, whose script ended, and a recycled pid fail the
# chain. Nothing is matched by pattern, only pids from handles, verified
# by ancestry; a validated pid descends from the daemon, never from this
# script, so down signals it directly.
exec_pids() {
  d=$1 hp=$2
  [ -x "$d/e" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  # No pidfile, no server to ask: the probes below read a live server's
  # exec handles, and every server writes its pidfile before it serves.
  have_pidfile=
  for f in "$d"/*/server.pid; do
    [ -f "$f" ] || continue
    have_pidfile=1
    break
  done
  [ -n "$have_pidfile" ] || return 0
  running=$("$d/e" yardr server status --json 2>/dev/null | jq -r '.running // empty' 2>/dev/null)
  [ "$running" = "true" ] || return 0
  handles=$("$d/e" yardr session list --running --json 2>/dev/null | jq -r '.[] | select(.runner == "exec" and .handle.pid != null) | .handle.pid' 2>/dev/null) || return 0
  # shellcheck disable=SC2086
  for pid in $handles; do
    case "$pid" in '' | *[!0-9]*) continue ;; esac
    kill -0 "$pid" 2>/dev/null || continue
    p=$pid ok='' i=0
    while [ "$i" -lt 3 ]; do
      p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ') || break
      [ -n "$p" ] || break
      # shellcheck disable=SC2086
      for h in $hp; do
        if [ "$p" = "$h" ]; then ok=1; break; fi
      done
      [ -n "$ok" ] && break
      i=$((i + 1))
    done
    if [ -n "$ok" ]; then echo "$pid"; fi
  done
}

# This script and what it was called from, which are never stopped: a
# caller's command line may name the yard's home.
ancestors() {
  p=$$
  while [ "${p:-0}" -gt 1 ]; do
    echo "$p"
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
}

# pids of the yard in $1: the processes whose home is in it, those whose
# executable is a file in $1/bin (the herdr server, the stand-in agents),
# and the exec scripts its sessions run (exec_pids: macOS's ps shows no
# environment for the system's own binaries, so neither of the first two
# finds those).
# lsof goes by the file a process runs, not by its name (ps shows `claude`
# for the stand-in and for the real one alike). All three go by the
# directory, which is unique to one run. It fails where home_pids does.
pids() {
  hp=$(home_pids "$1") || return 1
  # Only the yard's own files in bin: lsof goes by the file's inode, not its
  # name, so a symlink there to a file outside it (a test's stand-in, which
  # links to the one launcher every stand-in shares) would match whatever
  # runs through that file, in any yard. What build puts here are regular
  # files, so those alone are asked for.
  bins=
  for f in "$1"/bin/*; do
    if [ -f "$f" ] && [ ! -L "$f" ]; then bins="$bins $f"; fi
  done
  if [ -n "$bins" ]; then
    # shellcheck disable=SC2086
    lp=$(lsof -t $bins 2>/dev/null) || true
  else
    lp=
  fi
  ep=$(exec_pids "$1" "$hp" 2>/dev/null) || true
  printf '%s\n%s\n%s\n' "$hp" "$lp" "$ep" | A="$(ancestors)" awk '
    BEGIN { n = split(ENVIRON["A"], a, "\n"); for (i = 1; i <= n; i++) skip[a[i]] }
    /^[0-9]+$/ && !($0 in skip) && !seen[$0]++'
}

# yard_pids is pids for down: without the list nothing more is signalled and
# the yard stays. Its callers end the script themselves (|| exit 1): under
# the `if !` of a failed up's cleanup, set -e does not.
yard_pids() {
  pids "$1" || { echo "isolated-yard: cannot tell the processes of $1; nothing more is stopped" >&2; return 1; }
}

# gone waits up to 5s for the pids to end.
gone() {
  i=0
  while [ "$i" -lt 50 ]; do
    alive=
    for p in $1; do
      kill -0 "$p" 2>/dev/null && alive=1
    done
    [ -n "$alive" ] || return 0
    i=$((i + 1))
    sleep 0.1
  done
  return 1
}

down() {
  d=$1
  case "$d" in /tmp/iy.*|/private/tmp/iy.*) ;; *) echo "isolated-yard: $d is not an isolated yard" >&2; exit 2 ;; esac
  [ -d "$d" ] || { echo "isolated-yard: no yard at $d" >&2; exit 2; }
  d=$(cd "$d" && pwd -P | sed 's|^/private/tmp/|/tmp/|')
  # Only what `up` made: it left its own path in the yard. Everything below
  # stops processes by this directory, so it must not be one of a real yard.
  if [ ! -x "$d/e" ] || [ "$(cat "$d/.isolated-yard" 2>/dev/null)" != "$d" ]; then
    echo "isolated-yard: $d was not made by isolated-yard up; nothing stopped or removed" >&2
    exit 2
  fi
  # Checked: the listings below go by the home whether or not the yard is
  # still there (another remover may take it between them). The stray check
  # after the removal is what makes this safe, and it still ends down.
  accepted_or_removed=$d
  # The exec scripts first, while the server and the daemon answer: only
  # their handles name them (see exec_pids), and the validation reaches
  # the daemon. Each validated pid names a process GROUP (setsid made the
  # group the leader's own): sh -c may have forked, and killing the leader
  # alone would orphan its children to pid 1, the bug again. Dash accepts
  # `kill -s TERM -- -pgid`; `kill -TERM -- -pgid` dies with `Illegal number`.
  # Keep the groups found before TERM for the KILL pass too: a shell can end
  # on TERM while a child in its group ignores it, which removes the handle
  # before the second pass can find that group again. A group that ended in
  # between fails silently, as the sweeps below do.
  term_execs=
  for sig in TERM KILL; do
    hp=$(home_pids "$d") || { echo "isolated-yard: cannot tell the processes of $d; nothing more is stopped" >&2; exit 1; }
    execs=$(exec_pids "$d" "$hp" 2>/dev/null) || true
    if [ "$sig" = TERM ]; then
      term_execs=$execs
    else
      # KILL groups whose leaders ended after TERM as well as current
      # sessions. The earlier handle was validated while the daemon was
      # alive; its process group can outlive that handle's leader.
      # shellcheck disable=SC2086
      for p in $term_execs; do
        case " $execs " in *" $p "*) ;; *) execs="$execs $p" ;; esac
      done
    fi
    [ -n "$execs" ] || break
    # shellcheck disable=SC2086
    for p in $execs; do
      kill -s "$sig" -- "-$p" 2>/dev/null || true
    done
    gone "$execs" || true
  done
  "$d/e" herdr server stop >/dev/null 2>&1 || true
  # The daemon, then the server it calls, by the pid each left in its home:
  # stopped in that order the daemon ends its pass cleanly. A pid is only
  # signalled when it is also one of the yard's, since a file left by a
  # process that died may name someone else's by now.
  for name in daemon.lock server.pid; do
    for f in "$d"/*/"$name"; do
      [ -f "$f" ] || continue
      pid=$(head -n 1 "$f" | awk '{print $1}' | tr -cd '0-9')
      [ -n "$pid" ] || continue
      yard=$(yard_pids "$d") || exit 1
      if printf '%s\n' "$yard" | grep -qx "$pid"; then
        kill -TERM "$pid" 2>/dev/null || true
        gone "$pid" || true
      fi
    done
  done
  signalled=
  for sig in TERM KILL; do
    left=$(yard_pids "$d") || exit 1
    [ -n "$left" ] || break
    signalled=1
    # shellcheck disable=SC2086
    kill -"$sig" $left 2>/dev/null || true
    gone "$left" || true
  done
  # A sweep that signalled nothing broke on its first look with the yard
  # already empty: no second look can find what the first did not. Where
  # signals went out the look stays, verifying the KILL pass.
  if [ -n "$signalled" ]; then
    left=$(yard_pids "$d") || exit 1
  else
    left=
  fi
  if [ -n "$left" ]; then
    if [ -d "$d" ]; then
      # shellcheck disable=SC2086
      echo "isolated-yard: still running, $d kept:" $left >&2
    else
      # Another remover took the yard between the listings: say so, not kept.
      # shellcheck disable=SC2086
      echo "isolated-yard: still running, $d already removed:" $left >&2
    fi
    for p in $left; do
      ps -o pid=,ppid=,command= -p "$p" >&2 || true
    done
    exit 1
  fi
  # A version probe (`claude --version`, what yardr doctor runs) and a
  # one-shot call (`claude -p <prompt>`, what yardr doctor --try runs)
  # start no agent, so the count leaves those starts out: what is left
  # reads as proof of how many agents ran (yardr-jd3w).
  if [ -f "$d/agents.log" ]; then
    echo "stand-in agents started: $(grep ' start ' "$d/agents.log" | grep -v -e 'args=.*"--version"' -e 'args=\["-p"' | grep -c ' start ')"
  fi
  # Go's module cache (and other tools' caches) deliberately make files and
  # directories read-only. Make the tree removable before deleting the yard.
  # Another remover may be at the tree already (the yard's watchdog and a
  # test's cleanup each run down, and a slow one meets the other here): chmod
  # then fails on a directory that is gone, or on a file that goes while it
  # walks. That is no failure of this down, and a chmod that fails for a
  # reason of its own shows in rm, which refuses what it cannot remove. The
  # check below still looks for what the yard left running (yardr-b6x7).
  chmod -R u+w "$d" || true
  rm -rf "$d"
  # With the directory gone only the home tells: anything started while the
  # yard was being stopped is found here.
  left=$(yard_pids "$d") || exit 1
  if [ -n "$left" ]; then
    echo "isolated-yard: $d is removed and these processes of it still run:" >&2
    for p in $left; do
      ps -o pid=,ppid=,command= -p "$p" >&2 || true
    done
    exit 1
  fi
  echo "stopped and removed $d"
}

# watchdog takes the yard in $1 down when the test binary that named itself to
# it is gone. A binary that is killed, or timed out, runs none of its cleanups,
# and the yardr servers of its yards stop by themselves (they look for the
# name) but the herdr server and the stand-in agents do not. So build starts
# one of these for every yard, and it does what the cleanup would: the script's
# own `down`, exec'd, so the stops, the sweep and the removal of D stay in one
# place.
#
# The name is the one D/e hands every command of the yard. A yard made by hand
# has none: its watchdog says so and ends. Otherwise it asks alive, a Go
# program that goes by the pid and the start time as the servers do (a pid
# alone is the next process's once it is reused), once a second. Only its 1
# (gone) and 2 (no usable name: a broken handoff takes the yard down, where
# the yard would leak) end the wait. Any other status is a signal or a fork
# that failed, which says nothing about the binary and must not take down a
# yard in use. The watchdog ends too when the yard does.
#
# It is a process of the yard, as the stand-ins are: down stops it with the
# rest. For that it keeps the home D/e gave it (see the scrub below), and a
# down that it execs goes through the scrub and is none of the yard's.
watchdog() {
  d=$1
  if [ -z "${YARDR_TEST_OWNER:-}" ]; then
    echo "isolated-yard: no test binary named this yard (YARDR_TEST_OWNER is not set); nothing to watch"
    return 0
  fi
  while [ -f "$d/.isolated-yard" ]; do
    status=0
    "$d/bin/alive" || status=$?
    case "$status" in
    1 | 2)
      echo "isolated-yard: the test binary that named $d is gone (alive said $status); taking the yard down"
      # Not with the stdin of the watchdog, a file of D/bin (see build): down
      # and everything it starts would hold it open, and pids would list them
      # as the yard's own.
      exec "$0" down "$d" </dev/null
      ;;
    esac
    sleep 1
  done
  echo "isolated-yard: no yard at $d any more; nothing to watch"
}

# build makes the yard's directory d: yardr from the current directory, the
# stand-in agent, the wrapper D/e.
build() {
  src=$(cd "$(dirname "$0")" && pwd)
  mkdir -p "$d/bin" "$d/c/herdr" "$d/s" "$d/y" "$d/h"
  # What down knows a yard of its own by.
  printf '%s\n' "$d" >"$d/.isolated-yard"
  go build -o "$d/bin/yardr" .
  (cd "$src/fake" && go build -o "$d/bin/claude" .)
  (cd "$src/alive" && go build -o "$d/bin/alive" .)
  # The login shell of the yard (SHELL=/bin/sh, HOME=$d/h) finds what D/e
  # finds and no more. yardr asks it for a program PATH lacks (yardr doctor,
  # and yardr up for herdr, which it then starts with that shell's PATH), and
  # the system's profile adds the machine's own directories: in a yard whose
  # PATH had no herdr, yardr up started the machine's herdr with the real
  # agent on its panes' PATH (yardr-0pk6).
  printf 'PATH=%s/bin:/usr/bin:/bin:/usr/sbin:/sbin\nexport PATH\n' "$d" >"$d/h/.profile"
  # Commits in a test depot need an author; the caller's gitconfig is not read.
  printf '[user]\n\tname = tester\n\temail = tester@example.invalid\n[init]\n\tdefaultBranch = main\n' >"$d/h/.gitconfig"
  # D/e passes __CF_USER_TEXT_ENCODING through from the caller's environment
  # (or the value macOS gives, when the caller has none): without it a newly
  # built binary's first run under `codex sandbox` stalls in dyld's
  # initializers, before main, in _CFStringGetUserDefaultEncoding -> getpwuid,
  # which the sandbox leaves waiting on the lookup (yardr-ts2c).
  cfenc=${__CF_USER_TEXT_ENCODING:-}
  if [ -z "$cfenc" ] && [ "$(uname -s)" = "Darwin" ]; then
    cfenc=$(printf '0x%X:0x0:0x0' "$(id -u)")
  fi
  if [ -n "$cfenc" ]; then
    cfarg=" __CF_USER_TEXT_ENCODING=$cfenc"
  else
    cfarg=""
  fi
  # A test binary names itself to the servers it starts (YARDR_TEST_OWNER, and
  # the tick they look for it on: storetest.NameTestBinary), and D/e hands
  # that name on to every server and daemon of the yard, so that a binary
  # killed before its cleanup leaves none behind. Only what the creating
  # environment has: a yard made by hand has no binary to be named to, and
  # its D/e stays as clean as before. The owner holds a space, hence the quotes.
  # The test binary gives the yardr it runs a long wait for a server to start
  # too (YARDR_TEST_START_WAIT): a command through D/e that finds no server
  # starts one, and the real wait, ten seconds, is not always left by the
  # machine the test runs on. Only the starter reads it.
  testarg=""
  [ -z "${YARDR_TEST_OWNER:-}" ] || testarg=" YARDR_TEST_OWNER='$YARDR_TEST_OWNER'"
  [ -z "${YARDR_TEST_HOME_CHECK:-}" ] || testarg="$testarg YARDR_TEST_HOME_CHECK='$YARDR_TEST_HOME_CHECK'"
  [ -z "${YARDR_TEST_START_WAIT:-}" ] || testarg="$testarg YARDR_TEST_START_WAIT='$YARDR_TEST_START_WAIT'"
  cat >"$d/e" <<WRAP
#!/bin/sh
exec /usr/bin/env -i HOME=$d/h PATH=$d/bin:/usr/bin:/bin:/usr/sbin:/sbin \\
  XDG_CONFIG_HOME=$d/c XDG_STATE_HOME=$d/s YARDR_HOME=$d/y \\
  TERM=xterm-256color SHELL=/bin/sh LANG=en_US.UTF-8$cfarg$testarg "\$@"
WRAP
  chmod +x "$d/e"
  # Run each file the watchdog and a down start once, before the watchdog is
  # there. The first run of a file written a moment ago, a script included,
  # waits behind the machine's other first runs (macOS checks a new
  # executable one at a time, and a busy machine's test binaries queue for
  # it by the hundred), so it can take tens of seconds. Taken here it is the
  # wait of this script's caller, which no test gives a fuse; left to the
  # watchdog it came out of the time a test gives a down (yardr-c3nm). The
  # second run of the same file costs a few milliseconds. What they print and
  # how they end say nothing: alive answers for the owner this yard was made
  # for, and yardr version needs no home.
  "$d/e" "$d/bin/alive" >/dev/null 2>&1 || true
  "$d/e" yardr version >/dev/null 2>&1 || true
  # The watchdog runs through D/e, which gives it the name (see watchdog), and
  # is started last, since it may take the yard down at once. Its output goes
  # to a file of the yard: the process outlives this script, and a pipe it held
  # would keep the caller of the script waiting. Its stdin is D/bin/alive, so
  # that down finds it: macOS's ps shows no environment for a /bin/sh, so this
  # shell cannot be found by the yard's home as the stand-ins are, but lsof
  # finds whatever has a file of D/bin open (pids), and the shell and what it
  # starts keep this one open as long as they live.
  "$d/e" "$src/$(basename "$0")" watchdog "$d" <"$d/bin/alive" >>"$d/watchdog.log" 2>&1 &
}

bare() {
  d=$(mktemp -d /tmp/iy.XXXXXX)
  trap 'rm -rf "$d"' 0
  build >&2
  trap - 0
  echo "$d"
}

up() {
  herdr=$(command -v herdr) || { echo "isolated-yard: herdr not found" >&2; exit 2; }
  command -v lsof >/dev/null || { echo "isolated-yard: lsof not found (down needs it)" >&2; exit 2; }
  d=$(mktemp -d /tmp/iy.XXXXXX)
  up_ok=0
  cleanup_failed_up() {
    status=$?
    trap - 0
    if [ "$up_ok" -ne 1 ] && [ -n "${d:-}" ]; then
      if [ -x "$d/e" ]; then
        if ! (down "$d") >&2; then
          echo "isolated-yard: cleanup failed; inspect $d" >&2
        fi
      else
        rm -rf "$d"
      fi
    fi
    exit "$status"
  }
  trap cleanup_failed_up 0
  build
  # A copy, not a link: its process then runs from D/bin, where down finds it.
  cp "$herdr" "$d/bin/herdr"
  cat >"$d/c/herdr/config.toml" <<CONF
onboarding = false
[terminal]
default_shell = "/bin/sh"
shell_mode = "non_login"
CONF

  "$d/e" herdr server >"$d/herdr.log" 2>&1 &
  i=0
  until "$d/e" herdr status server 2>/dev/null | grep -q "$d/c/herdr/herdr.sock" &&
    "$d/e" herdr agent list >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "$i" -gt 50 ]; then
      echo "isolated-yard: the herdr server did not come up, see $d/herdr.log" >&2
      exit 1
    fi
    sleep 0.2
  done

  # The proof, from inside a pane: what a new pane's shell finds as `claude`.
  pane=$("$d/e" herdr workspace create --cwd "$d/h" --label check --no-focus |
    sed -n 's/.*"root_pane":{[^}]*"pane_id":"\([^"]*\)".*/\1/p')
  found=
  if [ -n "$pane" ]; then
    # Both single-quoted strings run in the pane: their $ must reach herdr
    # literally, not expand here.
    # shellcheck disable=SC2016
    "$d/e" herdr pane run "$pane" 'echo "agent=$(command -v claude)="' >/dev/null
    # shellcheck disable=SC2016
    "$d/e" herdr pane wait-output "$pane" --regex 'agent=[^$]*=' --timeout 10000 >/dev/null 2>&1 || true
    found=$("$d/e" herdr pane read "$pane" --source recent-unwrapped --lines 20 |
      sed -n 's/.*agent=\([^$=]*\)=.*/\1/p' | tail -1)
    "$d/e" herdr pane close "$pane" >/dev/null 2>&1 || true
  fi
  agents=$("$d/e" herdr agent list)
  echo "command -v claude, in a pane: ${found:-<nothing>}"
  echo "herdr agent list: $agents"
  if [ "$found" != "$d/bin/claude" ] || ! printf '%s' "$agents" | grep -q '"agents":\[\]'; then
    echo "isolated-yard: not isolated, tearing down" >&2
    down "$d" >&2
    exit 1
  fi
  echo "isolated yard: $d   (run commands as $d/e <command>; end with: $0 down $d)"
  up_ok=1
  trap - 0
}

# A caller inside a yard (D/e isolated-yard down D) has the yard's home in
# its environment and would hand it to everything this script starts, which
# down would then take for processes of the yard. The watchdog is the one
# command meant to be a process of the yard (see there): it keeps the home,
# which is how down finds it where ps shows the environment.
if [ -n "${YARDR_HOME:-}" ] && [ "${1:-}" != watchdog ]; then
  exec env -u YARDR_HOME "$0" "$@"
fi

case "${1:-}" in
up) [ $# -eq 1 ] || usage; up ;;
bare) [ $# -eq 1 ] || usage; bare ;;
down) [ $# -eq 2 ] || usage; down "$2" ;;
# For tests and for looking before a down; neither signals anything.
pids) [ $# -eq 2 ] || usage; pids "$2" ;;
match) [ $# -eq 2 ] || usage; match_home "$2" ;;
# Started by build; a test may run one by hand.
watchdog) [ $# -eq 2 ] || usage; watchdog "$2" ;;
*) usage ;;
esac
