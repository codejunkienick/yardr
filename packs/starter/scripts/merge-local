#!/bin/sh
# merge-local: an assembly that lands a bead's branch directly on its depot's
# local base branch. Run it as the cmd of an exec group routed for the stage
# beads wait to land in (approved); limit 1 on the group makes a serial merge
# queue. See docs/line.md, section 4.
#
# It reads everything from the environment the exec runner gives it:
# YARDR_BEAD, YARDR_DEPOT, YARDR_DEPOT_PATH, YARDR_BASE, YARDR_BRANCH,
# YARDR_WORKTREE, YARDR_BIN, YARDR_TYPE, YARDR_TRAIN and YARDR_TEST, the depot's
# test command (yardr depot add --test), unset for a depot with none. Options,
# set in the group's cmd
# (cmd='YARDR_PUSH=origin /path/to/merge-local'):
#
#   YARDR_PUSH          a remote to fetch the base from before landing and to
#                       push it to after; off when empty
#   YARDR_NOTIFY        crew member mailed when that push fails (default: the
#                       yard's yardmaster setting, else yardmaster)
#   YARDR_LAND          how a bead lands: rebase (default) lands the branch's
#                       commits as they are, squash lands the bead as one
#                       commit written from it (below). A train is always
#                       landed by rebase, so that the base gets the commit of
#                       each of its children
#   YARDR_TEST_TIMEOUT  seconds the test command may run, besides what it
#                       waited for the race lock (default 1800)
#
# For each bead it brings the base up to YARDR_PUSH, fast-forward only (a
# base that diverged from the remote's branch fails the landing, never
# merged or forced here), rebases the branch onto the base if the base
# moved, lowers the file size table of a test command that carries one to the
# branch's files (lowerrows, below: an amend of the branch's head, and a hold
# when a row stands below its file), keeps the machine's disk (yardr disk
# keep), runs the depot's test
# command on exactly what will land, fast-forwards the base to the commit
# it tested, installs the landed build
# where the yard's upgrade_from setting names the depot, and advances the
# bead to merged. A design bead (YARDR_TYPE=design) whose branch changes a
# path outside docs/design/ is held before the tests run instead, naming
# every such path. A conflict goes to
# the mergers (the conflict outcome where the flow names one, else the merge
# stage), else back to the builders with the conflicting files; a red run
# back (outcome failed: new, or open for a train) with a
# note that names the commit and carries the failing tests and the end of
# the output, with the full output attached beside it, as does a branch
# that moved while the tests ran, and a test command
# that says it
# could not run (exit 2), or anything it cannot land without touching a
# dirty tree, is held. A
# run ended by a signal is run once more, and held if a
# signal ends it again. A depot with no test command lands untested, and the
# note says so. It never forces and never pushes anything but a fast-forward.
#
# With YARDR_LAND=squash the branch is made one commit after the rebase and
# before the tests, so that the commit tested is the commit landed. Its
# message is a Conventional Commit written from the bead, with the bead's id
# as a trailing reference (GitHub's (#123)) and the trailers the yard's hook
# writes for an agent's commit (squash_message, below, says how). Every type
# of bead is squashed but a train, a wagon onto its train's branch included.
# A depot with another format for it copies the script. See docs/line.md,
# section 4.
#
# The test command runs with YARDR_LANDING=1 for what lands on the depot's
# base, and without it for a wagon of a train (type wagon, landing on its
# train's branch): what a depot's command makes of that is its own (a quick
# run for the wagon, the landing run where the base moves; depot yardr's
# is the selection plus the six black-box suites). The train is
# tested and reviewed as a whole before the depot's base moves. See
# docs/line.md, "Wagons". A train's landing tells the command the train's
# children in YARDR_TEST_BEADS, sorted and joined by commas (set and empty
# when they cannot be read); any other landing unsets it, so a command
# that records which change a run tested takes the train for none of its
# own.
#
# The log says how many seconds the rebase, the tests, the push and the
# install took, in one line before the outcome's own, and the note of a
# landing its net lines beside the sha, how many the tests took and how the
# install went.
#
# Every outcome ends in an advance, a close or a hold: exiting without one
# counts as a failed session, and three of those hold the bead.
set -u
# A dir depot (YARDR_DEPOT_KIND=dir) has no branches: there is nothing here to
# land, integrate or open a pull request for. A route that hands one over is
# a mistake in the depot's flow, so refuse to run (exit 2) rather than guess.
if [ "${YARDR_DEPOT_KIND:-git}" = dir ]; then
  echo "merge-local: depot ${YARDR_DEPOT:-?} is a dir depot, with no branch to work on; route its stages to other groups" >&2
  exit 2
fi
: "${YARDR_BEAD:?not run by an exec group}" "${YARDR_DEPOT:?bead has no depot}"
: "${YARDR_DEPOT_PATH:?}" "${YARDR_BASE:?}"
Y=${YARDR_BIN:-yardr}
BEAD=$YARDR_BEAD
DEPOT=$YARDR_DEPOT
REPO=$YARDR_DEPOT_PATH
BASE=$YARDR_BASE
BR=${YARDR_BRANCH:-yard/$BEAD}
WT=${YARDR_WORKTREE:-${YARDR_HOME:-$HOME/.yardr}/worktrees/$DEPOT/$BEAD}
PUSH=${YARDR_PUSH:-}
NOTIFY=${YARDR_NOTIFY:-}
LAND=${YARDR_LAND:-rebase}
TAIL=200
# How many FAIL lines a red note keeps from the full log, ahead of the tail:
# a failure early in a long run would otherwise sit unseen above it.
FAILS=40
# The top-level directories that say nothing as the scope of a squash commit
# (squash_message): a change under internal/ alone is better named by its
# package. A depot's copy of this script changes the list.
CONTAINERS="internal contrib packs cmd pkg src lib"
echo "== $(date '+%Y-%m-%dT%H:%M:%S%z') assembly $DEPOT $BEAD ($BR onto $BASE)"

# tree prints a process and everything below it, in one order every time.
tree() {
  ps -A -o pid= -o ppid= | awk -v root="$1" '
    { parent[$1] = $2 }
    END {
      below[root] = 1
      do { more = 0; for (p in parent) if (!(p in below) && (parent[p] in below)) { below[p] = 1; more = 1 } } while (more)
      for (p in below) print p
    }' | sort -n
}
# unwatched kills the timeout watcher and its sleep, after a run and on
# every exit while one is in flight (the traps): a watcher left behind
# sleeps out its $LIMIT holding the run's inherited files, among them once
# the machine race lock (yardr-tsms). The sleep goes by the pid the watcher
# wrote, in case the watcher died without killing it, and both kills are
# silent: either may already be gone. What the file holds is signalled only
# if it is a number with a non-zero digit: kill 0 signals this script's whole
# process group, and kill reads 00 as 0 (yardr-0bd1).
unwatched() {
  [ -n "${watch:-}" ] || return 0
  kill "$watch" 2>/dev/null
  if [ -n "${napfile:-}" ] && [ -s "$napfile" ]; then
    nap=$(cat "$napfile" 2>/dev/null) || nap=
    case "$nap" in ''|*[!0-9]*) ;; *[1-9]*) kill "$nap" 2>/dev/null ;; esac
  fi
  wait "$watch" 2>/dev/null
  watch=
}
# cleanup removes the run's files, whichever of them exist: when a run is over
# and by bye.
cleanup() {
  unwatched
  [ -z "${log:-}" ] || rm -f "$log"
  [ -z "${latefile:-}" ] || rm -f "$latefile"
  [ -z "${napfile:-}" ] || rm -f "$napfile"
  [ -z "${copy:-}" ] || rm -f "$copy"
  return 0
}
# stoprun stops the command the script started, and every process below it. A
# session can be stopped while its tests are still running; ending the script
# alone would leave them running with nobody to read the result, in a worktree
# that is removed once the bead closes, and holding what they hold, the machine
# race lock among it.
stoprun() {
  [ -n "${pid:-}" ] || return 0
  seen=
  while t=$(tree "$pid") && [ "$t" != "$seen" ]; do
    # shellcheck disable=SC2086
    kill -STOP $t 2>/dev/null
    seen=$t
  done
  # shellcheck disable=SC2086
  kill -KILL ${seen:-$pid} 2>/dev/null
  wait "$pid" 2>/dev/null
  pid=
}
# bye takes away everything the script started and made, whichever of it
# exists. It is the first thing every outcome does, so that nothing is left to
# do once the session ends (the daemon stops the script as soon as it has
# reported), and the EXIT trap, for every other way out. TERM and INT are
# ignored while it runs, so that a stop of the session that comes meanwhile
# cannot leave it half done.
bye() {
  trap '' TERM INT
  unwatched
  stoprun
  cleanup
  return 0
}
# pid is only the test command this script starts, never a handle inherited
# from the exec group's environment.
unset pid
pid=
trap 'bye' EXIT
# A signal that kills the script does not run its EXIT trap in every shell
# (dash's does not), so TERM and INT exit, which does, as a shell would, 128+n.
trap 'unwatched; exit 143' TERM
trap 'unwatched; exit 130' INT

# took prints the seconds of the steps that ran, once, before the outcome's
# own line: each step adds itself to $TOOK when it is over (step, which
# leaves its seconds in $took), whether it passed or not. An outcome before
# any of them has no such line.
TOOK=
step() { took=$(($(date +%s) - $1)); TOOK="${TOOK:+$TOOK, }$2 $took s"; }
took() { [ -z "$TOOK" ] || echo "== $BEAD took: $TOOK"; TOOK=; }

# Each outcome is one advance with its note, so the move and the reason land
# together. Advancing ends this session (the daemon stops the script), so it
# is always the last thing done, and bye the first.
to() { bye; echo "== $BEAD -> $1"; printf '%s\n' "assembly: $2" | "$Y" bead advance "$BEAD" --to "$1" --note -; exit 0; }
# has_outcome <name> / has_stage <name>: whether the flow offers outcome
# <name> from here, or allows stage <name> next. Asked of prime before
# moving, so only moves the flow allows are tried: every refused move is a
# move_refused fault to the crew. Parses prime --json with sed and grep (no
# jq: merge-local runs where only sh, git and yardr are promised). The next
# block holds this stage's outcomes and stages; the flow block inside it
# holds every stage's, deeper indented, so the indents below tell them
# apart. A bead no flow governs may go to any stage.
has_outcome() {
  "$Y" prime --bead "$BEAD" --json |
    sed -n '/^  "next": {/,/^  }/p' |
    sed -n '/^    "outcomes": \[/,/^    \]/p' |
    grep -q "^        \"name\": \"$1\""
}
has_stage() {
  next=$("$Y" prime --bead "$BEAD" --json | sed -n '/^  "next": {/,/^  }/p') || return 1
  [ -n "$next" ] || return 1
  printf '%s' "$next" | grep -q '^    "flow": {' || return 0
  stages=$(printf '%s' "$next" | sed -n '/^    "stages": \[/,/^    \]/p')
  case "$stages" in *'[]'*) return 1 ;; esac
  printf '%s' "$stages" | grep -q "^      \"$1\""
}
# Back to whoever fixes the branch: the flow's "failed" outcome where it
# names one (new for a bead, open for a train, see docs/flows.md), else new.
# Only what the flow allows is tried; what is left (a flow that changed
# under us, or names neither) falls through to trying anyway.
back() {
  bye
  took
  echo "== $BEAD failed"
  if has_outcome failed; then
    printf '%s\n' "assembly: $1" | "$Y" bead "done" "$BEAD" --outcome failed --note - && exit 0
    to new "$1"
  fi
  if has_stage new; then
    to new "$1"
  fi
  printf '%s\n' "assembly: $1" | "$Y" bead "done" "$BEAD" --outcome failed --note - && exit 0
  to new "$1"
}
hold() { bye; took; echo "== hold $BEAD: $1"; "$Y" bead note "$BEAD" "assembly: $1"; "$Y" bead hold "$BEAD"; exit 0; }
# A conflict goes to the mergers: the flow's "conflict" outcome where it
# names one, else the merge stage where it allows it, else back to the
# builders. Asked before moving, so a flow with no merge raises no fault.
conflict() {
  bye
  took
  echo "== $BEAD conflicts"
  if has_outcome conflict; then
    printf '%s\n' "assembly: $1" | "$Y" bead "done" "$BEAD" --outcome conflict --note - && exit 0
  elif has_stage merge; then
    printf '%s\n' "assembly: $1" | "$Y" bead advance "$BEAD" --to merge --note - && exit 0
  fi
  back "$1"
}

# A value that is neither mode is a typo in the group's cmd: landing by the
# other mode would go unseen until the history shows it.
case $LAND in
rebase | squash) ;;
*) hold "YARDR_LAND is $LAND in this group's cmd, and a bead lands by rebase or by squash. Not landing: correct the cmd, then unhold." ;;
esac
git -C "$REPO" rev-parse --verify -q "refs/heads/$BASE" >/dev/null ||
  hold "base $BASE is not a local branch of $REPO; merge-local lands only on local branches"
git -C "$REPO" rev-parse --verify -q "refs/heads/$BR" >/dev/null || hold "branch $BR does not exist"
if [ ! -d "$WT" ]; then
  git -C "$REPO" worktree add "$WT" "$BR" || hold "cannot check out $BR at $WT"
fi
[ "$(git -C "$WT" symbolic-ref -q HEAD)" = "refs/heads/$BR" ] || hold "$WT is not on $BR"
[ -z "$(git -C "$WT" status --porcelain)" ] || hold "worktree $WT has uncommitted changes"

# Bring the base up to what it is pushed to before the branch is rebased
# onto it, so the bead is tested against and lands on the remote's commits
# and not a stale base. Only when YARDR_PUSH names the remote to fetch:
# without one there is nothing to bring up to. A fetch that fails lands on
# the base as it is, as does a remote with no branch of the base's name,
# and a base holding commits the remote lacks is simply not pushed yet:
# the push below carries them. But a base that diverged from the remote's
# branch fails the landing: joining the two is a person's, never merged or
# forced here.
if [ -n "$PUSH" ]; then
  fetcherr=$(GIT_TERMINAL_PROMPT=0 git -C "$REPO" fetch --prune --quiet "$PUSH" 2>&1) && ok=1 || ok=
  if [ -z "$ok" ]; then
    echo "== could not fetch $PUSH, landing on $BASE as it is: $fetcherr"
  else
    target=$(git -C "$REPO" rev-parse --verify -q "refs/remotes/$PUSH/$BASE")
    tip=$(git -C "$REPO" rev-parse "refs/heads/$BASE")
    if [ -z "$target" ]; then
      echo "== $PUSH has no branch $BASE: landing on the base as it is"
    elif [ "$target" = "$tip" ]; then
      echo "== $BASE is up to date with $PUSH"
    elif git -C "$REPO" merge-base --is-ancestor "$BASE" "$target"; then
      echo "== bringing $BASE up to $PUSH/$BASE at $(git -C "$REPO" rev-parse --short "$target")"
      upco=$(git -C "$REPO" worktree list --porcelain |
        awk -v b="refs/heads/$BASE" '/^worktree /{w=substr($0,10)} $0=="branch "b{print w}')
      if [ -n "$upco" ]; then
        [ -z "$(git -C "$upco" status --porcelain)" ] ||
          hold "$BASE is checked out in $upco with uncommitted changes, so it cannot be brought up to $PUSH/$BASE; not landing. Commit or clean it, then unhold."
        git -C "$upco" merge --ff-only "$target" ||
          back "$BASE could not be fast-forwarded to $PUSH/$BASE in $upco"
      else
        git -C "$REPO" fetch --quiet . "$target:$BASE" ||
          back "$BASE could not be fast-forwarded to $PUSH/$BASE (not a fast-forward?)"
      fi
    elif git -C "$REPO" merge-base --is-ancestor "$target" "$BASE"; then
      echo "== $BASE holds commits $PUSH lacks; the push below carries them"
    else
      back "base $BASE has diverged from $PUSH/$BASE: each holds commits the other lacks, so nothing was rebased or landed, and the landing cannot join them (never merged or forced here). Join them by hand, then approve the bead again."
    fi
  fi
fi

# Rebase onto the base when it moved since the branch was made.
if ! git -C "$REPO" merge-base --is-ancestor "$BASE" "$BR"; then
  t0=$(date +%s)
  git -C "$WT" rebase "$BASE" && ok=1 || ok=
  step "$t0" rebase
  if [ -z "$ok" ]; then
    files=$(git -C "$WT" diff --name-only --diff-filter=U | tr '\n' ' ')
    git -C "$WT" rebase --abort
    conflict "rebase onto $BASE conflicts in: $files
Rebase $BR onto $BASE, keep both changes' intent, run the tests again."
  fi
fi

# --- closefds: the same text in merge-local, integrate-train, pr-ci, deploy-dokku and deploy-void (a test holds them equal) ---
# closefds closes every descriptor above 2 that the subshell it is called in
# inherited, so that what the subshell starts holds none the landing did not
# give it: the daemon's leaked resolver sockets once reached the tests and
# starved them (yardr-b4ep), and an orphaned sleep once held the machine race
# lock (yardr-tsms).
#
# 3 to 9 are closed by name, which every sh reads. Above them /dev/fd is
# enumerated, so that no number is missed; the loop has no redirection, since
# the shell saves fd 2 above 10 for one and would close the save from under
# itself. When the listing itself fails, closefds refuses what it never
# saw: a run that cannot prove its descriptors closed must not start.
# But dash reads one digit as a redirection's number: there
# `exec 10>&-` is the command `10` with its output closed, and a special
# builtin that fails ends the shell. A subshell asks first. An sh that cannot
# name them leaves them open, and closefds returns 1 with their numbers in
# $leftover; given the name of what the caller is about to start, it says so
# and exits 2 instead, the code for a run that could not be made rather than
# a failed one (the assembly scripts hold on it: no builder can fix it).
# Nothing hands this script such a descriptor since the daemon marks its own
# close-on-exec before it starts one, so one that arrives comes from a source
# that has regressed, which is why it is refused and not skipped.
closefds() {
  exec 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&-
  leftover=
  highok=1
  (eval 'exec 10>&-') >/dev/null 2>&1 || highok=
  for path in /dev/fd/*; do
    if [ "$path" = "/dev/fd/*" ]; then
      # An unmatched glob expands to itself: the listing failed, so no
      # descriptor was seen, let alone closed. Refuse rather than
      # report them closed.
      leftover="$leftover ?"
      break
    fi
    fd=${path##*/}
    case "$fd" in ''|*[!0-9]*|?) continue ;; esac
    if [ -n "$highok" ]; then
      eval "exec $fd>&-"
    elif [ -e "$path" ] || [ -L "$path" ]; then
      leftover="$leftover $fd"
    fi
  done
  [ -z "$leftover" ] && return 0
  [ -n "${1:-}" ] || return 1
  echo "${0##*/}: descriptors$leftover are open above 9 and this sh cannot close them; not starting $1 with them" >&2
  exit 2
}
# --- end of closefds ---

# --- lowerrows: the same text in merge-local and integrate-train (a test holds them equal) ---
# lowerrows lowers the file size table of the depot's test command to the files
# of the branch, so that a change that shrinks or deletes a listed file never
# edits its row, and two that shrink neighbouring files cannot conflict on those
# lines. It acts where the test command is one file of the branch that carries
# such a table (a line `filesizes='`), and asks that file for it: `sh <it> sizes
# --rewrite` in the worktree. The branch's copy, since it is the branch's own
# table that is rewritten; what judges the branch stays the base's copy. A
# change to the file is made a commit of the branch: `amend` takes it into the
# branch's head, `commit` makes a commit of its own, for a head that is not the
# assembly's to rewrite. The script is the branch's own, and runs after
# closefds with no stdin; it may only leave its own table changed, since what
# it left elsewhere would land in the file that judges the next bead, which
# this run never executes. Neither branch nor base may move, the worktree stays
# on the branch, and it may not stage changes, touch another path, or change a
# line outside the table. Only the run's last bytes are kept, for the hold a
# failing run ends in. A table already right prints nothing and
# touches nothing. A rewrite that fails holds: it says a row stands below its
# file, which no landing may paper over and only a person settles.
lowerrows() {
  lr_test=${YARDR_TEST:-}
  [ -n "$lr_test" ] || return 0
  [ "$(git -C "$WT" cat-file -t "HEAD:$lr_test" 2>/dev/null)" = blob ] || return 0
  [ -f "$WT/$lr_test" ] && [ ! -L "$WT/$lr_test" ] || return 0
  grep -q "^filesizes='\$" "$WT/$lr_test" || return 0
  lr_head=$(git -C "$REPO" rev-parse "refs/heads/$BR") || hold "cannot record $BR before lowering its file size table"
  lr_base=$(git -C "$REPO" rev-parse "refs/heads/$BASE") || hold "cannot record $BASE before lowering the file size table"
  lr_log=$(mktemp "${TMPDIR:-/tmp}/lowerrows.XXXXXX") || hold "cannot make a file for the file size table rewrite's output"
  (cd "$WT" && { closefds "the file size table rewrite"; sh "$lr_test" sizes --rewrite; }) >"$lr_log" 2>&1 </dev/null && lr_ok=1 || lr_ok=
  lr_out=$(tail -c 4000 "$lr_log")
  rm -f "$lr_log"
  [ -n "$lr_ok" ] ||
    hold "the file size table in $lr_test cannot be lowered to the files of $BR, so nothing lands:
$lr_out
Correct the table, or split the file it names, then unhold."
  [ -f "$WT/$lr_test" ] && [ ! -L "$WT/$lr_test" ] ||
    hold "the file size table rewrite removed or replaced $lr_test; nothing lands"
  [ "$(git -C "$WT" symbolic-ref -q HEAD)" = "refs/heads/$BR" ] ||
    hold "the file size table rewrite moved the worktree off $BR; nothing lands"
  lr_now=$(git -C "$REPO" rev-parse "refs/heads/$BR") || hold "cannot read $BR after lowering its file size table"
  [ "$lr_now" = "$lr_head" ] || hold "the file size table rewrite moved $BR from $lr_head to $lr_now; nothing lands"
  lr_now_base=$(git -C "$REPO" rev-parse "refs/heads/$BASE") || hold "cannot read $BASE after lowering the file size table"
  [ "$lr_now_base" = "$lr_base" ] || hold "the file size table rewrite moved $BASE from $lr_base to $lr_now_base; nothing lands"
  git -C "$WT" diff --cached --quiet || hold "the file size table rewrite staged changes; nothing lands"
  lr_changes=$(git -C "$WT" status --porcelain --untracked-files=all) || hold "cannot check the worktree after lowering the file size table"
  lr_table_change=$(git -C "$WT" status --porcelain --untracked-files=all -- ":(literal)$lr_test") || hold "cannot check $lr_test after lowering the file size table"
  [ "$lr_changes" = "$lr_table_change" ] || hold "the file size table rewrite changed paths outside $lr_test; nothing lands:
$lr_changes
Correct the rewrite command, then unhold."
  lr_old=$(git -C "$WT" show "HEAD:$lr_test" | awk '$0=="filesizes=\047"&&!found{intable=1;found=1;next} intable&&$0=="\047"{intable=0;next} !intable' | git -C "$WT" hash-object --stdin) ||
    hold "cannot read the committed $lr_test to check the file size table rewrite"
  lr_new=$(awk '$0=="filesizes=\047"&&!found{intable=1;found=1;next} intable&&$0=="\047"{intable=0;next} !intable' "$WT/$lr_test" | git -C "$WT" hash-object --stdin) ||
    hold "cannot read the rewritten $lr_test to check the file size table rewrite"
  [ "$lr_old" = "$lr_new" ] || hold "the file size table rewrite changed lines outside the filesizes table in $lr_test; nothing lands"
  git -C "$WT" diff --quiet -- ":(literal)$lr_test" && return 0
  printf '%s\n' "$lr_out"
  git -C "$WT" add -- "$lr_test" || hold "cannot add the lowered file size table in $lr_test to $BR"
  if [ "$1" = amend ]; then
    git -C "$WT" commit -q --amend --no-edit --no-verify
  else
    git -C "$WT" commit -q --no-verify -m "assembly: lower filesizes rows to actual"
  fi || {
    git -C "$WT" checkout -q HEAD -- "$lr_test"
    hold "cannot commit the lowered file size table in $lr_test to $BR"
  }
  echo "== lowered the file size table in $lr_test ($1 on $BR)"
}
# --- end of lowerrows ---
# A wagon lands on its train's branch when all three hold, as the exec runner
# says them: the type, a train, and that train's branch as the base. The rows
# are lowered once for the train, not by each wagon (integrate-train), and a
# branch with no commit past the base has no head that is its own to amend.
ONTRAIN=
if [ "${YARDR_TYPE:-}" = wagon ] && [ -n "${YARDR_TRAIN:-}" ] && [ "$BASE" = "yard/$YARDR_TRAIN" ]; then
  ONTRAIN=1
elif [ "$(git -C "$REPO" rev-list --count "refs/heads/$BASE..refs/heads/$BR")" != 0 ]; then
  lowerrows amend
fi

# A design bead lands a document, never code: a design branch that changes a
# path outside docs/design/ is held here, naming every such path, before the
# tests run on what cannot land. The branch is final (rebased above), and
# what lands is the tested commit, so a branch that moves while the tests run
# is tested and checked again. The type is the exec runner's
# (YARDR_TYPE=design), the same word the wagon check below reads.
if [ "${YARDR_TYPE:-}" = design ]; then
  # No renames: a move across the boundary is a deletion and an addition,
  # and both sides are judged (a bare --name-only shows the new path alone,
  # hiding a deletion outside docs/design/).
  outside=$(git -C "$WT" diff --name-only --no-renames "$BASE"...HEAD | grep -v '^docs/design/')
  [ -z "$outside" ] ||
    hold "a design lands one document under docs/design/ and no code, but $BR also changes:
$outside
Move those paths to another bead, or drop them from the branch, then unhold."
fi

# --- squash_message: the same text in merge-local and pr-merge (a test holds them equal) ---
# squash_message <bead> <base> <head> leaves in SQ_SUBJECT and SQ_BODY the
# Conventional Commits message that lands <bead> as one commit made of what
# <head> adds to <base>, and returns 1 with ERR set when it cannot be made. It
# is called in the shell itself, never in a command substitution, so that the
# caller can hold the bead on a failure. The format is fixed here, not
# configurable: a depot that wants another copies the script.
#
#   <type>[(<scope>)][!]: <bead title> (<bead id>)
#
#   <each commit's message since <base>, oldest first, its trailers removed>
#
#   BREAKING CHANGE: <as a commit carried it, each>
#   Refs: <each issue the bead tracks, then each it relates to>
#   Yardr-Bead: <bead id>
#   Yardr-Agent: <each distinct one on the branch, first seen first>
#
# The type is the bead's kind: label, else fix for a bug and chore for the
# rest. The scope is derived from the diff, never chosen: the last element of
# the deepest directory that holds every changed path (a rename counts both),
# none when that is the root, one of $CONTAINERS, or the type itself. The bead's
# fields are read from its JSON with awk, since the scripts run where only sh,
# git and yardr are promised; Go writes < > & in a JSON string as the escapes
# u003c, u003e and u0026 after a backslash, which unjson undoes.
SQ_UNJSON='
  function unjson(s,   out, c, h) {
    out = ""
    while (s != "") {
      c = substr(s, 1, 1)
      if (c != "\\") { out = out c; s = substr(s, 2); continue }
      c = substr(s, 2, 1)
      if (c == "u") {
        h = tolower(substr(s, 3, 4)); s = substr(s, 7)
        out = out (h == "003c" ? "<" : (h == "003e" ? ">" : (h == "0026" ? "&" : " ")))
      } else if (c == "\"" || c == "\\" || c == "/") {
        out = out c; s = substr(s, 3)
      } else {
        out = out " "; s = substr(s, 3)
      }
    }
    return out
  }
'
squash_message() {
  sq_bead=$1 sq_base=$2 sq_head=$3
  ERR=
  sq_nl='
'
  sq_json=$("$Y" bead show "$sq_bead" --json) || { ERR="reading $sq_bead failed"; return 1; }
  sq_fields=$(printf '%s\n' "$sq_json" | awk "$SQ_UNJSON"'
    match($0, /^  "[a-z_]+": "/) {
      key = substr($0, 4, RLENGTH - 7)
      val = substr($0, RLENGTH + 1); sub(/",?$/, "", val)
      if (key == "type") type = val
      if (key == "title") title = unjson(val)
    }
    /^  "labels": \[$/ { inlabels = 1; next }
    inlabels && /^  \]/ { inlabels = 0 }
    inlabels && kind == "" && /^    "kind:[A-Za-z0-9-]+",?$/ { kind = $0; sub(/^    "kind:/, "", kind); sub(/",?$/, "", kind) }
    END { print type; print kind; $0 = title; $1 = $1; print $0 }
  ')
  sq_btype=$(printf '%s\n' "$sq_fields" | sed -n 1p)
  sq_kind=$(printf '%s\n' "$sq_fields" | sed -n 2p)
  sq_title=$(printf '%s\n' "$sq_fields" | sed -n 3p)
  [ -n "$sq_title" ] || { ERR="found no title in the JSON of $sq_bead"; return 1; }
  if [ -n "$sq_kind" ]; then
    sq_type=$sq_kind
  elif [ "$sq_btype" = bug ]; then
    sq_type=fix
  else
    sq_type=chore
  fi

  # Links the bead made to outside issues. A bead of another yard that it is
  # at or came from is listed too (kind at, was at, from), and is no issue.
  sq_linkjson=$("$Y" link list "$sq_bead" --json) || { ERR="listing the links of $sq_bead failed"; return 1; }
  sq_refs=$(printf '%s\n' "$sq_linkjson" | awk "$SQ_UNJSON"'
    /^  [{]/ { kind = ""; url = "" }
    match($0, /^    "[a-z_]+": "/) {
      key = substr($0, 6, RLENGTH - 9)
      val = substr($0, RLENGTH + 1); sub(/",?$/, "", val)
      if (key == "kind") kind = val
      if (key == "url") url = unjson(val)
    }
    /^  [}]/ {
      if (url != "" && kind == "tracks") tracked[++nt] = url
      if (url != "" && kind == "relates") related[++nr] = url
    }
    END {
      for (i = 1; i <= nt; i++) print "Refs: " tracked[i]
      for (i = 1; i <= nr; i++) print "Refs: " related[i]
    }
  ')

  # The commits, one record each, split by awk into the lines that stay in the
  # body (b), a BREAKING CHANGE footer (x) and a Yardr-Agent value (a). A
  # commit's trailers are its last paragraph when that holds nothing but
  # footers (Token: value, or BREAKING CHANGE: value, with indented lines
  # folded into the one before). A BREAKING CHANGE is taken from wherever it
  # stands after the subject: the yard's commit hook puts its own trailers in a
  # paragraph of their own, so a footer written above them is no part of the
  # last paragraph. It runs to the next blank line or footer, and leaves the
  # body for the footer. A commit that is itself such a squash (an earlier
  # landing of this bead that came back red) gives up its subject line, which
  # the new one replaces.
  sq_msgs=$(git -C "$REPO" log --reverse --no-show-signature --format='%B%x1e' "$sq_base..$sq_head") ||
    { ERR="reading the commits of $sq_head since $sq_base failed"; return 1; }
  sq_parts=$(printf '%s\n' "$sq_msgs" | awk -v bead="$sq_bead" '
    function bc(l) { return l ~ /^BREAKING[ -]CHANGE:([ \t]|$)/ }
    function footer(l) { return bc(l) || l ~ /^[A-Za-z0-9-]+:([ \t]|$)/ }
    function blank(l) { return l ~ /^[ \t]*$/ }
    function ours(l,   tail, n) {
      tail = " (" bead ")"
      n = length(l) - length(tail)
      return n > 0 && substr(l, n + 1) == tail && l ~ /^[a-z]+(\([^)]*\))?!?: /
    }
    function flush(   n, t, i, l, first, ok, inbc, v) {
      n = cnt
      while (n > 0 && blank(line[n])) n--
      t = n
      while (t > 1 && !blank(line[t - 1])) t--
      first = n + 1
      if (t > 1 && n >= t && footer(line[t])) {
        ok = 1
        for (i = t; i <= n; i++) if (!footer(line[i]) && line[i] !~ /^[ \t]/) ok = 0
        if (ok) first = t
      }
      inbc = 0
      for (i = 1; i <= n; i++) {
        l = line[i]
        if (i >= first) {
          if (bc(l)) { inbc = 1; print "x" l }
          else if (inbc && l ~ /^[ \t]/) print "x" l
          else {
            inbc = 0
            if (l ~ /^Yardr-Agent:/) {
              v = l; sub(/^Yardr-Agent:[ \t]*/, "", v); sub(/[ \t]+$/, "", v)
              if (v != "" && !(v in agent)) { agent[v] = 1; print "a" v }
            }
          }
          continue
        }
        if (i == 1 && ours(l)) continue
        if (i > 1 && bc(l)) { inbc = 1; print "x" l; continue }
        if (inbc) {
          if (!blank(l) && !footer(l)) { print "x" l; continue }
          inbc = 0
        }
        if (blank(l)) pending = seen
        else { if (pending) print "b"; pending = 0; print "b" l; seen = 1 }
      }
      pending = seen
      cnt = 0
    }
    {
      p = index($0, "\036")
      if (p == 0) { line[++cnt] = $0; next }
      if (p > 1) line[++cnt] = substr($0, 1, p - 1)
      flush()
    }
    END { if (cnt > 0) flush() }
  ')
  sq_body=$(printf '%s\n' "$sq_parts" | sed -n 's/^b//p')
  sq_break=$(printf '%s\n' "$sq_parts" | sed -n 's/^x//p')
  sq_agents=$(printf '%s\n' "$sq_parts" | sed -n 's/^a//p')

  # The scope, from the paths the squash changes.
  sq_paths=$(git -c core.quotePath=false -C "$REPO" diff --name-only --no-renames "$sq_base...$sq_head") ||
    { ERR="listing what $sq_head changes since $sq_base failed"; return 1; }
  sq_dir=
  if [ -n "$sq_paths" ]; then
    sq_dir=$(printf '%s\n' "$sq_paths" | awk '
      {
        n = split($0, p, "/"); d = n - 1
        if (NR == 1) { len = d; for (i = 1; i <= d; i++) c[i] = p[i] }
        else {
          if (d < len) len = d
          for (i = 1; i <= len; i++) if (c[i] != p[i]) { len = i - 1; break }
        }
      }
      END { for (i = 1; i <= len; i++) printf "%s%s", (i > 1 ? "/" : ""), c[i]; print "" }
    ')
  fi
  sq_scope=${sq_dir##*/}
  case " $CONTAINERS " in *" $sq_dir "*) sq_scope= ;; esac
  [ "$sq_scope" != "$sq_type" ] || sq_scope=

  SQ_SUBJECT=$sq_type
  [ -z "$sq_scope" ] || SQ_SUBJECT="$SQ_SUBJECT($sq_scope)"
  [ -z "$sq_break" ] || SQ_SUBJECT="$SQ_SUBJECT!"
  SQ_SUBJECT="$SQ_SUBJECT: $sq_title ($sq_bead)"

  sq_footer=$({
    [ -z "$sq_break" ] || printf '%s\n' "$sq_break"
    [ -z "$sq_refs" ] || printf '%s\n' "$sq_refs"
    printf 'Yardr-Bead: %s\n' "$sq_bead"
    [ -z "$sq_agents" ] || printf '%s\n' "$sq_agents" | sed 's/^/Yardr-Agent: /'
  })
  SQ_BODY=$sq_footer
  [ -z "$sq_body" ] || SQ_BODY="$sq_body$sq_nl$sq_nl$sq_footer"
}
# --- end of squash_message ---

# With YARDR_LAND=squash the branch becomes one commit before anything tests
# it, so that the commit the tests run on is the commit that lands. It is made
# with commit-tree and not commit, which would run the yard's commit-msg hook:
# squash_message writes the trailers itself. The branch moves only if it is
# still where it was read, and its files and index, which are the new commit's
# own tree, stay as they are. A branch with no commit past the base has
# nothing to squash.
squash() {
  sq_old=$(git -C "$REPO" rev-parse "refs/heads/$BR") || hold "cannot read $BR"
  sq_tip=$(git -C "$REPO" rev-parse "refs/heads/$BASE") || hold "cannot read $BASE"
  [ "$(git -C "$REPO" rev-list --count "$sq_tip..$sq_old")" != 0 ] || return 0
  squash_message "$BEAD" "$sq_tip" "$sq_old" || hold "cannot write the squash commit of $BEAD: $ERR"
  sq_new=$(printf '%s\n\n%s\n' "$SQ_SUBJECT" "$SQ_BODY" | git -C "$WT" commit-tree "$sq_old^{tree}" -p "$sq_tip" 2>&1)
  case $sq_new in
  '' | *[!0-9a-f]*) hold "cannot write the squash commit of $BEAD: $sq_new" ;;
  esac
  git -C "$WT" update-ref -m "assembly: squash $BEAD onto $BASE" "refs/heads/$BR" "$sq_new" "$sq_old" ||
    hold "cannot move $BR to its squash commit $sq_new"
  echo "== squashed $BEAD onto $BASE: $SQ_SUBJECT"
}
# A train lands the commits of its children, which is how the base gets one
# commit for each of them: it is never squashed.
if [ "$LAND" = squash ] && [ "${YARDR_TYPE:-}" != train ]; then
  squash
fi

# The depot's test command runs on exactly what will land, every time,
# including after a merger's rebase. The commit it runs on is recorded, and
# that commit is what lands: a commit pushed to $BR while the tests ran would
# otherwise land by the branch's name, untested.
#
# Where the command is the path of a file the base has (test=.yardr/test),
# the base's copy of that file is what runs, with sh, in the worktree: a bead
# cannot change the script that judges it, and a change to the script counts
# from the next bead on. Anything else is a command for sh -c. The note says
# which ran. With no test command the bead lands untested.
#
# Exit 1, or any other not named here, is a red run, the branch's to fix.
# Exit 2 is the command saying it could not run at all (a tool missing, a
# base it cannot find; closefds says it too, for a descriptor above 9 that
# this sh cannot close), which no builder can fix: hold. A command that exits
# 2 for a failing test (make does) is wrapped: test='make test || exit 1'.
# An exit above 128 means the run was ended by a signal from outside (143: a
# go test killed with SIGTERM after every package printed ok), which says
# nothing about the branch and which no builder can fix either. It is run
# once more, after a note with the first run's tail, so the event is on
# record however the second ends; ended by a signal twice, the bead is held.
# The kill at the deadline below is not this: it is a red run.
#
# YARDR_LANDING=1 is unset only for a wagon that lands on its train's branch,
# where the train is still tested as a whole before the depot's base moves
# (integrate-train). All three must hold (ONTRAIN, set above after the rebase):
# the type, a train, and that train's branch as the base. A wagon with no train
# lands on the depot's base, so it is a landing, as is anything run by a
# yardr that does not say the type and the train. YARDR_BASE is the train's
# branch then, which the wagon was just rebased onto: a command that tests
# what changed since the base tests what this wagon changed.
LANDING=1 RUN="the tests" TRAIN=${YARDR_TRAIN:-}
if [ -n "$ONTRAIN" ]; then
  LANDING='' RUN="the wagon's tests"
  echo "== $BEAD is a wagon of train $TRAIN: tested without YARDR_LANDING here, the landing run is the train's"
fi
TEST=${YARDR_TEST:-}
LIMIT=${YARDR_TEST_TIMEOUT:-1800}
# The beads the tests are of, which the test command is told in
# YARDR_TEST_BEADS when a train lands: set before the run, below.
BEADS=
# trainbeads prints the train's children, sorted and joined by commas, for
# YARDR_TEST_BEADS. The test command runs with YARDR_BEAD set to the train,
# and a command that records which change a run tested (depot yardr's gate
# does, so its flaky log line names the children rather than the train)
# would take the train for a change of its own, apart from the children it
# is made of. Nothing is printed when the children cannot be read (yardr
# not answering) or there are none, and the variable is then set and empty:
# it tells the test command that there is nothing to name, where an unset
# variable would send it back to
# YARDR_BEAD, the train. Parsed with sed, in the has_outcome idiom above:
# no jq, which is not promised where this script runs.
trainbeads() {
  if json=$("$Y" bead show "$BEAD" --json 2>/dev/null) &&
      kids=$(printf '%s' "$json" | sed -n '/^  "children": \[/,/^  \]/p' | sed -n -e 's/^    "\([^"]*\)",$/\1/p' -e 's/^    "\([^"]*\)"$/\1/p'); then
    printf '%s\n' "$kids" | LC_ALL=C sort -u | paste -sd, -
  else
    echo "== could not read the children of $BEAD (yardr must answer); the tests are told no beads" >&2
  fi
}
# gradle_fails prints the failing tests a Gradle run left in the worktree:
# each testcase carrying a failure or an error in a TEST-*.xml file under
# $WT, named classname.name. Gradle's own output says only how many failed,
# so without this a red note names no test. One line per test, in the
# files' sorted order; nothing when there are no such files.
gradle_fails() {
  [ -n "${WT:-}" ] && [ -d "$WT" ] || return 0
  find "$WT" -name 'TEST-*.xml' -type f 2>/dev/null | LC_ALL=C sort | while IFS= read -r xf; do
    awk '
      function attr(line, key,   m) {
        if (match(line, "[ \t]" key "=\"[^\"]*\"")) {
          m = substr(line, RSTART + length(key) + 3, RLENGTH - length(key) - 4)
          return m
        }
        return ""
      }
      /<testcase[^>]*>/ {
        cls = attr($0, "classname"); nm = attr($0, "name")
        failed = ($0 ~ /<failure[ >\/]/ || $0 ~ /<error[ >\/]/) ? 1 : 0
        if ($0 ~ /<\/testcase>/) {
          if (failed) {
            if (cls != "" && nm != "") print cls "." nm
            else if (nm != "") print nm
          }
          cls = ""; nm = ""; failed = 0; incase = 0
        } else if ($0 ~ /\/>[ \t]*$/) {
          cls = ""; nm = ""; failed = 0; incase = 0
        } else {
          incase = 1
        }
        next
      }
      incase && (/<failure[ >\/]/ || /<error[ >\/]/) { failed = 1 }
      incase && /<\/testcase>/ {
        if (failed) {
          if (cls != "" && nm != "") print cls "." nm
          else if (nm != "") print nm
        }
        cls = ""; nm = ""; failed = 0; incase = 0
      }
    ' "$xf" 2>/dev/null
  done
}
# runtest runs the test command in the worktree and leaves its exit status in
# $rc, the last $TAIL lines of its output in $out, how many lines there were
# in $lines, the failing tests in $fails (the full log's FAIL and XCTest
# lines, and the Gradle names, deduped, at most $FAILS, only when the log
# runs past the tail), and $late set when it ran past $LIMIT seconds besides
# what it waited for the race lock. It adds the seconds the run took to $secs,
# which a second run after a signal adds to. A red run's full log stays in
# $log until the outcome attaches it to the bead; a green run's is removed
# at once, as ever.
#
# The bound is sh's own, since timeout(1) is not everywhere (macOS has none):
# the command runs in the background beside a watcher that sleeps $LIMIT
# seconds, credits the race-lock seconds the run waited, and then kills it.
# Killing sh alone would leave go test and its
# test binaries running, and a shell without a terminal gives a background
# job no process group of its own to signal, so the watcher finds the
# command's processes by their parents (tree), stops them all first so that
# none starts another while it looks, and kills them once two looks agree.
runtest() {
  # Each file of the run is made by a mktemp of its own, never named from
  # another's: mktemp creates a file exclusively, but a local user of a shared
  # TMPDIR who sees the log's name can plant a symlink or a script at that
  # name with .late or .sh added before it is used (yardr-gb50).
  log=$(mktemp "${TMPDIR:-/tmp}/merge-local.XXXXXX") || hold "cannot make a file for the tests' output"
  napfile=$(mktemp "${TMPDIR:-/tmp}/merge-local.XXXXXX") || hold "cannot make a file for the timeout watcher"
  latefile=$(mktemp "${TMPDIR:-/tmp}/merge-local.XXXXXX") || hold "cannot make a file for the timeout watcher"
  copy=
  if [ "$WHAT" = "the base's copy of $TEST" ]; then
    copy=$(mktemp "${TMPDIR:-/tmp}/merge-local.XXXXXX") || hold "cannot make a file for the copy of $TEST"
    git -C "$REPO" show "refs/heads/$BASE:$TEST" >"$copy" || hold "cannot read $TEST from $BASE"
  fi
  t0=$(date +%s)
  # The beads the tests are of, for YARDR_TEST_BEADS below: a train lands
  # as its children, which are read once here (runtest runs twice only
  # after a signal kill, and the lookup is idempotent); anything else is
  # told no beads.
  if [ "${YARDR_TYPE:-}" = train ]; then
    BEADS=$(trainbeads)
  else
    BEADS=
  fi
  (
    cd "$WT" || exit 2
    if [ -n "$LANDING" ]; then export YARDR_LANDING=1; else unset YARDR_LANDING; fi
    if [ "${YARDR_TYPE:-}" = train ]; then export YARDR_TEST_BEADS="$BEADS"; else unset YARDR_TEST_BEADS; fi
    # The test command starts with no descriptor above 2 that the landing
    # did not give it, or does not start.
    closefds "$RUN"
    if [ -n "$copy" ]; then exec sh "$copy"; else exec sh -c "$TEST"; fi
  ) >"$log" 2>&1 </dev/null &
  pid=$!
  (
    nap=
    trap 'kill "$nap" 2>/dev/null; exit 0' TERM
    # The sleep holds none of the run's inherited files. What this sh cannot
    # close stays open here, and the test command's start above refuses it,
    # so a watcher left holding one belongs to a run that is already over.
    closefds
    # The deadline counts only time not spent waiting for the race lock: a
    # landing late in the queue would otherwise be killed with every test
    # green. Sleep $LIMIT, then sleep again for the waited seconds not yet
    # credited, repeating until no new wait is found; only then mark late
    # and kill. The gate prints a start marker while it waits and a final
    # `test: waited N s` line when it acquires the lock; account for the
    # elapsed active wait too, since it may outlast LIMIT.
    credited=0
    parred=0
    wait_for=$LIMIT
    while :; do
      sleep "$wait_for" &
      nap=$!
      echo "$nap" >"$napfile"
      wait "$nap"
      waited=$(awk -v now="$(date +%s)" '
        /^test: race lock wait started at [0-9]+$/ { active=$NF; next }
        /^test: waited [0-9]+ s for the race lock$/ { total+=$3; active="" }
        END { if (active != "") total += now-active; print total+0 }
      ' "$log" 2>/dev/null)
      case "$waited" in ''|*[!0-9]*) waited=0 ;; esac
      # A race leg the gate throttled with -p runs slower by design, so the
      # deadline follows it: cores over -p, floored at 1, times LIMIT. The
      # gate says the throttle in one line; without it the factor is 1 and
      # nothing changes. Normalize the decimal timeout before shell
      # arithmetic, which otherwise treats a value such as 08 as octal.
      # A nonnumeric LIMIT holds the factor at 1 so the fuse remains active.
      throttle=$(awk '
        /^test: go test -p=[0-9]+ [(]load [0-9.]+ on [0-9]+ cores[)]$/ {
          p = $4; sub(/^-p=/, "", p); c = $8
          if (p > 0 && c > 0) { f = int(c / p); if (f < 1) f = 1; fact = f; par = p; cores = c }
        }
        END { if (fact != "") print fact":"par":"cores }
      ' "$log" 2>/dev/null)
      fact=${throttle%%:*}
      parcores=${throttle#*:}
      par=${parcores%%:*}
      cores=${parcores#*:}
      case "$fact" in ''|*[!0-9]*) fact=1 ;; esac
      case "$LIMIT" in
        ''|*[!0-9]*) fact=1; limitnum=0 ;;
        *)
          limitnum=$LIMIT
          while [ "${limitnum#0}" != "$limitnum" ]; do limitnum=${limitnum#0}; done
          [ -n "$limitnum" ] || limitnum=0
          ;;
      esac
      extension=0
      [ "$fact" -gt 1 ] && extension=$(((fact - 1) * limitnum))
      extra=$((waited - credited + extension - parred))
      if [ "$extra" -le 0 ]; then
        break
      fi
      # Past the break the deadline grew: say so once, in the run's log.
      if [ "$parred" -eq 0 ] && [ "$fact" -gt 1 ]; then
        echo "deadline $LIMIT s x $fact for -p=$par on $cores cores" >>"$log"
      fi
      credited=$waited
      parred=$extension
      wait_for=$extra
    done
    echo late >"$latefile"
    seen=
    while t=$(tree "$pid") && [ "$t" != "$seen" ]; do
      # shellcheck disable=SC2086
      kill -STOP $t 2>/dev/null
      seen=$t
    done
    # Whatever ps said, the command itself goes.
    # shellcheck disable=SC2086
    kill -KILL ${seen:-$pid} 2>/dev/null
  ) &
  watch=$!
  # The watcher records its sleep before it waits on it; hold until it has
  # (a bounded wait), so the cleanup never kills a watcher whose sleep is
  # not yet known.
  i=0
  while [ ! -s "$napfile" ] && [ "$i" -lt 100 ]; do sleep 0.05; i=$((i + 1)); done
  wait "$pid" && rc=0 || rc=$?
  pid=
  step "$t0" "$RUN"
  secs=$((secs + took))
  unwatched
  # A command that passed as its deadline came has passed. The marker is
  # empty until the watcher writes to it, so the deadline came if it holds
  # something.
  late=
  if [ -s "$latefile" ] && [ "$rc" != 0 ]; then
    late=1
    echo "merge-local: the tests ran past their deadline of ${LIMIT}s and were killed" >>"$log"
  fi
  lines=$(wc -l <"$log" | tr -d ' ')
  out=$(tail -n "$TAIL" "$log")
  # The failing tests a red note keeps ahead of the tail: the full log's
  # FAIL lines (go test's, a shell gate's FAIL:, XCTest's), and the Gradle
  # names from the worktree, deduped and capped, so a failure above the tail
  # still shows. Only when the log runs past the tail; a short run's tail
  # already holds the log's names.
  fails=
  if [ "$lines" -gt "$TAIL" ]; then
    fails=$( { grep -E -e '--- FAIL' -e '^FAIL' -e "Test Case '-\[.*\]' failed" "$log" 2>/dev/null; gradle_fails; } | awk '!seen[$0]++' | head -n "$FAILS" || true)
  fi
  if [ "$rc" = 0 ]; then
    cleanup
    log=
  else
    # A red run's full log stays standing until the outcome attaches it to
    # the bead (attach_log); the run's other files go as ever.
    kept=$log
    log=
    cleanup
    log=$kept
  fi
  latefile=
  napfile=
  copy=
  printf '%s\n' "$out"
}
# What a note says of a run's output: all of it, or its end.
shown() {
  if [ "$lines" -gt "$TAIL" ]; then echo "the last $TAIL of $lines lines of output"; else echo "its output"; fi
}
# attach_log carries a red run's full log to the bead, so the names and the
# tail in the outcome's note stay readable after the worktree and the run's
# files are gone. It runs before the outcome moves the bead (bye takes the
# log with it), and never fails the outcome: a refused attach leaves a note
# saying the output was too large to keep instead.
attach_log() {
  [ -n "${log:-}" ] && [ -f "$log" ] || return 0
  "$Y" bead note "$BEAD" "assembly: full gate output of the failed run on $BR at $at ($WHAT, exit $rc)" --file "$log" >/dev/null 2>&1 && return 0
  "$Y" bead note "$BEAD" "assembly: the full gate output of the failed run on $BR at $at ($WHAT, exit $rc) was too large to keep" >/dev/null 2>&1 || true
  return 0
}
secs=0
tested=$(git -C "$REPO" rev-parse "refs/heads/$BR") || hold "cannot read $BR"
at=$(git -C "$REPO" rev-parse --short "$tested")
if [ -z "$TEST" ]; then
  WHAT=
  echo "== depot $DEPOT has no test command: landing $BEAD untested"
else
  if [ "$(git -C "$REPO" cat-file -t "refs/heads/$BASE:$TEST" 2>/dev/null)" = blob ]; then
    WHAT="the base's copy of $TEST"
  else
    WHAT="the command $TEST"
  fi
  echo "== $RUN on $BR at $at: $WHAT${LANDING:+, with YARDR_LANDING=1}"
  # The yard keeps its disk before the tests run: under disk_keep_gb free
  # it rotates GOCACHE and clears stale go-tmp (yardr disk keep), so the
  # landing's build has room. Best effort: a keep that fails is in the
  # log, and the landing goes on to the tests, which fail loudly
  # themselves when the disk is what ails them. Where the installed yardr
  # predates the command the step is skipped, as the install below is: it
  # activates once the new yardr is in. Cobra may return success and print
  # the root help for an unknown subcommand with --help, so require
  # keep's own usage.
  if "$Y" disk keep --help 2>&1 | grep -q '^  yardr disk keep \[flags\]$'; then
    keepout=$("$Y" disk keep 2>&1) && ok=1 || ok=
    if [ -n "$keepout" ]; then
      printf '%s\n' "$keepout"
    fi
    if [ -z "$ok" ]; then
      echo "== $BEAD disk keep failed, landing on to the tests"
    fi
  fi
  runtest
  if [ "$rc" -gt 128 ] && [ -z "$late" ]; then
    first="$RUN on $BR at $at ($WHAT) were ended by signal $((rc - 128)) (exit $rc), not by a failing test"
    echo "== $first; running them once more"
    "$Y" bead note "$BEAD" "assembly: $first; running them once more on the same commit. Of the first run, $(shown):
${fails:+$fails
}$out" || echo "== could not note the first run on $BEAD"
    out1=$out fails1=$fails
    # The first run's log is noted; only the second run's decides the
    # outcome, so only it is attached. Gone before the second run starts, it
    # cannot leak whatever the second does.
    rm -f "$log"
    log=
    runtest
    [ "$rc" -le 128 ] || [ -n "$late" ] || { attach_log; hold "$first, and again by signal $((rc - 128)) (exit $rc) when run once more. Nothing landed, and the branch is not at fault: find what sends the signal, then unhold to test it again.
First run:
${fails1:+$fails1
}$out1
Second run:
${fails:+$fails
}$out"; }
  fi
  if [ -n "$late" ]; then
    attach_log
    back "$RUN failed on $BR at $at rebased onto $BASE ($WHAT): they ran past their deadline of ${LIMIT}s and were killed; $(shown):
${fails:+$fails
}$out"
  fi
  case $rc in
  0) ;;
  2) attach_log; hold "$RUN could not run on $BR at $at ($WHAT said so: exit 2); $(shown):
${fails:+$fails
}$out" ;;
  *) attach_log; back "$RUN failed on $BR at $at rebased onto $BASE ($WHAT, exit $rc); $(shown):
${fails:+$fails
}$out" ;;
  esac
fi

# A branch that moved during the tests holds commits they did not see: back
# to whoever fixes the branch, as a red run, to be approved and tested again
# as it is now.
now=$(git -C "$REPO" rev-parse "refs/heads/$BR")
[ "$now" = "$tested" ] ||
  back "$BR moved while the tests ran: tested $at, now $(git -C "$REPO" rev-parse --short "$now"). Nothing landed; the tests must run on what is there now."

# Land the tested commit, by its sha, fast-forward only. Where the base is
# checked out, only when that checkout is clean (a dirty one is someone's
# work in progress: hold rather than touch it); otherwise move the ref
# without touching any tree. The base as it was is where the landing note's
# net lines are counted from.
before=$(git -C "$REPO" rev-parse "refs/heads/$BASE")
co=$(git -C "$REPO" worktree list --porcelain |
  awk -v b="refs/heads/$BASE" '/^worktree /{w=substr($0,10)} $0=="branch "b{print w}')
if [ -n "$co" ]; then
  [ -z "$(git -C "$co" status --porcelain)" ] ||
    hold "$BASE is checked out in $co with uncommitted changes; not landing. Commit or clean it, then unhold."
  git -C "$co" merge --ff-only "$tested" || back "fast-forward of $BASE in $co to $tested failed"
else
  git -C "$REPO" fetch . "$tested:$BASE" || back "fast-forward of $BASE to $tested failed (not a fast-forward?)"
fi
sha=$(git -C "$REPO" rev-parse --short "$BASE")
echo "== landed $BEAD on $BASE at $sha"

# The net lines the landing added, split into code and *_test.go, counted
# with git diff --numstat from the base as it was to the commit that landed:
# visible on every landing, with no limit and no refusal. A *_test.go path
# counts to test, every other path to code, and a binary row (a dash for a
# count) to neither.
grow=$(git -C "$REPO" diff --numstat "$before..$tested" | awk '$1 != "-" { net = $1 - $2; if ($0 ~ /_test\.go"?$/) test += net; else code += net } END { printf "%+d code, %+d test", code, test }')

# Publish, before advancing: advancing ends this session and the daemon stops
# the script with it. Never forced. A failed push (offline, the remote moved)
# leaves the bead merged locally; the next landing's push carries it.
msg="merged $sha ($grow)"
if [ -z "$TEST" ]; then
  msg="$msg, untested: no test command on the depot"
elif [ -z "$LANDING" ]; then
  msg="$msg on $BASE, tested with $WHAT without YARDR_LANDING in $secs s; the landing run and the review are train $TRAIN's"
else
  msg="$msg, tested with $WHAT"
fi
push_failed=
if [ -n "$PUSH" ]; then
  t0=$(date +%s)
  git -C "$REPO" push "$PUSH" "$BASE" 2>&1 && ok=1 || ok=
  step "$t0" push
  if [ -n "$ok" ]; then
    echo "== pushed $BASE to $PUSH"
  else
    push_failed="; pushing $BASE to $PUSH failed (not forced)"
    # Asked only now: a yard names its yardmaster as it likes, and most
    # landings mail nobody.
    [ -n "$NOTIFY" ] || NOTIFY=$("$Y" settings get yardmaster 2>/dev/null) || NOTIFY=yardmaster
    "$Y" mail "$NOTIFY" "assembly: merged $BEAD at $sha but pushing $BASE to $PUSH failed. Not forced; check whether $PUSH/$BASE moved." ||
      echo "== could not mail $NOTIFY"
  fi
fi
# Install the landed build, after the push and before the advance: when the
# yard's upgrade_from setting names this bead's depot, run the installed
# yardr's upgrade and fold its one-line summary into the landing note and its
# seconds into the log line (docs/upgrade.md, "The assembly step"). A wagon
# lands on its train's branch, not the depot's base, while the install builds
# the depot's checkout, which holds none of it, so a wagon never installs.
# The step activates only once the operator has installed this script, once
# by hand, and sets upgrade_from; the install then keeps the copy current
# (docs/upgrade.md, "The scripts"). Without either, and on every other
# depot, the landing runs exactly as before. Like a failed push, a failed
# install where the yard still answers never sends the bead back: the code
# has landed, so the bead still merges, with a note saying what failed and
# what was put back, and the command's own telling carries it. Where the
# installed yardr predates the command, the note says to install the new
# yardr once by hand first instead. When the install leaves the yard dead,
# the advance below fails as the calls before it did, and the bead fails its
# session toward a hold, with the marker and this log as the record.
upgrade_note=
if [ -n "$LANDING" ]; then
  from=$("$Y" settings get upgrade_from 2>/dev/null) || from=
  if [ "$from" = "$DEPOT" ]; then
    # Cobra may return success and print the root help for an unknown
    # subcommand when it receives --help, so require upgrade's own usage.
    upgrade_help=$("$Y" upgrade --help 2>&1) || upgrade_help=
    if ! printf '%s\n' "$upgrade_help" | grep -q '^  yardr upgrade \[flags\]$'; then
      upgrade_note="; install skipped: the installed yardr knows no upgrade (install the new yardr once by hand first)"
      echo "== $BEAD install skipped: the installed yardr knows no upgrade"
    else
      t0=$(date +%s)
      upgrade_out=$("$Y" upgrade 2>&1) && ok=1 || ok=
      step "$t0" upgrade
      printf '%s\n' "$upgrade_out"
      if [ -n "$ok" ]; then
        upgrade_note="; install ok in $took s"
        # The scripts the install refreshed from the landed tree, by name: the
        # fix this landing carried to one of them is live from the next one.
        refreshed=$(printf '%s\n' "$upgrade_out" | sed -n 's/^scripts  *\(.*\) refreshed$/\1/p' | tail -n 1)
        [ -z "$refreshed" ] || upgrade_note="$upgrade_note (scripts refreshed: $refreshed)"
      else
        line=$(printf '%s\n' "$upgrade_out" | grep '^yardr: ' | tail -n 1)
        line=${line#yardr: }
        [ -n "$line" ] || line=$(printf '%s\n' "$upgrade_out" | tail -n 1)
        [ -n "$line" ] || line="it failed without saying why"
        upgrade_note="; install failed: $line"
      fi
    fi
  fi
fi
if [ -n "$TEST" ] && [ -n "$LANDING" ]; then
  msg="$msg$push_failed in $secs s"
elif [ -n "$push_failed" ]; then
  msg="$msg$push_failed"
fi
msg="$msg$upgrade_note"
bye
took

# A flow with a merged terminal stage closes the bead on entering it; without
# one, close it directly. Entering merged ends this session, and the yard may
# kill the advance client after the move committed: a bead already closed is
# where the advance would have taken it, so it gets no close (merge-pr's
# report says the same; only sh, git and yardr are promised here, so no jq).
# A show that fails (the yard is dead) falls back to the close, as before.
if ! printf '%s\n' "$msg" | "$Y" bead advance "$BEAD" --to merged --note -; then
  if "$Y" bead show "$BEAD" --json 2>/dev/null | grep -q '^  "status": "closed"'; then
    echo "== $BEAD is closed already"
  else
    "$Y" bead close "$BEAD" --reason "$msg"
  fi
fi
echo "== $msg"
