#!/bin/sh
# yardr's tests: the depot's test command (yardr depot add yardr . --test
# .yardr/test). A builder and a reviewer run it in their worktree, as it is
# on their branch, before they hand on; the assembly runs main's copy of it
# on what lands (contrib/assembly/merge-local), so an edit to it on a bead's
# branch judges nothing until it has landed.
#
# Run plainly it tests little: everything still has to be
# formatted, shellchecked, vetted, built and staticchecked, but only the
# packages the branch touched, and the packages that import those, are
# tested. A change in a package nearly everything imports (store, config)
# makes it nearly the whole suite, which is right; a leaf package takes
# seconds of tests. It is also what a wagon of a train passes to land on
# its train's branch. A plain run is never raced: the race detector runs at
# landing only (docs/testing.md R4), so a plain run tests with a plain go
# test. A plain run that covers the whole suite (70% of its packages or
# more, wholeplain below) still queues on the race lock, as class 1 behind
# landings (see lockplain below): two whole-suite runs at once overload the
# machine. A smaller selection takes no ticket, whatever it changed.
#
# With YARDR_LANDING=1, as the assembly sets it for what lands on main, a
# landing that changes code runs the plain selection plus always the six
# black-box suites (docs/testing.md R5), vet for linux too, and, when the
# plain selection holds store, dispatch, bdp or web, those suites again
# over the socket, beside the first run of the tests. That first run is the
# one under -race, and the only one in the race lock. The whole suite still
# runs when there is no comparable base, when nothing changed, and when
# what changed cannot be selected: go.mod or go.sum, a deletion, or a
# file no row knows, each of which the selection itself would test as
# everything. When the branch changed nothing that is compiled, every
# program and every test binary is built from the source the base
# passed with, only a test that opens a changed file by path can
# differ, and the run is the plain selection alone, without -race: it
# has no race to look for. It still queues when its selection covers the
# whole suite, as any plain run does (lockplain); otherwise it waits for
# no race lock. The whole suite otherwise runs only when
# the yard is quiet (docs/testing.md R6) and where someone runs
# YARDR_LANDING=1 on the base itself. The first line says which run it
# is, and why. A loaded machine runs the race leg with go test's -p set from
# the load (gatepar), not on every core; a CI runner, which runs nothing beside
# its job, runs go's default and says so (legflag).
#
# What the branch touched is what changed since the base: YARDR_BASE (an
# agent's session and the assembly have it: main, or the train's branch for
# a wagon), else origin/main. The first line of the output says which. A
# reviewer that committed sets it to the commit the last test line names, so
# the selection is its own commits alone (the review stages say so). Where
# the named base is ahead of HEAD, a plain run compares from the branch
# point instead, and says so loudly; a landing is the whole suite.
#
# Two budgets (docs/testing.md R1 and R2): a package's tests finish in 60 s
# under -race, and a test sleeps no more than 500 ms at a site. Each has its
# allow-list below, naming why each entry is over and which bead brings it
# under; the fix beads delete the rows. A race leg runs a package it ran
# over budget and not allow-listed again by itself: over budget alone on a
# quiet machine fails the run; on a loaded machine (loaded as the re-runs
# started or as the last ended) it passes with an R1 line naming both times and
# the load, unless YARDR_R1_STRICT is set by the quiet run. Then over budget
# alone on a loaded machine is refused the verdict (exit 3), in an R1 line
# naming both times and the load, and on a quiet one fails as before; its
# re-runs go one after another, each judged by the load around itself, where
# a landing's go up to three at a time under one load pair, so that a time
# over budget is not made by the re-runs' own contention;
# the run fails when a test file sleeps over budget at a site that is not.
# A run without -race judges no package's time, R1 being defined under -race:
# a plain run, which is never raced, judges none, and the landing and the quiet
# run do. R2 reads the tree, not the run, and is judged as before.
#
# A wait in a contrib suite (a fuse against a hang, the deadline of a poll) is
# written for an idle box, and the race leg sizes it to the machine it runs on
# (sizewaits): go test -race gets YARDR_TEST_LOAD, the machine's load over its
# cores from 1 to 4, which internal/testload multiplies each wait by, and a line
# names it. So no wait is raised by hand after it flakes in a landing. The
# re-run of an over-budget package alone gets no factor, so that a slow path of
# the product still shows there, and a plain run gets none: a test reads the
# variable, so go's test cache would keep a result for each value the load
# made, and a builder's rerun of the same tree would miss it. That is the
# variable's factor alone: internal/testload also reads the machine as each
# wait is armed and takes the larger of the two. That reading is no variable,
# so it splits no cache, and a leg that meets a load it did not start in, the
# re-run alone and a plain run all size their waits to the load they meet.
#
# conformance/bdp's test runs conformance/bdp/probe-core-test.sh, which builds
# yardr and seeds a yard eight times over and needs node, so it runs only where
# the run sets YARDR_CONFORMANCE, which it does when a path under conformance/
# changed (the reads table's row for conformance/ selects the package). Every
# other run of the package skips, plain go test ./... among them (CI's plain
# jobs have no node), and so does a whole suite chosen for another reason
# (go.mod, a file no row knows, no base, the quiet run), since none of those
# changed anything there. Where a change does set it and a tool is missing, the
# test fails and says how to get the tool, as the shellchecked step does.
#
# After each step a line says how many seconds it took (test: go vet ./...
# took 14 s), so a landing's log shows where a run's time went. The run ends
# with its test line, the line a note carries whole: `test: sh .yardr/test @
# <sha>: pass, <n> packages ok, 0 failed, 112 s, waited 40 s` -- the result,
# the packages go test printed `ok` and `FAIL` for across the run's legs, the
# wall seconds, and the seconds queued on the machine-wide race lock
# (docs/testing.md R4 names the fields). A plan (YARDR_TEST_PLAN=1) and a run
# that could not start (exit 2) print none.
#
# A red run ends with the lines that say what failed, since a note carries
# only the end of the output. Exit 2 is "could not run", which the assembly
# holds a bead on instead of sending it back: the base is not there, or the
# disk is too full to start (diskfloor below).
#
# YARDR_TEST_PLAN=1 says what the run would test and stops: no gofmt, vet,
# build or test. The test of this script runs it so (yardtest_test.go).
#
# `sh .yardr/test sizes [path]` is no run of the gate: it reports how much room
# each Go file has under its ceiling (the filesizes table below), in the seconds
# a find and a wc take, and exits 0 whatever it finds. A listed file has none, a
# file with no row fails at 1000 lines, so run it before planning a change to a
# file near or over 1000 lines, not after the gate has failed it. With a path it
# reports that file alone.
#
# `sh .yardr/test sizes --rewrite` is what the landing runs on what it lands: it
# lowers the table in this file to the tree it is run in (filesizerewrite), so
# that no change edits the row of a file it shrinks. It is no gate run either.
set -e
filesizewarnings_done=
# The settings of the yard's server and daemon are not the tests': a server
# one of them starts would listen on this yard's webhook address, and a
# daemon on its profiling socket (config.ServerSettings).
unset YARDR_HOOK_ADDR YARDR_EVENT_RETENTION YARDR_HOOK_PAYLOAD_RETENTION YARDR_PPROF YARDR_DAEMON_PPROF
# The load factor is the race leg's to give (sizewaits). One the run was started
# with, by a hand or by the race leg of a test that runs this script, would size
# the plain run and the re-run of a package alone as well.
unset YARDR_TEST_LOAD
# Every go command of the run, and the go the tests start (the black-box
# suites build the binary), builds with -trimpath. Without it a package's
# directory goes into the ID of each action that builds it, and so into the ID
# of every test binary that imports it: the same source in another worktree
# gets other IDs, and the build and test results in the user's Go cache, one
# for every worktree on the machine, serve no worktree but the one that made
# them (yardr-nam1: none of 28 packages was cached from a second worktree, 19
# with the flag; the nine left read repo files by path, which go hashes with
# the file's path and mtime). It is GOFLAGS, once, and not a flag on each
# call: again knows a step by its words (go test -race) and runs a failed or
# over-budget package again from them, and a flag in the words would not reach
# the go the tests start. The caller's GOFLAGS stay, the flag after them; one
# that only go env -w set is shadowed, the variable winning, and reading its
# file would be one more go call. With the flag a trace, and runtime.Caller,
# name a file by import path, so a test finds a repo file from its package
# directory.
GOFLAGS="${GOFLAGS:+$GOFLAGS }-trimpath"
export GOFLAGS
# The run's own test line is printed by finish, on exit, from these: the wall
# seconds since started, the race-lock seconds the legs waited, and the
# packages go test printed `ok` and `FAIL` for. tmp is pick's, below.
started=$(date +%s)
waited_total=0 pkgs_ok=0 pkgs_failed=0
tmp=
beside=
beside_counts=
finish() {
  rc=$?
  # A signal the traps below caught: the run did not pass, whatever the
  # last command's status was when it arrived.
  [ -n "$killed" ] && rc=$killed
  trap - EXIT
  [ -z "$tmp" ] || [ ! -d "$tmp" ] || rm -rf "$tmp"
  [ -z "$beside" ] || [ ! -e "$beside" ] || rm -f "$beside"
  [ -z "$beside_counts" ] || [ ! -e "$beside_counts" ] || rm -f "$beside_counts"
  # No line for a plan, which stops before the steps, or for exit 2, which is
  # "could not run": the base is not there, and nothing ran.
  if [ -z "$YARDR_TEST_PLAN" ] && [ "$rc" != 2 ]; then
    summary "$rc"
  fi
  exit "$rc"
}
trap 'finish' EXIT
# A gate ended by a signal prints no `pass`: its test line agrees with the
# non-zero status it ends with. TERM and INT set killed to the signal's
# conventional exit status and restore that signal's default so it cannot
# re-enter. INT briefly ignores TERM while stopping the process group, because
# that cleanup signal also targets this shell; then it restores TERM's default
# and exits 130. The group kill's `|| true` is load-bearing under `set -e`:
# where the signal already reached the group, there is nothing left to kill.
killed=
onterm() {
  killed=143
  trap - TERM
  kill -TERM 0 2>/dev/null || true
  exit 143
}
onint() {
  killed=130
  trap - INT
  trap '' TERM
  kill -TERM 0 2>/dev/null || true
  trap - TERM
  exit 130
}
trap 'onterm' TERM
trap 'onint' INT
# took says how long a step ($2) took, in whole seconds since $1 (date +%s).
took() { echo "test: $2 took $(($(date +%s) - $1)) s"; }
# listed says how long choosing the packages took, where they were chosen
# (pick).
listing=
listed() { [ -z "$listing" ] || echo "$listing"; }
# again runs a go step, and once more when it failed because a file of Go's
# build cache was gone. Seen on 7 Oct 2026 at 00:46 (yardr-n1v5's landing)
# and at about 00:50 (yardr-k4ky's review): go vet said "could not import ...
# (open ~/Library/Caches/go-build/...-d: no such file or directory)" of
# packages the branch had not touched, and the same commit passed when run
# again. The cache is the user's, one for every run on the machine (GOCACHE
# is not set per run), and several run at once; which of them, or what else,
# took the file is not known. That says nothing about the branch, so it must
# not send the bead back. A second failure stands, whatever it says.
# A go test step that fails runs its failed packages (the FAIL<tab>pkg lines)
# once more, alone, with the same flags; when they pass, the step passes, and
# one line starting with `test: flaky:` names the tests that failed the first
# time (the --- FAIL: names, with their packages; with none, a timeout names
# the running tests it caught, a fatal error or panic the test it crashed
# in, and anything else the package alone). A package that fails twice
# fails the step as before. The plain run does the same: a builder should not
# be sent chasing a flake either. Seen on 14 Oct 2026 (yardr-2nss's landing):
# three packages that fail only under load sent an approved change back to
# new, for a session, two reviews and a 15-minute landing run, all for load.
# A failure whose log reports `WARNING: DATA RACE` is never run again, for
# the cache either: a race fails one time in two and still accuses the
# branch, so retrying would land it half the time. The step fails instead,
# naming the packages whose output reported the race. An ordinary flake can
# still pass on its second run; the flaky line in the output makes that
# visible, and one line per flaky line is appended to yardr-flaky.log in
# the git common dir, which the repo owns and every worktree shares. The
# rerun's output replaces the first run's, so that line also keeps what the
# first run printed for each failed test (flakyfails), behind a separator:
# a failure with no FAIL line keeps its timeout's panic and running tests,
# its fatal error's or panic's line and the dump's head, else its first
# output lines. The line ends with the load the gate measured as it wrote
# it (machineload), so a reader can tell a flake on a quiet machine from
# one under load. The printed line stays short because whoever ran the gate
# watched the failure, and the log line is what is left of it for whoever
# did not (a landing, a session that has ended). A test the log already names
# is filed as a backlog P3 `Flaky: <Test> (<pkg>)` carrying its lines. A test and its
# subtests fail together and share one bead, so where an open bead stands for
# the test (its own, its top-level test's, or another subtest's of that
# test), that bead is noted with the new log line and nothing is filed. Where
# the yardr CLI is not there (CI, a fork) the log line stays the record.
# AGENTS.md says what a hand reading old lines files.
# A failure the disk caused is no flake (yardr-4pwj). On 9 Nov 2026 the data
# volume filled, and every run that linked a binary failed "link: mapping
# output file failed: no space left on device": two tests failed that way
# before any of their own logic, passed on rerun once space came back, and
# were logged as flaky and one filed, which sent a builder to look in a test
# for what the machine did. A failed test whose block in the first run's
# output (its `--- FAIL:` line and the lines under it) holds `no space left
# on device`, or a failed package with no named test whose output holds it,
# is named as the disk's in one line beside the rerun's result, with the df
# of the volume the run writes to (where the gate keeps its own files), and
# is left out of the flaky line, the log and the filing. A test
# that failed for another reason in the same run is a flake as before, and a
# run with nothing else prints no flaky line. The failed packages still run
# again: a rerun whose output holds the text fails the step as a package that
# fails twice does, with a line for the disk's state, and nothing is run a
# third time or logged.
# Do not retry more than once: a cache retry consumes the one retry, and a
# second failure stands.
# A step's output is kept in its log and printed. Outside the race worker it
# streams through tee; inside it is captured in a file first. A test can leave
# an orphan holding stdout open, so the worker must not use a pipe for go
# commands: that would keep tee and the lock holder alive after go test exits.
# Then the line that says how long the step took, both runs of it where there
# were two. A step that failed for good is followed by what of its output says so.
runlogged() {
  runlog=$1
  shift
  if [ -n "$race_leg_child" ]; then
    runstatus=0
    "$@" >"$runlog" 2>&1 || runstatus=$?
    cat "$runlog"
    return "$runstatus"
  fi
  { runstatus=0; "$@" 2>&1 || runstatus=$?; echo "$runstatus" >"$runlog.rc"; } | tee "$runlog"
  runstatus=$(cat "$runlog.rc")
  return "$runstatus"
}
# racelocked runs a leg under the machine-wide race lock: one go test -race
# run at a time on this machine, and no whole-suite plain run beside it.
# Five worktrees' race suites side by
# side on ten cores slow each other past Go's per-package timeout, while one
# alone takes a third of the time, so the queue costs less than the
# contention (yardr-cecb). The lock is an flock on one file under the yard's
# home, which every worktree's gate shares, so a gate that dies releases it;
# never a file the gate removes again, which a dead gate leaves behind
# blocking every landing. The file is the yard's, 0600 in a 0700 home, as
# its other files are. macOS has no flock binary; perl's flock is the
# same call.
# In front of the flock is a ticket queue, so waiters take the lock in
# arrival order, landings first: each writes a ticket with its class, a
# timestamp, its pid, start time, bead and worktree, and only the first live
# ticket may take the flock. The class is the ticket name's first part, 0 for
# a landing's race leg and 1 for any other lock-taking step, including an
# unraced landing's plain selection. The caller clears YARDR_LANDING for that
# step, so the names sort landings first and each class in arrival order. A
# landing is what frees the next bead of a chain, and there are only as many
# as there are approved beads, so landings cannot starve the other runs.
# Nothing pre-empts the
# holder: a landing waits for the run that holds the lock. A dead waiter's
# ticket is skipped and removed; a ticket is dead only when the OS says its
# pid is gone, and a ps that was killed or could not run says nothing, so kill
# is asked too (yardr-5766). Waiting gates print their place and the
# holder at once and then each minute. The holder records itself beside the
# lock for that line.
# sh .yardr/test --race-queue shows the holder and waiters, each with its
# class, in the order they take the lock, without creating a ticket or
# leaving a lock held.
# The perl holds the lock itself while the worker it forked runs
# the race leg under it: the worker closes the lock's fd before it execs,
# so nothing the leg starts can hold the lock past the leg, however long it
# outlives it (an orphaned sleep once did: yardr-tsms). It runs in its own
# process group, so TERM and INT stop its children too. One hold covers the
# leg, its failed-test retry and the package-budget re-measurement, which
# share it through YARDR_RACE_HELD instead of waiting on it again. The perl
# exits with the worker's status, 128+n for a worker ended by signal n, and
# forwards TERM and INT to it, so a killed gate still stops the leg. It
# waits without a limit, and says so, with the seconds, when it waited.
# A run nested in another's race leg shares its hold instead of waiting on
# it (YARDR_RACE_HELD, which the run's own tests set too): without that the
# tests, which run this script, would wait on the run they are in.
racelocked() {
  lock=$HOME/.yardr/race.lock
  if [ "$1" = "--show-queue" ]; then
    mode=--show-queue
  else
    mode=
    status=$1
    shift
    mkdir -p "$HOME/.yardr"
    chmod 700 "$HOME/.yardr"
  fi
  # The perl holds $vars the shell must not expand: single quotes intended.
  # shellcheck disable=SC2016
  race_perl='use POSIX qw(:sys_wait_h setpgid);
use Fcntl qw(:DEFAULT :flock);
use Errno qw(EINTR EWOULDBLOCK EAGAIN);
use Time::HiRes qw(gettimeofday);
$lock = shift;
$yard = $lock;
$yard =~ s{/[^/]+$}{};
$yard = "." if $yard eq $lock;
$qdir = "$yard/race.queue";
$holder = "$yard/race.holder";
# How a queued pid is told live: /proc where the kernel has it, else ps
# where ps can stat this process, else a bare kill, as the yard liveness
# checks do where the OS tells no start time.
$have_proc = (-d "/proc" && -f "/proc/self/stat") ? 1 : 0;
$have_ps = 0;
if (!$have_proc) {
  my $probe = qx(ps -p $$ -o lstart= 2>/dev/null);
  $have_ps = 1 if defined($probe) && $probe =~ /\S/;
}
# proc_stat is what the OS says of a pid: its state letter, its start
# time (compared for equality only) and whether a process is there at
# all. An undef start means the OS told none: the pid stands alone.
sub proc_stat {
  my ($pid) = @_;
  return (undef, undef, 0) unless defined($pid) && $pid =~ /^\d+$/ && $pid > 0;
  if ($have_proc) {
    open(my $fh, "<", "/proc/$pid/stat") or return (undef, undef, 0);
    my $line = <$fh>;
    close($fh);
    if (defined($line) && $line =~ /\)\s+(.*)$/) {
      my @f = split(/\s+/, $1);
      return (substr($f[0], 0, 1), $f[19], 1) if @f >= 20;
    }
    return (undef, undef, 1);
  }
  if ($have_ps) {
    my $out = qx(ps -p $pid -o state= -o lstart= 2>/dev/null);
    # Only a ps that ended well and printed a line has said anything of the
    # pid. One that printed nothing may be saying the pid is gone (it exits 1
    # then), but a ps that was killed or could not run prints nothing too, and
    # the TERM that stops a waiter reaches the ps it has in flight beside it:
    # a waiter that took that silence for a death removed the live holder
    # ticket as it died (yardr-5766). Whatever ps leaves unanswered, kill is
    # asked, and only both saying gone makes the pid gone.
    if ($? != 0 || !defined($out) || $out !~ /\S/) {
      return (undef, undef, kill(0, $pid) ? 1 : 0);
    }
    if ($out =~ /^\s*(\S+)\s+(.+?)\s*$/) {
      return (substr($1, 0, 1), $2, 1);
    }
    return (undef, undef, 1);
  }
  return (undef, undef, kill(0, $pid) ? 1 : 0);
}
# alive tells a queued pid from a later process that reused it: the pid
# is there, not a zombie, and where both start times are known they
# match. A recorded start of "" is from where the OS told none.
sub alive {
  my ($pid, $recorded) = @_;
  my ($state, $start, $exists) = proc_stat($pid);
  return 0 unless $exists;
  return 0 if defined($state) && $state eq "Z";
  if (defined($recorded) && $recorded ne "" && defined($start) && $start ne "") {
    return 0 unless $start eq $recorded;
  }
  return 1;
}
sub my_start {
  my (undef, $start, undef) = proc_stat($$);
  return defined($start) ? $start : "";
}
# read_kv parses a ticket or holder file, key=value a line; undef when
# the file is gone.
sub read_kv {
  my ($path) = @_;
  open(my $fh, "<", $path) or return undef;
  my %kv;
  while (my $line = <$fh>) {
    chomp($line);
    $kv{$1} = $2 if $line =~ /^([a-z]+)=(.*)$/;
  }
  close($fh);
  return \%kv;
}
# ids is the pid and recorded start a queue entry names: from its
# content, or the filename pid where the content is not readable.
sub ids {
  my ($name) = @_;
  my $kv = read_kv("$qdir/$name");
  my ($fpid) = $name =~ /^(?:[01]-)?\d+-(\d+)$/;
  my $pid = (defined($kv) && defined($kv->{pid}) && $kv->{pid} =~ /^\d+$/) ? $kv->{pid} : $fpid;
  my $start = (defined($kv) && defined($kv->{start})) ? $kv->{start} : "";
  return ($pid, $start, $kv);
}
# qkey is what queue entries sort by: the name, which starts with the class
# (0 for a landing, 1 for any other run), then zero-padded seconds and
# nanoseconds, then the pid, so landings sort first and each class in arrival
# order. A ticket made by an older copy of this script has no class: it is a
# plain run, in its place by the time it came.
sub qkey {
  my ($name) = @_;
  return $name =~ /^[01]-/ ? $name : "1-$name";
}
# queued names the queue entries in the order they take the lock. A ticket an
# older copy of this script made is queued among the plain runs, so its run
# keeps its turn and stays in the view, and the ticket is removed once dead.
# That older copy lists no classed ticket, so between the two kinds the flock
# alone decides who takes the lock.
sub queued {
  opendir(my $dh, $qdir) or return ();
  my @names = sort { qkey($a) cmp qkey($b) } grep(/^(?:[01]-)?\d+-\d+$/, readdir($dh));
  closedir($dh);
  return @names;
}
# front is the first live ticket, dead ones ahead of it removed; ()
# when the queue is empty.
sub front {
  for my $n (queued()) {
    my ($pid, $start, $kv) = ids($n);
    return ($n, $kv) if alive($pid, $start);
    unlink("$qdir/$n");
  }
  return ();
}
# fullclean removes every dead ticket but $mine, which needs no check.
sub fullclean {
  my ($mine) = @_;
  for my $n (queued()) {
    next if defined($mine) && $n eq $mine;
    my ($pid, $start) = ids($n);
    unlink("$qdir/$n") unless alive($pid, $start);
  }
}
# is_holder tells whether a ticket, by its pid and recorded start, is the
# one the holder file names ($hkv, undef where there is none): the holder
# keeps its ticket until it exits. Where either start is unknown the pid
# stands alone.
sub is_holder {
  my ($hkv, $pid, $start) = @_;
  return 0 unless defined($hkv) && defined($hkv->{pid}) && defined($pid) && $pid eq $hkv->{pid};
  return !defined($hkv->{start}) || $hkv->{start} eq "" || !defined($start) || $start eq "" || $start eq $hkv->{start};
}
# place counts the runs that take the lock before $mine, plus one: the live
# tickets ahead of it in the queue, and the holder, whose ticket sorts behind
# every landing when the holder is not one, so queued runs count it in their
# place whatever their class. Dead tickets found ahead of $mine are removed.
sub place {
  my ($mine) = @_;
  my $hkv = read_kv($holder);
  my $n = 1;
  my $ahead = 1;
  for my $t (queued()) {
    if ($t eq $mine) { $ahead = 0; next }
