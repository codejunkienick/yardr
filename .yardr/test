# filesizebudget fails the run when a non-test Go file stands over its
# ceiling in the table above, or when one with no row stands over 1000
# lines. A ceiling standing above its file, or a row naming a file that is
# gone, only warns, whatever the run: the change leaves the row, and the
# landing lowers or deletes it (filesizerewrite). At landing
# (YARDR_LANDING set) it is a plain note instead, since the landing
# judges with the base's copy of this script, whose higher rows remain
# while the branch's copy, lowered before the run, holds the right ones.
# The measure is wc -l, the count the table was seeded
# with. The allow-list goes by file, as the reads table does: awk takes no
# newline in -v. It says how many listed files the tree holds, so the
# re-measure can count the oversize debt. Before formatting, vet, build and
# test, the run warns of each file with fewer than 50 lines of room under its
# ceiling (filesizeview), so the file is known before a change takes it over.
filesizebudget() {
  t0=$(date +%s)
  st=0
  allow=$(mktemp)
  printf '%s\n' "$filesizes" >"$allow"
  out=$(sizelines | awk -v landing="$YARDR_LANDING" '
    FILENAME == ARGV[1] {
      if ($0 ~ /^[^ ]+ [0-9]+ /) {
        f = $0; sub(/ .*/, "", f)
        m = $0; sub(/^[^ ]+ /, "", m); sub(/ .*/, "", m)
        ceil[f] = m + 0
      }
      next
    }
    $2 == "total" || NF < 2 { next }
    {
      n = $1 + 0
      f = $0; sub(/^ *[0-9]+ +/, "", f); sub(/^\.\//, "", f)
      if (f in ceil) {
        seen[f]++
        if (n > ceil[f]) {
          printf "test: %s has %d lines, over its %d-line ceiling: split it along a concept, one concept per file (a second same-stem file such as routing2.go is not a split); the ceiling only falls\n", f, n, ceil[f]
          bad++
        } else if (ceil[f] > n) {
          if (landing != "") {
            printf "test: %s has %d lines, under its %d-line ceiling: landing keeps the higher base row (the branch lowers it)\n", f, n, ceil[f]
          } else {
            printf "test: warning: %s has %d lines, under its %d-line ceiling: the landing lowers the row\n", f, n, ceil[f]
          }
          nseen++
        } else nseen++
        next
      }
      if (n > 1000) {
        printf "test: %s has %d lines, over 1000 with no filesizes row: split it along a concept, one concept per file (a second same-stem file such as routing2.go is not a split)\n", f, n
        bad++
      }
    }
    END {
      for (f in ceil) {
        if (!(f in seen)) {
          if (landing != "") {
            printf "test: filesizes row %s names a file that is gone: landing keeps the base row (the branch deletes it)\n", f
          } else {
            printf "test: warning: filesizes row %s names a file that is gone: the landing deletes the row\n", f
          }
        }
      }
      if (bad > 0) exit 1
      if (nseen > 0) printf "test: %d files over 1000 lines allow-listed\n", nseen
    }' "$allow" -) || st=$?
  rm -f "$allow"
  took "$t0" "file size budgets"
  # A direct budget check still warns, while a gate run's earlier call makes
  # this a no-op there. A warning fails nothing, not even by failing itself.
  filesizewarnings
  if [ -n "$out" ]; then printf '%s\n' "$out"; fi
  [ "$st" = 0 ] || exit 1
}
# sizelines prints the line count and path of each non-test Go file, as wc -l
# does, in path order. It is the one list of files that the file size budget
# judges and `sh .yardr/test sizes` reports, so the two cannot disagree about
# which files there are, and the order makes what they print read the same on
# every machine.
sizelines() {
  find . -name '*.go' -not -name '*_test.go' -not -path './.git/*' -exec wc -l {} + 2>/dev/null | LC_ALL=C sort -k 2
}
# filesizeview prints what the file size table says of the tree that the
# budget's verdict does not: how much room each file has under its ceiling,
# the ceiling being 1000 for a file with no row. Its mode ($1) is report, the
# lines of `sh .yardr/test sizes [path]`, or warn, which the gate prints
# before its verdict. A report has a line for each listed file (its lines, its
# ceiling and the room between them, negative for a file over its ceiling), for
# each row whose file is gone, and for each file with no row once fewer than 50
# lines of room are left; with a path ($2), the line for that file alone, small
# or not. Warnings include listed files and files with no row, using the row's
# ceiling or 1000 respectively. A file over its ceiling is already named by
# the budget's verdict. The view judges nothing and passes whatever it finds.
filesizeview() {
  table=$(mktemp)
  printf '%s\n' "$filesizes" >"$table"
  sizelines | awk -v mode="$1" -v want="$2" '
    BEGIN { limit = 1000; near = 50 }
    FILENAME == ARGV[1] {
      if ($0 ~ /^[^ ]+ [0-9]+ /) {
        f = $0; sub(/ .*/, "", f)
        m = $0; sub(/^[^ ]+ /, "", m); sub(/ .*/, "", m)
        ceil[f] = m + 0
        order[++rows] = f
      }
      next
    }
    $2 == "total" || NF < 2 { next }
    {
      n = $1 + 0
      f = $0; sub(/^ *[0-9]+ +/, "", f); sub(/^\.\//, "", f)
      seen[f] = 1
      listed = (f in ceil)
      c = listed ? ceil[f] : limit
      if (mode == "warn") {
        room = c - n
        if (room >= 0 && room < near) {
          printf "test: warning: %s has %d lines, %d under its %d-line ceiling: split it along a concept before it grows past %d\n", f, n, room, c, c
        }
        next
      }
      if (want == "" ? (listed || n > c - near) : (f == want)) {
        printf "test: sizes: %s %d/%d (%+d)%s\n", f, n, c, c - n, (listed ? "" : " no row, fails over " limit)
        shown++
      }
    }
    END {
      if (mode == "warn") exit 0
      for (i = 1; i <= rows; i++) {
        f = order[i]
        if ((f in seen) || (want != "" && f != want)) continue
        printf "test: sizes: %s gone, its row says %d: the landing deletes the row\n", f, ceil[f]
        shown++
      }
      if (want != "" && !shown) printf "test: sizes: %s is no non-test Go file here\n", want
    }' "$table" - || true
  rm -f "$table"
}
# filesizerewrite lowers the table above to the tree it is run in, in the file
# of this script itself: `sh .yardr/test sizes --rewrite`, which the landing
# runs on what it lands (contrib/assembly/merge-local, and integrate-train for a
# train). A change that shrinks a listed file then never edits its row, and two
# that shrink the same file, or neighbours, cannot collide on those lines. A row
# becomes its file's lines when they are fewer; a row whose file is gone, or is
# at most 1000 lines and so needs none, is deleted; a row is never raised and
# none is added. A file over its row is growth, or a row cut by hand below its
# file, which no rewrite settles: the run fails naming the file and changes
# nothing, as the budget fails it. A line says each change; a table already at
# the tree prints nothing, and its file is not touched. The measure is the
# budget's own (sizelines).
filesizerewrite() {
  if [ ! -f "$0" ] || ! grep -q "^filesizes='\$" "$0"; then
    echo "test: sizes: $0 is no file with a filesizes table to rewrite"
    return 1
  fi
  measure=$(mktemp)
  rewritten=$(mktemp)
  sizelines >"$measure"
  rwst=0
  awk -v out="$rewritten" '
    FILENAME == ARGV[1] {
      if ($2 == "total" || NF < 2) next
      f = $0; sub(/^ *[0-9]+ +/, "", f); sub(/^\.\//, "", f)
      lines[f] = $1 + 0
      next
    }
    $0 == "filesizes=\047" { intable = 1; found = 1; print > out; next }
    intable && $0 == "\047" { intable = 0; print > out; next }
    intable && /^[^ ]+ [0-9]+ / {
      f = $0; sub(/ .*/, "", f)
      m = $0; sub(/^[^ ]+ /, "", m); sub(/ .*/, "", m); m += 0
      why = $0; sub(/^[^ ]+ [0-9]+ /, "", why)
      if (!(f in lines)) {
        change[++changes] = sprintf("test: sizes: deleted the row of %s: the file is gone", f)
      } else if (lines[f] > m) {
        printf "test: sizes: %s has %d lines, over its %d-line ceiling: split it along a concept, a row is never raised\n", f, lines[f], m
        bad++
        print > out
      } else if (lines[f] <= 1000) {
        change[++changes] = sprintf("test: sizes: deleted the row of %s: its %d lines need none", f, lines[f])
      } else if (lines[f] < m) {
        change[++changes] = sprintf("test: sizes: lowered the row of %s from %d to %d", f, m, lines[f])
        print f " " lines[f] " " why > out
      } else print > out
      next
    }
    { print > out }
    END {
      if (!found) { print "test: sizes: no filesizes table in the script"; exit 1 }
      if (bad > 0) exit 1
      for (i = 1; i <= changes; i++) print change[i]
    }' "$measure" "$0" || rwst=$?
  if [ "$rwst" = 0 ] && ! cmp -s "$rewritten" "$0"; then
    cat "$rewritten" >"$0" || { echo "test: sizes: cannot write $0"; rwst=1; }
  fi
  rm -f "$measure" "$rewritten"
  return "$rwst"
}
# filesizewarnings reports near-ceiling files once per gate run. The gate calls
# it before formatting, vet, build and tests, and filesizebudget calls it too so
# its focused check keeps the same output without duplicating warnings in a full
# run.
filesizewarnings() {
  if [ -n "$filesizewarnings_done" ]; then return 0; fi
  filesizewarnings_done=1
  filesizeview warn || true
}
# nomarkers fails the run when a tracked file carries the redaction marker
# (REDACTED in capitals inside square brackets): tool output redacts a word
# that way, and the redaction was copied into files as text (yardr-k3a0).
# Every run judges the whole tree, whatever was selected, so a docs-only or
# packs-only landing cannot carry it past the gate. The marker is built from
# two parts, so this step does not carry the literal it looks for. The match
# is case-sensitive: the product's own lowercase markers stay green.
nomarkers() {
  t0=$(date +%s)
  marker='[''REDACTED]'
  out=
  if hits=$(git grep -n -F "$marker" 2>/dev/null); then
    out=$hits
  else
    grep_status=$?
    if [ "$grep_status" -ne 1 ]; then
      echo "test: redaction marker scan failed (git grep exited $grep_status)"
      exit "$grep_status"
    fi
  fi
  took "$t0" "redaction marker scan"
  if [ -n "$out" ]; then
    printf '%s\n' "$out" | sed 's/^/test: /'
    echo "test: a tracked file carries the redaction marker, which is tool output, not text to keep (yardr-k3a0)"
    exit 1
  fi
}
formatted() {
  t0=$(date +%s)
  out=$(gofmt -l .)
  took "$t0" "gofmt -l ."
  if [ -n "$out" ]; then
    echo "gofmt needed on:"
    echo "$out"
    exit 1
  fi
}
# The shellchecked step fails the run when shellcheck finds anything in the
# depot's shell: this script, the installer and every contrib and conformance
# script with a shell shebang, found by that line, so a new script is covered
# without touching the step. It is the file set and the command of CI's scan
# job (.github/workflows/ci.yml), which fails on a finding after the landing,
# so the landing must fail on it first. Every run judges the whole tree, like
# gofmt and vet, whatever was selected: a selection by changed file has the
# base edge cases the header names. The shebang gives shellcheck the dialect,
# so install.sh is held to POSIX sh. Where shellcheck is not installed the
# run fails and says how to get it: skipping would reopen the hole this step
# closes (the rule addblackbox follows). This comment does not open with the
# function's name, as its neighbours' do: shellcheck reads a comment that
# begins with its own name as a directive, and fails this very script on it.
shellchecked() {
  t0=$(date +%s)
  if ! command -v shellcheck >/dev/null 2>&1; then
    echo "test: shellcheck is not installed, and CI runs it: brew install shellcheck, sudo apt-get install -y shellcheck, or see https://github.com/koalaman/shellcheck#installing"
    exit 1
  fi
  st=0
  grep -rlE '^#!(/bin/|/usr/bin/env )(sh|bash)' .yardr/test install.sh contrib conformance | xargs shellcheck || st=$?
  took "$t0" "shellcheck"
  if [ "$st" != 0 ]; then
    echo "test: shellcheck reported findings, which CI's scan job fails on as well"
    exit 1
  fi
}
# The staticchecked step fails the run when staticcheck finds anything in the
# module's Go: the command of CI's scan job (.github/workflows/ci.yml) at the
# version it pins, over the whole tree. CI fails on a finding after the
# landing, so the landing must fail on it first: two findings in a landed
# test file (yardr-k5r6) and a pull request's unused helper both got through
# the gate for want of this step. Every run judges the whole tree, like gofmt
# and vet, whatever was selected, and a deliberate exception is a
# //lint:ignore with its reason, as CI has it. It runs through again, as vet
# and build do, so that a file of the shared build cache lost under it is run
# again, and a failure ends with the lines that say what it found (failed
# keeps each file.go:line:col: line). The tool is fetched by go run into the
# module cache the build uses: where it cannot be, with no network and
# nothing cached, go's own error fails the run, since skipping would reopen
# the hole this step closes (the rule shellchecked and addblackbox follow).
# The version is CI's and moves with it: a test holds the two to one command.
staticchecked() {
  again go run honnef.co/go/tools/cmd/staticcheck@v0.8.2 ./...
}
# The six black-box suites (docs/testing.md R5): each builds the tree's
# binary and drives it without importing the changed packages, so the
# plain selection alone misses them. A landing that changes code runs
# them always, beside what the selection picked. Their directories, in
# the order the log names them.
blackbox='contrib/assembly contrib/peer contrib/deploy contrib/server-yard contrib/isolated-yard contrib/release'
# addblackbox adds the six suites' packages to the selection in $tmp/run:
# the import path of each directory, from the list pick already made, so
# the run holds each once however the selection named it. A suite that
# is no package here fails the run: silently skipping it would reopen
# the hole the six close. The directories are cut at pick's toplevel.
addblackbox() {
  for d in $blackbox; do
    p=$(awk -F'|' -v root="$toplevel" -v want="$d" '
      {
        dir = substr($2, length(root) + 2); if (dir == "") dir = "."
        if (dir == want) { p = $1; sub(/ \[.*/, "", p); sub(/\.test$/, "", p); sub(/_test$/, "", p); print p; exit }
      }' "$tmp/pkgs")
    if [ -z "$p" ]; then
      echo "test: the black-box suite $d is no package here" >&2
      exit 1
    fi
    grep -qx "$p" "$tmp/run" || echo "$p" >>"$tmp/run"
  done
}
# whole is a landing's run, after a line that says why it is that ($1),
# and the end of the run. Without $2 it is the whole suite; with $2
# "selection" it is the plain selection plus the six black-box suites.
# The store, dispatch, bdp and web suites run again over the socket
# beside the first run only when the plain selection holds one of them
# (yardr-022s): over-the-socket behaviour cannot differ from what the
# base passed except through a package none of the four imports, which
# is the same reach the plain run already accepts everywhere else.
# Without a comparable base there is no selection, so they run whole,
# as they always have; otherwise one line says whether the leg runs
# and why. The gate is judged on the plain selection, before the six
# are added: none of the six is one of the four, so adding them first
# would not change it, and judging it first keeps the line honest.
whole() {
  if [ "$2" = selection ]; then
    echo "test: YARDR_LANDING is set, and $1: the selection plus the six black-box suites (contrib/assembly, contrib/peer, contrib/deploy, contrib/server-yard, contrib/isolated-yard, contrib/release)"
  else
    echo "test: YARDR_LANDING is set, and $1: the whole suite"
  fi
  leg=beside
  if [ -n "$from" ]; then
    # The gate: the plain selection, which a landing over an embedded or
    # embedded file already picked on its way here. An unrecognized file
    # makes the plain run test every package, as do go.mod and go.sum, so the
    # socket suites are in that selection too.
    [ -n "$tmp" ] || pick
    holds=""
    if [ -s "$tmp/stray" ]; then
      holds="store dispatch bdp web"
    else
      for s in store dispatch bdp web; do
        if grep -q "/internal/$s\$" "$tmp/run"; then
          holds="$holds${holds:+ }$s"
        fi
      done
    fi
    if [ -n "$holds" ]; then
      echo "test: the plain selection holds $holds: running the socket suites beside the first run"
    else
      echo "test: the plain selection holds neither store, dispatch, bdp nor web: skipping the socket suites"
      leg=skip
    fi
  else
    echo "test: no comparable base: running the socket suites beside the first run"
  fi
  if [ "$2" = selection ] && [ -n "$from" ]; then
    addblackbox
  fi
  if [ -n "$YARDR_TEST_PLAN" ]; then
    if [ "$2" = selection ] && [ -n "$tmp" ]; then
      listed
      [ ! -s "$tmp/rows" ] || cat "$tmp/rows"
      pkgs=$(sort -u "$tmp/run")
      # shellcheck disable=SC2086
      echo "test: testing, with -race, what changed, what imports it and what reads it:" $pkgs
    fi
    exit 0
  fi
  filesizewarnings
  listed
  # gofmt first: CI fails on it, so this must too. shellcheck next, for the
  # same reason.
  formatted
  shellchecked
  again go vet ./...
  # CI runs on linux and this on a Mac: a darwin-only syscall.Getsid got
  # through (yardr-mrdt). vet cross-compiles, so no linux machine is needed.
  again env GOOS=linux go vet ./...
  sleepbudget
  filesizebudget
  nomarkers
  # The slowest of the whole-tree checks, so after the ones that fail in
  # seconds.
  staticchecked
  if [ "$2" = selection ] && [ -n "$tmp" ]; then
    [ ! -s "$tmp/rows" ] || cat "$tmp/rows"
    pkgs=$(sort -u "$tmp/run")
    # shellcheck disable=SC2086
    echo "test: testing, with -race, what changed, what imports it and what reads it:" $pkgs
  fi
  # The same suites through the unix-socket client, beside the first run and
  # not after it (yardr-9xd9): both mostly wait, so a landing is as long as
  # the slower of the two instead of their sum. The socket step's output is
  # kept in a file and printed when the first has ended, so that each step's
  # output stays whole. It runs whether the first is green or not, and the
  # run is red when either is.
  # env, not an assignment before again: whether that reaches what a function
  # runs differs between shells.
  if [ "$leg" = beside ]; then
    beside=$(mktemp)
    beside_counts=$(mktemp)
    {
      second=0
      again env YARDR_TEST_RPC=1 go test ./internal/store/ ./internal/dispatch/ ./internal/bdp/ ./internal/web/ || second=$?
      printf '%s %s\n' "$pkgs_ok" "$pkgs_failed" >"$beside_counts"
      exit "$second"
    } >"$beside" 2>&1 &
    socket=$!
  fi
  first=0
  # A loaded machine's race leg takes the cores the load leaves it, a CI
  # runner's runs go's default (legflag). Unquoted, an empty legpar is no word
  # at all.
  legflag
  if [ "$2" = selection ] && [ -n "$pkgs" ]; then
    # shellcheck disable=SC2086
    again go test -race $legpar $pkgs || first=$?
  else
    # shellcheck disable=SC2086
    again go test -race $legpar ./... || first=$?
  fi
  if [ "$leg" != beside ]; then
    exit "$first"
  fi
  second=0
  wait "$socket" || second=$?
  cat "$beside"
  # The socket leg ran in the background, so its retry-aware counts are its
  # own copy. Read those instead of counting the raw output: a flaky package
  # appears as FAIL on the first run and ok on the retry.
  read -r side_ok side_failed <"$beside_counts"
  pkgs_ok=$((pkgs_ok + side_ok))
  pkgs_failed=$((pkgs_failed + side_failed))
  rm -f "$beside" "$beside_counts"
  beside=
  beside_counts=
  # Red when either leg is, keeping the first leg's status; green when
  # both are. A failure beats a refusal to judge: the first leg not judged
  # (3) with the second red still fails, so a red socket leg is never told
  # as unjudged.
  if [ "$first" != 0 ] && [ "$first" != 3 ]; then
    exit "$first"
  fi
  if [ "$second" != 0 ]; then
    exit "$second"
  fi
  if [ "$first" != 0 ]; then
    exit "$first"
  fi
  exit 0
}
# The lock holder re-enters the script here to run the race leg, or a plain
# whole-suite leg, with its normal failed-test retries, and packagebudget()
# under one hold. Keep the test counts for the caller, which prints the run's
# summary.
if [ -n "$YARDR_TEST_RACE_LEG" ]; then
  status=$1
  shift
  unset YARDR_TEST_RACE_LEG
  YARDR_RACE_HELD=1
  export YARDR_RACE_HELD
  race_leg_child=1
  rc=0
  again "$@" || rc=$?
  printf '%s %s\n' "$pkgs_ok" "$pkgs_failed" >"$status"
  trap - EXIT
  exit "$rc"
fi
# A read-only look at the machine race lock: who holds it and waits, in the
# order they take it. It takes no ticket and holds no lock, so it runs
# anywhere, without a base, and prints no test line: it looked, it ran
# nothing.
if [ "$1" = "--race-queue" ]; then
  racelocked --show-queue
  rc=$?
  trap - EXIT
  exit "$rc"
fi
# The report of how much room the Go files have under their ceilings
# (filesizeview). It is no gate run, and it comes ahead of all that one does:
# the base, the selection and every step, git and go among them, so it takes
# the seconds a find does. It prints no test line, which would pass for the
# record of a run, and it exits 0 whatever it finds, since it judges nothing.
# A path is cut to the tree's own spelling, as a person or a tool names a file.
# --rewrite is the other mode (filesizerewrite), the landing's: it changes the
# table, and exits 1 for a file over its row.
if [ "$1" = sizes ]; then
  if [ "$2" = --rewrite ]; then
    rwrc=0
    filesizerewrite || rwrc=$?
    trap - EXIT
    exit "$rwrc"
  fi
  path=${2#./}
  case $path in "$PWD"/*) path=${path#"$PWD"/} ;; esac
  filesizeview report "$path" || true
  trap - EXIT
  exit 0
fi
# A run that starts on a nearly full disk fails in a way that reads as the
# branch's own. On 9 Nov 2026 the data volume went to 100% during a builder's
# gate over 40 packages (a full gate wrote about 13 GB in the minute): test
# links and writes failed with "no space left on device" in four packages, each
# reported as a failure of the change (yardr-bc5s). So a run reads the free
# space of the volumes it writes to before it selects anything, and under
# floorgib GiB on any of them it stops with exit 2, "could not run", as a base
# it cannot find does: nothing ran, no test line, and the assembly holds a
# landing instead of sending it back. A full gate wrote about 13 GB in a minute,
# so the default floor of 20 GiB leaves several GiB after that observed burst.
# In the two days before this was written, about three in ten keepings left less
# than 20 GiB free; those landing gates wait until there is room. A yard can set
# a different floor with YARDR_TEST_FLOOR_GIB. This is the one place the default
# number is written in the gate; internal/diskkeep repeats it as FloorGB, for the
# cache it takes before its grace ends, and a test holds the two together.
# The volumes are the ones diskvolumes reads: GOCACHE's, GOTMPDIR's where it is
# set and TMPDIR's, the same the gate's disk line says the state of (diskstate).
# A plan runs nothing, so it is not refused. A CI runner is not the yard's shared
# machine, nothing else runs on it (legflag), and its free space is its
# provider's to change, so it is not refused either: a disk that fills there
# fails the job in its own words. What cannot be read lets the run go on, since a
# gate that cannot see the disk must not refuse a healthy one.
# YARDR_TEST_FLOOR_GIB gives another floor and 0 turns the check off: a yard
# exports it where its gates start, and the gate's own tests give 0 (scriptEnv in
# yardtest_test.go), as YARDR_TEST_LOADAVG replaces the load reading.
floorgib=20
diskfloor() {
  if [ -n "$YARDR_TEST_PLAN" ] || [ -n "$GITHUB_ACTIONS" ]; then
    return 0
  fi
  gib=${YARDR_TEST_FLOOR_GIB:-$floorgib}
  case $gib in *[!0-9]*) gib=$floorgib ;; esac
  if [ "$gib" = 0 ]; then
    return 0
  fi
  # What diskvolumes could not read it leaves out, and the floor goes on
  # without it. The first volume under the floor, in its order, is named.
  vols=$(diskvolumes) || true
  short=$(printf '%s\n' "$vols" | awk -v floor=$((gib * 1048576)) '$2 ~ /^[0-9]+$/ && $2 < floor { print $1, $2; exit }')
  if [ -z "$short" ]; then
    return 0
  fi
  what=${short% *}
  free=${short#* }
  # Cut, not rounded, so that a disk just under the floor is never shown
  # at it.
  shown=$(LC_ALL=C awk -v k="$free" 'BEGIN { printf "%.1f", int(k * 10 / 1048576) / 10 }')
  # The variable identifies the volume without printing a machine-specific path.
  echo "test: cannot run: $shown GiB free on the volume of $what, under the floor of $gib GiB: the disk is too full to start, which says nothing of the change" >&2
  exit 2
}
diskfloor
# The mark that lets conformance/bdp's test run its script (the header says
# when) is the run's to give and never the caller's: one the run was started
# with would run the script in every whole suite. So it starts empty, ahead of
# the base, and a run that cannot compare has none. It is exported so that the
# race leg's worker, which re-enters this script above this point, has the
# run's value.
YARDR_CONFORMANCE=
export YARDR_CONFORMANCE
# What the branch changed: against the base, from where the branch left it.
# For a wagon of a train that is the tip of its train's branch, so a wagon is
# tested for what it changed, not for the train's earlier wagons again.
# Without the base nothing can be told apart, which must not read as "nothing
# changed": a plain run could not run, and a landing is the whole suite (CI's
# checkout has one commit and no origin/main). A review base left behind by a
# rebase is compared from where it and HEAD meet, which selects more, never
# less. If the named base is ahead of HEAD, the merge base is HEAD: the
# branch has no commits past it, and what it changed is uncommitted. A plain
# run compares from there and says so loudly; a landing is the whole suite,
# as with no base at all. Only a base that is no commit here, or has none in
# common with HEAD, says it cannot compare.
if [ -n "$YARDR_BASE" ]; then
  base=$YARDR_BASE said="YARDR_BASE"
else
  base=origin/main said="the default, YARDR_BASE not being set"
fi
from=$(git merge-base "$base" HEAD) || from=
no_base_reason="no such commit here, or none in common with HEAD"
no_base_suffix="is no commit here, or has none in common with HEAD"
if [ -n "$from" ]; then
  head_commit=$(git rev-parse HEAD)
  base_commit=$(git rev-parse "$base")
  if [ "$from" = "$head_commit" ] && [ "$base_commit" != "$head_commit" ]; then
    if [ -n "$YARDR_LANDING" ]; then
      from=
      no_base_reason="base is not an ancestor of HEAD"
      no_base_suffix="is not an ancestor of HEAD"
    else
      # The base moved past the branch point (a worktree whose main is
      # ahead of its branch): compare from where the two meet, which is
      # HEAD here, and say so loudly (yardr-p0xr). What the branch changed
      # is then uncommitted, and a clean tree selects nothing.
      echo "test: $base ($said) is not an ancestor of HEAD; comparing with the branch point $from instead" >&2
    fi
  fi
fi
if [ -z "$from" ]; then
  if [ -n "$YARDR_LANDING" ]; then
    whole "$base ($said) $no_base_suffix"
  fi
  echo "test: cannot compare with $base ($said): $no_base_reason" >&2
  exit 2
fi
since="since $base ($said), from $(git rev-parse --short "$from")"
