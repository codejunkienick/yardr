                depot=
                if [ "$have_yardr" = 1 ]; then
                  if [ -n "$YARDR_DEPOT" ]; then
                    depot=$YARDR_DEPOT
                  elif [ -n "$YARDR_BEAD" ]; then
                    depot=$(yardr bead show "$YARDR_BEAD" 2>/dev/null | sed -n 's/^  depot \([^ ][^ ]*\)$/\1/p' || true)
                  fi
                fi
                handled=
                set -f
                for t in $tests; do
                  sightings=$(flakylines "$t" "$flakylog" | awk 'END { print NR }')
                  # A subtest fails with its parent, so one filing or note
                  # names the family, and they share one bead. The first of
                  # them that flaked before files it or notes it. That is the
                  # parent: it sorts first, and every line that names a
                  # subtest names its parent.
                  root=${t%%/*}
                  # Test names can contain shell pattern characters, so
                  # compare each handled family as a literal word.
                  seen_family=0
                  for handled_root in $handled; do
                    if [ "$handled_root" = "$root" ]; then
                      seen_family=1
                      break
                    fi
                  done
                  if [ "$seen_family" = 0 ]; then
                    if [ "$have_yardr" = 1 ] && [ "${sightings:-0}" -ge 2 ]; then
                      handled="$handled $root "
                      pkg=$(printf '%s\n' "$tpkgs" | awk -v t="$t" '$1 == t { printf "%s%s", sep, $2; sep = " " } END { printf "\n" }')
                      [ -n "$pkg" ] || pkg=$flaky_pkgs_line
                      flakyfile "$t" "$pkg" "$flakylog" "$depot" "$flakyline"
                    fi
                  fi
                done
                set +f
              fi
            fi
          fi
        fi
        ;;
    esac
  fi
  [ -n "$race_leg_child" ] || took "$t0" "$*"
  # The package budget, after a green race leg: a leg whose tests failed
  # is already red without it. The leg's command goes with, for the
  # re-run's flags.
  if [ "$rc" = 0 ] && [ "$race" = 1 ]; then
    packagebudget "$acc" "$@" || rc=$?
  fi
  # A run the budget refused to judge (3) names no failure: the re-runs'
  # own lines say what it would not judge, and a FAILED header would accuse
  # a package of what the run would not say of it.
  [ -n "$race_leg_child" ] || [ "$rc" = 0 ] || [ "$rc" = 3 ] || failed "$log" "$@"
  case " $* " in
    *" go test "*)
      # The failures are the final log's: a package that passed on rerun is
      # passed, not failed.
      pkgs_ok=$((pkgs_ok + step_ok))
      pkgs_failed=$((pkgs_failed + $(failcount "$log")))
      ;;
  esac
  rm -f "$log" "$log.rc" "$acc"
  return "$rc"
}
# failed prints the lines of a failed step's output that say what failed: a
# failing test, package or build, a panic, a race, and what go vet and the
# compiler say (file.go:line:col: message), then each failed test's own lines
# under its report, so the summary says why and not only which, and the tests
# a timeout caught running, which its panic line does not name. At most 60
# lines over both, the first ones.
failed() {
  f=$1
  shift
  echo "test: FAILED: $*"
  {
    grep -a -E -e '--- FAIL' -e '^FAIL' -e 'panic:' -e 'DATA RACE' -e '^[^[:space:]]+\.go:[0-9]+:[0-9]+:' "$f" || true
    flakyfails --human "$f"
  } | head -n 60 || true
}
# waitcount prints the race-lock seconds one step's log ($1) holds: the
# `test: waited N s` lines its race legs printed, 0 when there are none.
waitcount() { grep -a -E '^test: waited [0-9]+ s for the race lock$' "$1" | awk '{s+=$3} END {print s+0}'; }
# okcount prints the packages one go test log ($1) passed: the `ok` lines. A
# package with no tests prints `?`, not `ok`, and is not counted.
okcount() { grep -a -c -E '^ok[[:space:]]' "$1" || true; }
# failcount prints the packages one go test log ($1) failed: the FAIL lines,
# as the flaky retry reads them.
failcount() { grep -a -c -E '^FAIL[[:space:]]+[^[:space:]]+' "$1" || true; }
# pkgof prints the packages whose output names one test ($2) in a go test
# log ($1). Go prints a package's output before its ok/FAIL line, so the
# names between two such lines belong to the package the second names (as
# the raced attribution in again reads the same boundary). Empty when no
# section names the test.
pkgof() {
  awk -v t="$2" '
    /^(ok|FAIL|\?)[ \t]+[^ \t]+/ { if (hit) print $2; hit = 0; next }
    {
      line = $0
      if (sub(/.*--- FAIL: /, "", line)) {
        sub(/ .*/, "", line)
        if (line == t) hit = 1
      }
    }
  ' "$1"
}
# A flaky log line is its head (date, short sha, and the tests and packages
# the printed flaky line names) and, when the first run's failing lines were
# kept (flakyfails), this separator and those lines. No head holds the
# separator: test names and package paths have no spaces.
flaky_sep=' | '
# flaky_disk is the text a test's output holds when the disk it wrote to was
# full: what Go prints for ENOSPC, which a failed build, a link or a file a test
# wrote all end in. Only that exact text says the disk failed the test.
flaky_disk='no space left on device'
# flakyfails prints, on one line, what a go test log ($1) holds for each test
# that failed, for the flaky log: a block per `--- FAIL:` line, that line and
# the lines under it, which go indents deeper than it (a subtest's report
# stands inside its parent's, so a subtest has a block of its own and its
# parent's holds it too). A block keeps at most 6 lines of 200 bytes,
# its lines joined by a backslash and an n, and the log at most 20 blocks
# (the quiet run caps its failing test names at 20 as well: a stalled box
# fails tens of tests, and the line is copied into a bead), the blocks
# joined by the separator. A line that is not deeper than a block's FAIL
# line ends it, so output the code under test prints between reports is
# not kept; a test that panics is the exception, since go prints its panic
# unindented right after its FAIL line, and that one line joins the blocks
# it follows. Whitespace-only lines, which go prints inside a multi-line
# message, are skipped, and control characters other than a tab are dropped,
# so that a terminal showing the log or a bead copied from it is not moved by
# what a test printed. A line over 200 bytes keeps its first 120 and its
# last 77 around three dots (clip), not its first 200: a message ends with what
# happened more often than it starts with it, and a path in the middle took
# the room and cut that off. The awk and the tr run in the C locale, so that
# every awk counts and cuts bytes alike (a UTF-8 one counts characters), and
# clip moves each cut to the edge of a character: half of one is no text, and
# the tr of macOS, in a UTF-8 locale, stops at it and drops the rest of the
# record.
# When no test failed by name, one block holds what the log says instead: a
# timeout's panic line and its running tests, a fatal error's or panic's line
# and the dump's head, else the first output lines (a TestMain that exits
# prints only those), each capped like a block. Empty when the log holds
# nothing but its ok and FAIL lines. It reads the first run's log, which the
# rerun replaces. With --human the same blocks are rendered with real
# newlines, for the FAILED summary failed prints, and a timeout's block (its
# panic line and running tests, five at most) follows the failed tests' blocks
# when the log holds both; without it, the one-line log form above, which
# keeps the failed tests alone.
# A block any of whose lines holds flaky_disk (not only the six kept) is the
# disk's and not the test's: the log line leaves it out, and with --disk the
# function prints the names of all such tests, one a line, in place of the
# blocks. With --pairs it prints each such test beside its package, since a test
# name can occur in two packages and only one of them may have hit the disk. A
# parent's block holds its subtests', so a parent of a subtest that hit the disk
# is named with it. The 20 blocks the log line keeps are the first 20 that are
# no disk's, as tens of tests fail on a full disk and the one that failed for
# its own reason may be behind them; the FAILED summary keeps the first 20 blocks.
flakyfails() {
  human=0
  disk=0
  pairs=0
  if [ "$1" = "--human" ]; then human=1; shift; fi
  if [ "$1" = "--disk" ]; then disk=1; shift; fi
  if [ "$1" = "--pairs" ]; then pairs=1; disk=1; shift; fi
  LC_ALL=C awk -v sep="$flaky_sep" -v human="$human" -v disk="$disk" -v pairs="$pairs" -v text="$flaky_disk" '
    BEGIN {
      br = (human ? "\n" : "\\n")
      if (human) sep = "\n"
      start = 1
    }
    function finish(result,    fields, i) {
      if (result ~ /^FAIL[ \t]+[^ \t]+/) {
        split(result, fields, /[ \t]+/)
        for (i = start; i <= nb; i++) if (hit[i]) print name[i], fields[2]
      }
      start = nb + 1
      sp = 0
    }
    # A cut by bytes can land inside a UTF-8 character: the bytes after its
    # first are 0x80-0xBF, and no character starts with one. So the head backs
    # up while the byte after it is one, and the tail drops the ones it starts
    # with, and both end at the edge of a character. A line of 200 bytes or
    # less is whole.
    function clip(s,    h, t) {
      if (length(s) <= 200) return s
      h = 120
      while (h > 0 && substr(s, h + 1, 1) ~ /[\200-\277]/) h--
      t = length(s) - 76
      while (substr(s, t, 1) ~ /[\200-\277]/) t++
      return substr(s, 1, h) "..." substr(s, t)
    }
    function keep(b, s) {
      if (index(s, text)) hit[b] = 1
      if (cnt[b] >= 6) return
      sub(/[ \t\r]+$/, "", s)
      match(s, /^ */)
      s = clip(substr(s, (RLENGTH < lvl[b] ? RLENGTH : lvl[b]) + 1))
      txt[b] = (cnt[b] ? txt[b] br : "") s
      cnt[b]++
    }
    function cap(s) {
      sub(/[ \t\r]+$/, "", s)
      return clip(s)
    }
    /^ +$/ { next }
    {
      if (pairs && /^(ok|FAIL|\?)[ \t]+[^ \t]+/) {
        finish($0)
        next
      }
      match($0, /^ */)
      depth = RLENGTH
      if ($0 ~ /^panic: / && $0 !~ /^panic: test timed out/) {
        for (j = 1; j <= sp; j++) keep(stack[j], $0)
      }
      while (sp > 0 && lvl[stack[sp]] >= depth) sp--
      for (j = 1; j <= sp; j++) keep(stack[j], $0)
      if ($0 ~ /^ *--- FAIL: /) {
        nb++
        lvl[nb] = depth
        name[nb] = $0
        sub(/.*--- FAIL: /, "", name[nb])
        sub(/ .*/, "", name[nb])
        keep(nb, $0)
        stack[++sp] = nb
      }
      # The fallback, line by line: the first timeout with its panic and
      # running entries, the first fatal error or panic with its line and
      # dump head, and the first output lines. Whichever the log holds
      # decides in the END, in that order, and only when no test failed.
      if ($0 ~ /^panic: test timed out/ && !tseen) {
        tseen = 1
        tpanic = cap($0)
      } else if (tseen && !tdone) {
        if (!trun && $0 ~ /^[ \t]*running tests:[ \t]*$/) trun = 1
        else if (trun && $0 ~ /^[ \t]+[^ \t]/) {
          if (tn < 5) tent[++tn] = cap($0)
        } else if (trun) {
          trun = 0
          tdone = 1
        }
      }
      if (($0 ~ /^fatal error: / || ($0 ~ /^panic: / && $0 !~ /^panic: test timed out/)) && !cseen) {
        cseen = 1
        cpanic = cap($0)
      } else if (cseen && cn < 5 && $0 != "" && $0 !~ /^[ \t]*$/ && $0 !~ /^(ok|FAIL|\?)[ \t]/ && $0 != "FAIL") {
        cdump[++cn] = cap($0)
      }
      # For a human the script status lines say nothing: the leg log
      # holds them too, and the summary would repeat what the output
      # already said.
      if (fn < 6 && $0 != "" && $0 !~ /^[ \t]*$/ && $0 !~ /^(ok|FAIL|\?)[ \t]/ && $0 != "FAIL" && (!human || $0 !~ /^test: /)) {
        fline[++fn] = cap($0)
      }
    }
    END {
      if (pairs) exit
      if (disk) {
        for (k = 1; k <= nb; k++) if (hit[k]) print name[k]
        exit
      }
      if (nb) {
        for (k = 1; k <= nb && m < 20; k++) if (human || !hit[k]) out = out (m++ ? sep : "") txt[k]
        # For a human the timeout block follows the blocks of the failed
        # tests: the panic line says that a package timed out, and only its
        # running tests say what it was in. The log line keeps the failed
        # tests alone: its head names the tests that flaked, and a timeout
        # in another package is not one.
        if (human && tseen) {
          out = out sep tpanic
          for (k = 1; k <= tn; k++) out = out br tent[k]
        }
        print out
      } else if (tseen) {
        out = tpanic
        for (k = 1; k <= tn; k++) out = out br tent[k]
        print out
      } else if (cseen) {
        out = cpanic
        for (k = 1; k <= cn; k++) out = out br cdump[k]
        print out
      } else if (fn) {
        out = fline[1]
        for (k = 2; k <= fn; k++) out = out br fline[k]
        print out
      }
    }
  ' "$1" | LC_ALL=C tr -d '\001-\010\013-\037\177'
}
# flakystuck prints the tests a go test log ($1) names without a `--- FAIL:`
# line, one a line: the running tests of a test timeout (go sorts them), else
# the crashing test of a fatal error or a panic in a code goroutine, else
# nothing. The crashing test is best-effort: the first frame of the first
# goroutine that is not a testing or runtime frame (the runtime's own code
# lives in runtime and internal/runtime), its base name, without the args,
# the package path and the suffixes Go adds to nested closures, so a crash in
# TestX.func1.1 names TestX. A timeout wins over a crash further down the log,
# as the block flakyfails keeps does. Empty for a TestMain that exits, which
# names no test anywhere.
flakystuck() {
  awk '
    function base(sym) {
      sub(/\(.*/, "", sym)
      sub(/.*\//, "", sym)
      sub(/^[^.]+\./, "", sym)
      sub(/(\.func[0-9]+|\.[0-9])+$/, "", sym)
      return sym
    }
    /^panic: test timed out/ { tseen = 1; next }
    tseen && !tdone && /^[ \t]*running tests:[ \t]*$/ { trun = 1; next }
    trun {
      if ($0 ~ /^[ \t]+[^ \t]/) {
        if (tn < 20) tent[++tn] = $1
        next
      }
      trun = 0
      tdone = 1
    }
    /^fatal error: / || (/^panic: / && $0 !~ /^panic: test timed out/) {
      if (!cseen) cseen = 1
      next
    }
    cseen && !cdone && /^goroutine / { ing = 1; next }
    ing {
      if ($0 == "" || $0 ~ /^(ok|FAIL|\?)[ \t]/ || $0 == "FAIL" || $0 ~ /^goroutine / || $0 ~ /^created by /) {
        ing = 0
        cdone = 1
      } else if ($0 ~ /^[ \t]/) {
        # The file line under a frame.
      } else if ($0 ~ /^[A-Za-z_][^ \t]*\(/ && $0 !~ /^(testing|runtime)(\.|\/)/ && $0 !~ /^internal\/runtime\//) {
        name = base($0)
        ing = 0
        cdone = 1
      } else if ($0 ~ /^[A-Za-z_][^ \t]*\(/) {
        # A testing or runtime frame above the crash.
      } else if ($0 ~ /^\.\.\./) {
        # Elided frames inside the stack.
      } else {
        ing = 0
        cdone = 1
      }
      next
    }
    END {
      if (tseen) {
        for (k = 1; k <= tn; k++) print tent[k]
      } else if (name != "") {
        print name
      }
    }
  ' "$1"
}
# diskfailed prints what a go test log ($1) shows the disk failed: the names of
# tests whose blocks hold flaky_disk, or, with --packages, packages whose failed
# output holds it and has no named test failure. Where no test failed by name
# and the kept failure lines hold it but no package result names it, a hyphen
# stands for the failure as a whole. Nothing for any other failure.
diskfailed() {
  if [ "$1" = "--packages" ]; then
    shift
    awk -v text="$flaky_disk" '
      function finish(result,    fields) {
        if (result ~ /^FAIL[ \t]+[^ \t]+/ && !named && hit) {
          split(result, fields, /[ \t]+/)
          print fields[2]
        }
        named = hit = 0
      }
      /^(ok|FAIL|\?)[ \t]+[^ \t]+/ { finish($0); next }
      {
        if ($0 ~ /^ *--- FAIL: /) named = 1
        if (index($0, text)) hit = 1
      }
    ' "$1" | sort -u
  elif [ -z "$(sed -n 's/.*--- FAIL: \([^ ][^ ]*\).*/\1/p' "$1" | head -n 1)" ]; then
    case $(flakyfails "$1" || true) in *"$flaky_disk"*) echo - ;; esac
  else
    flakyfails --disk "$1" | sort -u
  fi
}
# inlist says whether the word $1 is a line of the text $2. It is a literal
# match: test names and package paths hold characters a pattern would read.
inlist() { printf '%s\n' "$2" | grep -qxF -- "$1"; }
# briefly prints the lines it is given on one line, five of them at most and
# then how many more: a full disk fails every package and tens of tests, and the
# line it is named in is read by a person.
briefly() {
  awk '
    NR <= 5 { out = out (NR > 1 ? " " : "") $0 }
    END { if (NR > 5) out = out " and " NR - 5 " more"; print out }
  '
}
# diskvolumes prints one line for each of the volumes a run writes to: GOCACHE's,
# GOTMPDIR's where it is set (the go command's own scratch, where it links a test
# binary) and TMPDIR's (the tests', and the gate's own files). It is the one place
# the three directories are read, for the floor diskfloor holds before a run and
# for the state diskstate says after a failure. `go env` answers for the first
# two, since the yard rotates GOCACHE with `go env -w` (internal/diskkeep) and
# nothing in the environment says so. A rotation does not exist until something
# builds in it, so each directory is read at the nearest one that does, as
# diskkeep reads it. A line is the name, the KiB available, the KiB the volume
# holds, the share used and the mount point, which may hold spaces and so comes
# last, from POSIX df -Pk, which reads alike on Linux and macOS. The fields are
# counted back from the capacity, so that a filesystem or a mount point with a
# space in its name does not shift them. A volume it cannot read has no line and
# makes the status 1, as does a go env that fails: the lines of the volumes it
# could read are still printed, since the floor judges each by itself, but a
# volume not read could be the one that is full.
diskvolumes() {
  status=0
  goenv=$(go env GOCACHE GOTMPDIR 2>/dev/null) || {
    goenv=
    status=1
  }
  for what in GOCACHE GOTMPDIR TMPDIR; do
    case $what in
    GOCACHE) dir=$(printf '%s\n' "$goenv" | sed -n 1p) ;;
    GOTMPDIR) dir=$(printf '%s\n' "$goenv" | sed -n 2p) ;;
    TMPDIR) dir=${TMPDIR:-/tmp} ;;
    esac
    if [ -z "$dir" ]; then
      continue
    fi
    probe=$dir
    while [ ! -d "$probe" ] && [ "$probe" != "$(dirname "$probe")" ]; do
      probe=$(dirname "$probe")
    done
    line=$(df -Pk "$probe" 2>/dev/null | awk -v what="$what" '
      NR == 2 {
        for (i = 3; i <= NF; i++) {
          if ($i ~ /^[0-9]+%$/ && $(i - 1) ~ /^[0-9]+$/ && $(i - 3) ~ /^[0-9]+$/) {
            mount = $(i + 1)
            for (j = i + 2; j <= NF; j++) mount = mount " " $j
            print what, $(i - 1), $(i - 3), $i, mount
            exit
          }
        }
      }
    ')
    if [ -z "$line" ]; then
      status=1
    else
      printf '%s\n' "$line"
    fi
  done
  return "$status"
}
# diskstate prints, in brackets and led by a space, how full the fullest of the
# volumes a run writes to is (diskvolumes): the one with the least free, the
# first of them where two have as much, since a volume with room is no evidence
# for a write that found none. It says the mount point, what is free of what the
# volume holds and what share is used, in the units a person reads, and nothing
# where a volume could not be read.
diskstate() {
  vols=$(diskvolumes) || return 0
  printf '%s\n' "$vols" | awk '
    function human(k) {
      if (k >= 1048576) return sprintf("%.1f GiB", k / 1048576)
      if (k >= 1024) return sprintf("%.0f MiB", k / 1024)
      return k " KiB"
    }
    NF && (!seen || $2 + 0 < avail + 0) {
      seen = 1
      avail = $2
      size = $3
      used = $4
      mount = $5
      for (i = 6; i <= NF; i++) mount = mount " " $i
    }
    END { if (seen) printf " (%s has %s free of %s, %s used)", mount, human(avail), human(size), used }
  ' || true
}
# flakylines prints the lines of the flaky log ($2) that name a test ($1),
# in their head: behind the separator are the failing lines of the tests the
# head names, which can mention a test that did not flake, and a mention is
# no sighting. A line without the separator is all head, as the lines
# written before the separator existed are. The name is passed in the
# environment so awk reads it as data, not as an escape sequence.
flakylines() {
  FLAKY_TEST=" $1 " awk -v sep="$flaky_sep" '
    {
      head = $0
      i = index(head, sep)
      if (i) head = substr(head, 1, i - 1)
    }
    index(head, ENVIRON["FLAKY_TEST"]) { print }
  ' "$2"
}
# flakybeads prints the beads a run tested, for the `beads=<ids>` field that
# ends the head of its flaky log line, so a reader knows which change the run
# tested. YARDR_TEST_BEADS is the caller's word for it, as a train's
# integration gives it (the YARDR_BEAD of that run is the train, not the beads
# in it); a variable that is set stands even when it is empty, so a caller that
# cannot name the beads leaves the line without a field, and not with a bead
# that is the wrong key. Without it the run is of
# YARDR_BEAD: a builder's or a reviewer's session, or a landing by merge-local.
# Only the characters an id and a list of them are made of are kept, as the
# line is read by its spaces and copied into a bead. Empty when there is
# nothing to say (CI, a quiet run, a hand outside a session): no field.
flakybeads() {
  printf '%s' "${YARDR_TEST_BEADS-${YARDR_BEAD-}}" | LC_ALL=C tr -cd 'A-Za-z0-9_.,-'
}
# flakyopen prints the id of the open bead that stands for a test ($1) in the
# packages $2, or nothing when none does. It reads the listing of open beads
# on its input. A Flaky bead is titled `Flaky: <test> (<packages>)`. A test
# and its subtests fail together and are mended together, so the bead of any
# of them stands for all. In order: the bead of the test itself, of its
# top-level test (the name up to the first `/`), and of any other subtest of
# that test. The first in the listing wins within a kind. The packages must
# be the same, since a test name is only unique within its package. The id is
# the listing line's first field and has to look like one: the store's ids
# start with a letter or a digit, so a line made by a line break in a title
# cannot name an option for the note. The names go in the environment so awk
# reads them as data, not as escape sequences, as flakylines reads its name.
flakyopen() {
  FLAKY_TEST=$1 FLAKY_PKGS=$2 awk '
    BEGIN {
      test = ENVIRON["FLAKY_TEST"]
      packages = "(" ENVIRON["FLAKY_PKGS"] ")"
      root = test
      if (i = index(test, "/")) root = substr(test, 1, i - 1)
      best = 4
    }
    NR == 1 {
      title_col = index($0, "TITLE")
      next
    }
    {
      if (!title_col || $1 !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/) next
      title = substr($0, title_col)
      if (substr(title, 1, length("Flaky: ")) != "Flaky: ") next
      title = substr(title, length("Flaky: ") + 1)
      j = index(title, " ")
      if (!j || substr(title, j + 1) != packages) next
      name = substr(title, 1, j - 1)
      if (name == test) kind = 1
      else if (name == root) kind = 2
      else if (index(name, root "/") == 1) kind = 3
      else next
      if (kind < best) { best = kind; id = $1 }
    }
    END { if (best < 4) print id }
  '
}
# flakyfile files a bead for a test ($1) that flaked again in the packages
# $2: a backlog P3 titled `Flaky: <test> (<packages>)`, carrying the test's
# lines of the flaky log ($3). Where an open bead already stands for the test
# (flakyopen), nothing is filed. The bead is noted with the line the run just
# added to the log ($5), whole, since its body already carries the older
# ones. The depot is the caller's ($4, empty for none). Every failure warns
# and never fails the step: the gate must not fail because the yard is down.
# A note the yard refuses files nothing either, since a bead is open and the
# log has the line.
flakyfile() {
  test=$1
  packages=$2
  logf=$3
  depot=$4
  sighting=$5
  title="Flaky: $test ($packages)"
  if ! listed=$(yardr bead list 2>&1); then
    echo "test: warning: cannot list beads to file the repeat flake $test: $listed" >&2
    return 0
  fi
  open=$(printf '%s\n' "$listed" | flakyopen "$test" "$packages" || true)
  if [ -n "$open" ]; then
    if ! noted=$(printf '%s\n' "$sighting" | yardr bead note "$open" - 2>&1); then
      echo "test: warning: cannot note the repeat flake $test on $open: $noted" >&2
      return 0
    fi
    echo "test: noted $open: $title"
    return 0
  fi
  if [ -n "$depot" ]; then
    set -- --depot "$depot"
  else
    set --
  fi
  if ! filed=$(flakylines "$test" "$logf" | yardr bead create "$title" "$@" --stage backlog -p 3 -b - 2>&1); then
    echo "test: warning: cannot file the repeat flake $test: $filed" >&2
    return 0
  fi
  echo "test: filed $filed: $title"
}
# summary prints the run's test line ($1 is its exit status: 0 passed, 3 not
# judged): the result, the packages passed and failed, the wall seconds, and
# the seconds queued on the race lock. A note carries it whole
# (docs/testing.md R4).
summary() {
  if [ "$1" = 0 ]; then res=pass; elif [ "$1" = 3 ]; then res="not judged"; else res=fail; fi
  echo "test: sh .yardr/test @ $(git rev-parse --short HEAD): $res, $pkgs_ok packages ok, $pkgs_failed failed, $(($(date +%s) - started)) s, waited $waited_total s"
}
# The packages over the 60 s budget (docs/testing.md R1): a directory, the
# bead that brings it under, and why it is over. No measured row is left;
# the remaining row is the quiet run's yard-shape matrix, an acceptance
# test that runs only where YARDR_QUIET_RUN is set.
# A race leg that runs one of these over 60 s still passes;
# any other package over 60 s is run again alone, and fails the run when
# over 60 s again on a quiet machine; over again on a loaded one passes
# with the load named (loaded as the re-run started or as it ended), unless
# YARDR_R1_STRICT is set by the quiet run.
# Then the loaded pass is off: over 60 s alone on a loaded machine is not
# judged (exit 3), and on a quiet one fails as before. The fix beads delete
# the rows;
# a row whose package is gone fails nothing, since no result line maps to
# it, but delete it anyway.
over60='
contrib/isolated-yard yardr-n9ss TestYardShapes (the yard-shape matrix) walks three yards, 35-50 s beside one another, and runs only where YARDR_QUIET_RUN is set, which is the quiet run (docs/testing.md R6); the package is 18 s without it. No bead brings it under: it is an acceptance test, not a slow unit test
'
# machineload prints the machine's one-minute load average and core count,
# as "load <avg> on <cores> cores", whatever they are: the flaky log line
# ends with what it says, so a reader can tell a flake on a quiet machine
# from one under load without a second source. It reads /proc/loadavg and
# nproc where the system keeps them, sysctl's vm.loadavg and hw.ncpu
# elsewhere, as the built-in machine source does
# (internal/limits/machine.go). YARDR_TEST_LOADAVG and
# YARDR_TEST_CORES override the readings, for the gate's own tests. Where
# nothing answers, or the readings are no numbers, it prints nothing and
# fails, and the caller says "load unknown" in its place.
machineload() {
  if [ -n "$YARDR_TEST_LOADAVG$YARDR_TEST_CORES" ]; then
    avg=$YARDR_TEST_LOADAVG
    cores=$YARDR_TEST_CORES
  elif [ -r /proc/loadavg ]; then
    avg=$(awk '{print $1}' /proc/loadavg)
    cores=$(nproc 2>/dev/null || grep -c '^processor' /proc/cpuinfo)
  else
    avg=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')
    cores=$(sysctl -n hw.ncpu 2>/dev/null)
  fi
  case "$avg" in ''|*[!0-9.]*|.*|*.*.*|*.) return 1;; esac
  case "$cores" in ''|*[!0-9.]*|.*|*.*.*|*.) return 1;; esac
  echo "load $avg on $cores cores"
}
# loadedmachine prints what machineload says when the machine is too loaded
# for a timing verdict: the average past the core count. The race lock holds
# off the other gate legs, not every test on the machine, so the budget's
# alone re-run can be loaded too (yardr-wq5h: release and web over budget
# alone beside a Go test and a cargo test). Where the machine is quiet, or
# its load unknown, it prints nothing and fails: unknown load never passes
# a package.
loadedmachine() {
  line=$(machineload) || return 1
  printf '%s\n' "$line" | awk '{ exit !(($2 > $4) && ($4 > 0)) }' || return 1
  echo "$line"
}
# sizewaits sizes the race leg's waits to this machine: it sets under, the
# command the leg's go test runs behind, to env with YARDR_TEST_LOAD, and says
# so in a line. The factor is the load over the cores, as loadedmachine's line
# gives both, from 1 to 4. A machine that is quiet, or whose load is unknown, is
# 1: unknown load never widens a wait, as it excuses no package from the budget.
# 4 is about the ratio a landing has been seen in (a load of 40 on 10 cores) and
# as much room as the waits raised by hand needed. A wait that is met returns
# early however long it is, so the factor costs a green run nothing; one that is
# not met is a hang, which a longer fuse only makes slower to report, and go
# test's own ten minutes end a suite whatever the factor. One decimal, with a
# point: internal/testload reads a point only, and awk writes the locale's.
sizewaits() {
  loadline=$(loadedmachine) || loadline=
  loadf=$(printf '%s\n' "$loadline" | LC_ALL=C awk '
    $1 == "load" && $5 == "cores" && $4 > 0 {
      f = $2 / $4
      if (f < 1) f = 1
      if (f > 4) f = 4
      printf "%.1f\n", f
      found = 1
    }
    END { if (!found) print "1.0" }')
  under="env YARDR_TEST_LOAD=$loadf"
  echo "test: YARDR_TEST_LOAD=$loadf for the race leg (${loadline:-machine not loaded, or its load unknown})"
}
# loadedeither judges whether a re-run sat in a load, from the two
# loadedmachine samples around it: $1 as the re-run started, $2 as it ended,
# each the line loadedmachine printed, or empty where the machine was quiet
# or its load unknown. Loaded at either passes: it prints the start's line
# where that is loaded, else the end's, and fails when both are quiet. The
# one-minute average lags, so the start sample holds the loaded minutes the
# re-run was about to sit in, and the end sample alone read a load that
# dipped before the check as quiet: yardr-p3pv's landing failed R1 for
# hooks at 125.8 s alone, where the plain gate on the same commit ran it in
# 35.6 s, and went back to new for a package it never touched. It reads
# nothing from the machine, so the gate's own tests feed it canned pairs.
loadedeither() {
  if [ -n "$1" ]; then
    echo "$1"
  elif [ -n "$2" ]; then
    echo "$2"
  else
    return 1
  fi
}
# gatepar prints the -p a landing's race leg runs go test with, from the line
# loadedmachine printed ($1), and fails with no output where $1 is empty: the
# machine was quiet or its load unknown, and the leg runs go's own default,
# every core, as it always has. Go builds and runs up to -p packages at once,
# each with parallel tests of its own, beside the builders and the socket leg
# (yardr-y6js: load 39-64 on 10 cores struck the watchdog tests of
# contrib/isolated-yard five times in a morning, each a fuse a down outlasted),
# so on a loaded machine the leg takes the cores the load leaves it: the cores
# squared over the load, rounded down. Load 40 on 10 cores gives 2, 15 gives 6.
# Never under 2, which still lets a build overlap a test run, and never over
# the cores, which would raise go's default. It reads nothing from the
# machine, so the gate's own tests feed it canned lines.
gatepar() {
  [ -n "$1" ] || return 1
  printf '%s\n' "$1" | awk '{
    a = $2 + 0; c = $4 + 0
    p = int(c * c / a)
    if (p < 2) p = 2
    if (p > c) p = int(c)
    print p
  }'
}
# legflag sets legpar, the -p flag of the race leg's go test, and says so in
# one line where the load made one (gatepar). On a quiet machine, or one whose
# load is unknown, legpar is empty and nothing is said: the leg's command is
# what it was. On a CI runner, where the load is past the cores, it is empty
# too, and one line says why: GITHUB_ACTIONS is set in every step of a GitHub
# Actions job and on the yard's own machine it is not. Nothing else runs on a
# runner, so the load it reads is the job's own setup and go vet, and the cores
# the throttle leaves go to no one (yardr-ayj6: -p=2 on four cores); it was made
# for the yard's shared machine (yardr-y6js) and stays there. The runner's load
# is still read and named: R1 and the wait factor read it as before, and it is
# what excuses a package over budget on a loaded runner, so one made to read
# quiet (YARDR_TEST_LOADAVG in its workflow) would convict it. The load is read
# when the leg is queued, before the lock, because -p is part of the command the
# lock holder runs and again re-runs from; a wait of a minute or two leaves the
# one-minute average much as it was. -p=N is one word, so the dash-words again
# and packagebudget carry to a re-run keep it whole; a bare -p would reach it as
# -p -count=1.
legflag() {
  legpar=
  legload=$(loadedmachine) || return 0
  if [ -n "$GITHUB_ACTIONS" ]; then
    echo "test: go test default -p on a CI runner ($legload read, not throttled)"
    return 0
  fi
  legn=$(gatepar "$legload") || return 0
  echo "test: go test -p=$legn ($legload)"
  legpar=-p=$legn
}
# packagebudget judges the 60 s budget (docs/testing.md R1) on a go test
# -race leg's output ($1): only the ok lines carry judged durations, a
# package whose tests failed being already red without it. Cached packages
# print no seconds and are not judged. The allow-list goes by file, as the
# reads table does: awk takes no newline in -v.
# A package over budget that the allow-list does not name is run again by
# itself, and judged by the re-run: over 60 s alone fails on a quiet
# machine, naming both times, and passes with both times and the load on a
# loaded one (loadedmachine), unless YARDR_R1_STRICT is set by the quiet
# run. Then the loaded pass is off: over 60 s alone on a loaded machine is
# refused the verdict, in a `test: R1:` line naming both times and the load,
# and the run ends neither passed nor failed (exit 3, which only a strict
# run returns, so only the quiet run ever sees it); over 60 s alone on a
# quiet machine fails as before, and a quiet-sample failure or a failed
# re-run beside a refusal still fails the run (exit 1). The machine is
# sampled twice, as the re-runs start and
# when the last ends, and is loaded when either sample is (loadedeither);
# the load a line names is the start's where that is loaded, else the end's.
# A strict run samples it twice for each re-run instead, as that re-run
# starts and as it ends, so a line names the load around its own re-run.
# The re-run is the leg's own command ($2 on: the same flags), with -count=1 so
# it is timed and not cached, and the one package; several are re-run up to
# three at a time, each to its own file, and printed and judged in sorted
# order once all are done, so the lines read as one re-run after another did.
# Three stays under the five side-by-side race suites that slowed past
# timeout (yardr-cecb), with margin, on any machine. On a quiet leg with two
# over-budget packages or more, the re-runs' own contention can read as
# loaded and pass what one re-run after another would convict. A strict run
# passes nothing for load, so what it judges is the time itself, and
# three suites side by side made that: the quiet run's alone times were
# 60-84 s for packages that took 30-57 s one after another (yardr-t4c0). It
# therefore re-runs one at a time, and a time over 60 s is the package's own.
# The re-runs share the leg's hold on the race lock
# (YARDR_RACE_HELD, which the leg set): they wait on nothing again. A re-run
# that fails, or prints no seconds, fails the run: the leg saw an
# over-budget package the re-run did not clear.
packagebudget() {
  legout=$1
  shift
  allow=$(mktemp)
  printf '%s\n' "$over60" >"$allow"
  over=$(mktemp)
  unsorted=$(mktemp)
  awk '
    function seconds(s, total, n) {
      if (s == "") return -1
      total = 0
      while (match(s, /^[0-9]+([.][0-9]+)?/)) {
        n = substr(s, 1, RLENGTH) + 0
        s = substr(s, RLENGTH + 1)
        if (s ~ /^h/) { total += n * 3600; sub(/^h/, "", s) }
        else if (s ~ /^ms/) { total += n / 1000; sub(/^ms/, "", s) }
        else if (s ~ /^m/) { total += n * 60; sub(/^m/, "", s) }
        else if (s ~ /^µs/) { total += n / 1000000; sub(/^µs/, "", s) }
        else if (s ~ /^us/) { total += n / 1000000; sub(/^us/, "", s) }
        else if (s ~ /^ns/) { total += n / 1000000000; sub(/^ns/, "", s) }
        else if (s ~ /^s/) { total += n; sub(/^s/, "", s) }
        else return -1
      }
      return s == "" ? total : -1
    }
    FILENAME == ARGV[1] {
      if ($0 ~ /^[^ ]+ /) { dir = $0; sub(/ .*/, "", dir); over[dir] = 1 }
      next
    }
    /^ok[ \t]/ {
      pkg = $2; secs = seconds($3)
      if (pkg == "yardr.dev/yardr") dir = "."
      else if (pkg ~ /^yardr\.dev\/yardr\//) { dir = pkg; sub(/^yardr\.dev\/yardr\//, "", dir) }
      else next
      if (secs > 60 && !(dir in over) && !(dir in bad)) {
        bad[dir] = 1
        printf "%s %.9g\n", pkg, secs
      }
    }' "$allow" "$legout" >"$unsorted" || { rm -f "$allow" "$over" "$unsorted"; return 1; }
  rm -f "$allow"
  sort "$unsorted" >"$over"
  rm -f "$unsorted"
  [ -s "$over" ] || { rm -f "$over"; return 0; }
  # The same flags as the leg, the failed packages' pattern: the prefix up
  # to and including "test" (go test), then the flags (what after test
  # starts with -). Packages and flags have no spaces.
  prefix=""
  flags=""
  seen_test=0
  for a in "$@"; do
    if [ "$seen_test" = 0 ]; then
      prefix="$prefix $a"
      if [ "$a" = "test" ]; then
        seen_test=1
      fi
    else
      case "$a" in
        -*) flags="$flags $a" ;;
      esac
    fi
  done
  # The re-runs share one load pair, sampled around the whole batch: the
  # one-minute average lags, so the start sample holds the loaded minutes
  # the re-runs were about to sit in (loadedeither). A strict run's re-runs
  # go one at a time, and each takes a pair of its own below, which the
  # judging reads in this one's place.
  load_start=$(loadedmachine) || load_start=
  width=3
  [ -z "$YARDR_R1_STRICT" ] || width=1
  runs=$(mktemp -d)
  jobs=$(mktemp)
  n=0
  inflight=0
  wave=""
  while read -r pkg secs; do
    [ -n "$pkg" ] || continue
    n=$((n + 1))
    run=$runs/$n.out
    # Store the numeric file id, not its path: TMPDIR may contain spaces.
    printf '%s %s %s\n' "$pkg" "$secs" "$n" >>"$jobs"
    # The re-run reads no stdin: the loop's is the over-budget list. Its
    # output goes to its own file, runlogged's file mode without the print,
    # which waits for the batch; its status beside it. A strict run's
    # re-run samples the load on either side of itself, each to a file.
    # shellcheck disable=SC2086
    (
      [ -z "$YARDR_R1_STRICT" ] || loadedmachine >"$run.before" || :
      $prefix $flags -count=1 "$pkg" </dev/null >"$run" 2>&1
      echo "$?" >"$run.rc"
      [ -z "$YARDR_R1_STRICT" ] || loadedmachine >"$run.after" || :
    ) &
    wave="$wave $!"
    inflight=$((inflight + 1))
    if [ "$inflight" -ge "$width" ]; then
      # A full wave, of three or of one: wait each pid before the next
      # wave starts. A wave of one is started in the background all the
      # same: a TERM or INT the gate traps runs at once in a wait, and
      # only after the command returns when that runs in the foreground.
      # A re-run's own status waits in its .rc file, so a failed wait here
      # keeps nothing.
      for pid in $wave; do wait "$pid" || true; done
      wave=""
      inflight=0
    fi
  done <"$over"
  for pid in $wave; do wait "$pid" || true; done
  load_end=$(loadedmachine) || load_end=
  st=0
  while read -r pkg secs id; do
    [ -n "$pkg" ] || continue
    run=$runs/$id.out
    # A strict run's re-run is judged by the load around itself, not the
    # batch's. A sample that was never written is an unknown load, which
    # counts as quiet, as it does everywhere else (loadedmachine).
    if [ -n "$YARDR_R1_STRICT" ]; then
      load_start=$(cat "$run.before" 2>/dev/null) || load_start=
      load_end=$(cat "$run.after" 2>/dev/null) || load_end=
    fi
    # The re-run's output first, in sorted order, as runlogged printed it
    # where the re-runs ran one after another.
    cat "$run"
    rrc=$(cat "$run.rc" 2>/dev/null) || rrc=1
    [ -n "$rrc" ] || rrc=1
    alone=$(awk '
      function seconds(s, total, n) {
        if (s == "") return -1
        total = 0
        while (match(s, /^[0-9]+([.][0-9]+)?/)) {
          n = substr(s, 1, RLENGTH) + 0
          s = substr(s, RLENGTH + 1)
          if (s ~ /^h/) { total += n * 3600; sub(/^h/, "", s) }
          else if (s ~ /^ms/) { total += n / 1000; sub(/^ms/, "", s) }
          else if (s ~ /^m/) { total += n * 60; sub(/^m/, "", s) }
          else if (s ~ /^µs/) { total += n / 1000000; sub(/^µs/, "", s) }
          else if (s ~ /^us/) { total += n / 1000000; sub(/^us/, "", s) }
          else if (s ~ /^ns/) { total += n / 1000000000; sub(/^ns/, "", s) }
          else if (s ~ /^s/) { total += n; sub(/^s/, "", s) }
          else return -1
        }
        return s == "" ? total : -1
      }
      /^ok[ \t]/ { s = seconds($3); if (s >= 0) { printf "%.9g\n", s; exit } }
    ' "$run")
    if [ "$rrc" = 0 ] && [ -n "$alone" ]; then
      if awk -v s="$alone" 'BEGIN { exit !(s + 0 > 60) }'; then
        if load=$(loadedeither "$load_start" "$load_end"); then
          if [ -n "$YARDR_R1_STRICT" ]; then
            echo "test: R1: $pkg took $secs s in the run, $alone s alone: over budget, loaded machine ($load), not judged"
            # A refusal, not a failure: exit 3, unless a package already
            # failed the run, which still fails it.
            if [ "$st" != 1 ]; then
              st=3
            fi
          else
            echo "test: R1: $pkg took $secs s in the run, $alone s alone: over budget, loaded machine ($load), not failed"
          fi
        else
          echo "test: $pkg took $secs s with -race, $alone s alone, over the 60 s budget (docs/testing.md R1)"
          st=1
        fi
      else
        echo "test: R1: $pkg took $secs s in the run, $alone s alone: under budget, loaded run"
      fi
    else
      echo "test: $pkg took $secs s with -race, over the 60 s budget (docs/testing.md R1), and its re-run alone failed"
      st=1
    fi
  done <"$jobs"
  rm -rf "$runs"
  rm -f "$over" "$jobs"
  return "$st"
}
# The test sleeps over the 500 ms budget (docs/testing.md R2): the file,
# the milliseconds it sleeps, and why it must use the real clock. The gate
# reads literal durations in *_test.go files; a sleep it cannot read, such
# as a variable, is not judged. A row whose site is gone fails nothing
# here; the root package's test counts the rows against the tree, so delete
# the row with the fix. Each row covers one site, including when a file has
# two sleeps with the same duration.
longsleeps='
internal/dispatch/harness_reset_test.go 1000 a session age reads the wall clock, not the dispatchers, so the test sleeps past its 1 s max_age
internal/dispatch/failure_test.go 2050 a session age reads the wall clock, so the test sleeps past its 2 s max_age
internal/server/server_test.go 1000 the drain test holds the store past the grace, then releases it
internal/rpc/stream_test.go 600 the blocked write hits its deadline
contrib/isolated-yard/down_test.go 300000 non-elapsing: the sleeper process waits to be killed at test end
'
# sleepbudget fails the run when a *_test.go file sleeps over the 500 ms
# budget (docs/testing.md R2) at a site the allow-list above does not name.
# A site is time.Sleep with a literal duration: N * time.Unit (N a number)
# or time.Unit alone; anything else is not judged. Line comments are not
# code. The allow-list goes by file, as the reads table does: awk takes no
# newline in -v. It says how many allow-listed sleeps the tree holds, so
# the re-measure can count the real-clock debt.
sleepbudget() {
  t0=$(date +%s)
  st=0
  allow=$(mktemp)
  printf '%s\n' "$longsleeps" >"$allow"
  out=$(grep -rn --include='*_test.go' --exclude-dir=.git 'time\.Sleep(' . 2>/dev/null | awk '
    BEGIN {
      ms["Nanosecond"] = 0.000001
      ms["Microsecond"] = 0.001
      ms["Millisecond"] = 1
      ms["Second"] = 1000
      ms["Minute"] = 60000
      ms["Hour"] = 3600000
    }
    FILENAME == ARGV[1] {
      if ($0 ~ /^[^ ]+ [0-9]+ /) {
        f = $0; sub(/ .*/, "", f)
        m = $0; sub(/^[^ ]+ /, "", m); sub(/ .*/, "", m)
        over[f SUBSEP m]++
      }
      next
    }
    {
      code = $0; sub(/\/\/.*$/, "", code)
      if (code !~ /time\.Sleep\(/) next
      f = code; sub(/:[0-9]+:.*$/, "", f); sub(/^\.\//, "", f)
      line = code; sub(/^[^:]*:/, "", line); sub(/:.*$/, "", line)
      e = code; sub(/.*time\.Sleep\(/, "", e); sub(/\).*$/, "", e)
      n = e; unit = e
      if (match(e, /\*/)) {
        n = substr(e, 1, RSTART - 1); unit = substr(e, RSTART + RLENGTH)
      } else n = 1
      gsub(/ /, "", n); gsub(/ /, "", unit); sub(/^time\./, "", unit)
      if (n !~ /^[0-9.]+$/ || !(unit in ms)) next
      dur = n * ms[unit]
      if (dur <= 500) next
      key = f SUBSEP dur
      if (key in over) {
        seen[key]++
        if (seen[key] > over[key]) {
          printf "test: %s:%s sleeps %s, over the 500 ms budget (docs/testing.md R2)\n", f, line, e
          bad++
        } else nseen++
        next
      }
      printf "test: %s:%s sleeps %s, over the 500 ms budget (docs/testing.md R2)\n", f, line, e
      bad++
    }
    END {
      if (bad > 0) exit 1
      if (nseen > 0) printf "test: %d sleeps over 500 ms allow-listed\n", nseen
    }' "$allow" -) || st=$?
  rm -f "$allow"
  took "$t0" "sleep budgets"
  if [ -n "$out" ]; then printf '%s\n' "$out"; fi
  [ "$st" = 0 ] || exit 1
}
# The non-test Go files over 1000 lines: the file, its ceiling in lines,
# and why it is over. The gate counts every non-test .go file with wc -l;
# a file over its ceiling or an unlisted file over 1000 lines fails every
# run, while a ceiling standing above its file, or a row whose file is
# gone, only warns: the landing settles it (filesizerewrite, which
# merge-local and integrate-train run on what they land), so that two
# changes that shrink the same file, or two neighbouring files, never
# conflict on a row. The ceiling only falls: the landing lowers rows to
# actual, and nothing else edits a row. The root package's test holds the
# rows to non-test Go files.
filesizes='
internal/chat/chat.go 1070 the chat TUI model, state and rendering
internal/cli/beads.go 1098 the bead show, list and history commands and their printing
internal/cli/crew.go 2212 the crew, inbox, mail and memory commands
internal/cli/doctor.go 1243 the doctor examinations and its report
internal/cli/init.go 1600 yard init, onboarding and settings
internal/cli/ops.go 1699 the server, daemon, depot, group, route and session commands
internal/cli/pack.go 2089 pack loading, import planning and its question rounds
internal/cli/peers.go 1564 the peer identity, intake and ping commands
internal/cli/routereport.go 1513 the route report and its rendering
internal/cli/sourcecmd.go 2092 the source command and its builtin checks
