# No renames, here and in the two diffs below: a move is the deletion of the
# old path and the addition of the new, and both are judged. git's rename
# detection lists a pure rename's new path alone, under --name-only and
# under --diff-filter=D, so a file moved out of a tree a package embeds
# (packs/starter/roles/builder.md to docs/design/builder.md) read as one
# new file at a path nothing embeds: no .go file, no embedded file, no
# deletion. The package was not selected, and a landing called it "nothing
# compiled changed" and did not race it (yardr-mwh8). A move costs what a
# deletion does: a landing is the whole suite.
changed=$(git diff --no-renames --name-only "$from")
# A change under conformance/ has its test run whatever else the run tests. A
# whole suite that go.mod or a stray file chose holds the package too, and
# without the mark it would skip the package and pass the change unjudged. A
# deleted path counts, as it does in the table's rows.
if printf '%s\n' "$changed" | grep -q '^conformance/'; then
  YARDR_CONFORMANCE=1
fi
# What is tested: the packages that changed, and
# every package that imports one of them, however far up, since a change
# breaks its importers as easily as itself. go list knows both, with the
# test files counted (-test): each package and test variant with its
# directory, the files it embeds, the patterns that embed them and everything
# it depends on (Deps is already transitive, so no walk is needed: a package
# is in when one of its Deps changed). A package changed when a .go file in
# its directory did, or a file it embeds, which is compiled in like one. A
# file the branch deleted is in no package's list any more, but the patterns
# that embedded it are: a deleted file that one of a package's patterns
# matches counts as that package's change, wherever the pattern sits, below
# the package's directory or beside its Go file (yardr-4z5m). The patterns
# and not the directory, so that a neighbour they do not match (a picture
# beside the pages that docs/ embeds with *.md) is not the package's change
# (yardr-56xw). A _test.go file is imported by nobody: it runs its own
# package's tests only. Any other file is no package's: the table above says
# whose tests read it, and a file the table does not know either runs every
# package.
# pick leaves it in $tmp: run has the packages, rows the lines for the rows
# that fired and for the rows skipped, stray the first file the table does
# not know and how many more there are, embedded the first changed file a
# package embeds.
pick() {
tmp=$(mktemp -d)
printf '%s\n' "$reads" >"$tmp/reads"
printf '%s\n' "$changed" >"$tmp/changed"
git diff --no-renames --name-only --diff-filter=D "$from" >"$tmp/deleted"
# Directories the change deletes: in the base, with no tracked file left in
# the tree. A row naming one is skipped, not stale (below): the branch
# removes the row, but a landing runs the base's copy of this script, whose
# row still names the directory. Judged from git, not from the deleted
# files, which do not say whether the directory has a file left: a
# directory the change moves elsewhere is deleted too.
: >"$tmp/deldirs"
printf '%s\n' "$reads" | awk '{ for (i = 2; i <= NF; i++) print $i }' | sort -u >"$tmp/dirs"
# One ls-files and one ls-tree for the words, not a git per word per way: a
# fork each way cost every plan its seconds (yardr-qach). As the loop did, a
# word is one when the base holds it and the tree holds no tracked file of
# it: a file's own path, or a directory's files below it. A git that fails
# decides nothing, as a failed check of the loop decided nothing.
git ls-files >"$tmp/tracked" || : >"$tmp/tracked"
base_ok=1
git ls-tree -r -t --name-only "$from" >"$tmp/basepaths" 2>/dev/null || base_ok=
awk -v ok="$base_ok" '
  FILENAME == ARGV[1] { base[$0] = 1; next }
  FILENAME == ARGV[2] { tracked[++nt] = $0; next }
  $0 == "" || $0 == "-" { next }
  {
    word = $0
    sub(/\/+$/, "", word)
    if (word == "" || ok == "") { next }
    if (word != "." && !(word in base)) { next }
    if (word == ".") {
      if (nt == 0) { print }
      next
    }
    for (i = 1; i <= nt; i++) {
      t = tracked[i]
      if (t == word || index(t, word "/") == 1) { next }
    }
    print
  }
' "$tmp/basepaths" "$tmp/tracked" "$tmp/dirs" >"$tmp/deldirs"
# The work tree's physical path, once: the awk below and addblackbox cut it off
# the front of each package's directory. git prints it so, and cd with pwd -P
# makes sure (not every BSD has realpath). go list, though, names a directory
# from $PWD when that names the working directory, so a run started through a
# symlink (/tmp for /private/tmp on a Mac) lists the link's path instead, no
# directory starts with the root, and every row names "no package here"
# (yardr-w6mw). go list gets the root as its PWD, so both sides are one string.
# From another directory it ignores that PWD and lists the physical path.
toplevel=$(cd "$(git rev-parse --show-toplevel)" && pwd -P)
t0=$(date +%s)
PWD=$toplevel go list -test -f '{{.ImportPath}}|{{.Dir}}|{{join .Deps ","}}|{{join .EmbedFiles ","}},{{join .TestEmbedFiles ","}},{{join .XTestEmbedFiles ","}}|{{join .EmbedPatterns ","}},{{join .TestEmbedPatterns ","}},{{join .XTestEmbedPatterns ","}}' ./... >"$tmp/pkgs"
# Said by listed, after the run's first line, which a landing prints only
# once it has this list. A plan says what would be tested, and no more.
[ -n "$YARDR_TEST_PLAN" ] || listing=$(took "$t0" "go list -test ./...")
# Not in a pipe or a $(...): a go list or awk that fails must fail the run,
# not read as an empty list.
awk -F'|' -v root="$toplevel" -v rows="$tmp/rows" -v stray="$tmp/stray" -v embedded="$tmp/embedded" '
  # "p [p.test]", "p_test [p.test]" and "p.test" are all package p.
  function base(p) { sub(/ \[.*/, "", p); sub(/\.test$/, "", p); sub(/_test$/, "", p); return p }
  # A go:embed pattern as a regexp over the paths below the package directory
  # that it embeds. A pattern is a glob over whole names (* stays within one);
  # a directory it matches embeds everything under it, less the names that
  # begin with . or _ unless the pattern starts with all:. So: the glob, then
  # any such names below it. A plain name is a glob with no *, and needs no
  # case of its own. Other path.Match syntax is not translated: a deleted file
  # under such a pattern stays unaccounted for, so the whole-suite fallback
  # keeps it from being mistaken for an embedded file.
  function embedre(pat,    all, re, i, c) {
    all = sub(/^all:/, "", pat)
    re = "^"
    for (i = 1; i <= length(pat); i++) {
      c = substr(pat, i, 1)
      if (index("?[\\", c)) return ""
      if (c == "*") re = re "[^/]*"
      else if (index(".+()$^{}|", c)) re = re "\\" c
      else re = re c
    }
    return re (all ? "(/.*)?$" : "(/[^._/][^/]*)*$")
  }
  FILENAME == ARGV[1] { if (split($0, w, " ") > 1) { r++; at[r] = w[1]; by[r] = w[2]; for (i = 3; i in w; i++) by[r] = by[r] " " w[i] } next }
  FILENAME == ARGV[2] { if ($0 != "") gone[$0] = 1; next }
  FILENAME == ARGV[3] { if ($0 != "") { file[$0] = 1; order[++nf] = $0; if ($0 ~ /\.go$/) { gd = $0; if (!sub(/\/[^\/]*$/, "", gd)) gd = "."; if ($0 ~ /_test\.go$/) testdir[gd] = 1; else godir[gd] = 1 } } next }
  FILENAME == ARGV[4] { if ($0 != "") deldir[$0] = 1; next }
  {
    n++; path[n] = base($1); deps[n] = $3
    dir = substr($2, length(root) + 2); if (dir == "") dir = "."
    indir[dir] = path[n]
    if (dir in godir) hit[path[n]] = 1
    if (dir in testdir) run[path[n]] = 1
    pre = (dir == "." ? "" : dir "/")
    m = split($4, e, ",")
    for (i = 1; i <= m; i++) if (e[i] != "") {
      f = pre e[i]
      if (f in file) { hit[path[n]] = 1; known[f] = 1 }
    }
    m = split($5, e, ",")
    for (i = 1; i <= m; i++) if (e[i] != "") {
      rx = embedre(e[i])
      if (rx != "") for (del in gone) if (substr(del, 1, length(pre)) == pre && substr(del, length(pre) + 1) ~ rx) { hit[path[n]] = 1; known[del] = 1 }
    }
  }
  END {
    for (k = 1; k <= n; k++) {
      if (path[k] in hit) { run[path[k]] = 1; continue }
      m = split(deps[k], d, ",")
      for (i = 1; i <= m; i++) if (base(d[i]) in hit) { run[path[k]] = 1; break }
    }
    # The table: which rows the changed files fire, and which changed file
    # nothing accounts for. A row naming a directory that is no package
    # fails the run whether it fired or not, so a stale row is found by
    # the next run, not by the change it would have missed; a row naming
    # a directory the change deletes is skipped instead, with a line, and
    # runs no package.
    for (j = 1; j <= r; j++) {
      m = split(by[j], d, " ")
      for (i = 1; i <= m; i++) if (d[i] != "-" && !(d[i] in indir)) {
        if (d[i] in deldir) print "test: the row for " at[j] " in .yardr/test names " d[i] ", which this change deletes: skipping the row" >rows
        else { print "test: the row for " at[j] " in .yardr/test names " d[i] ", which is no package here" >"/dev/stderr"; bad = 1 }
      }
    }
    if (bad) exit 1
    for (k = 1; k <= nf; k++) {
      f = order[k]; rowed = 0
      # The internal/ row runs the test that scans the Go files of
      # internal/ for event writers, so it matches .go files only: a
      # non-Go file under internal/ that no row of its own names is a
      # stray, and tests everything (yardr-5y4s).
      for (j = 1; j <= r; j++) if ((at[j] ~ /\/$/ ? index(f, at[j]) == 1 : f == at[j]) && !(at[j] == "internal/" && f !~ /\.go$/)) { rowed = 1; if (!fired[j]++) first[j] = f }
      if (!rowed && f !~ /\.go$/ && !(f in known) && !strays++) print f >stray
      if (f in known && !embeds++) print f >embedded
    }
    if (strays > 1) print strays - 1 >stray
    for (j = 1; j <= r; j++) if (fired[j]) {
      m = split(by[j], d, " ")
      for (i = 1; i <= m; i++) if (d[i] != "-" && d[i] in indir) run[indir[d[i]]] = 1
      print "test: " first[j] (fired[j] > 1 ? " and " fired[j] - 1 " more under " at[j] : "") (by[j] == "-" ? " changed: no test reads it" : " changed: read by the tests of " by[j]) >rows
    }
    for (p in run) print p
  }' "$tmp/reads" "$tmp/deleted" "$tmp/changed" "$tmp/deldirs" "$tmp/pkgs" >"$tmp/run"
}
# wholeplain says whether a plain selection covers the whole suite: at
# least 70% of the suite's packages, counted from pick's lists -- its package
# list ($1, test variants folded to their package, as pick's base does)
# against the selection ($2). It reads two files, so the gate's own tests
# feed it canned pairs. The line is 70% and not half (yardr-13mx): nearly all
# the time builders and reviewers waited on the lock went to plain runs of
# half the suite or more, and most of those stopped short of 70% of it, where
# the overload the queue guards against (yardr-f4tr) is two runs of the whole
# suite. If runs under the line overload the machine again, lower it.
wholeplain() {
  total=$(awk -F'|' '{ p=$1; sub(/ \[.*/, "", p); sub(/\.test$/, "", p); sub(/_test$/, "", p); if (!(p in seen)) { seen[p]=1; n++ } } END { print n+0 }' "$1")
  sel=$(awk 'END { print NR }' "$2")
  [ "$((100 * sel))" -ge "$((70 * total))" ]
}
# The race detector is the landing's (docs/testing.md R4, which has the
# measurement): a run without YARDR_LANDING is never raced. A plain go test
# takes no race lock for its race, there being none; a plain run whose step
# covers the whole suite still queues on it as class 1, behind landings
# (lockplain), since two whole-suite runs at once overload the machine.
# plainwhy is what the first line of such a run says when it has
# something to test.
plainwhy="testing without -race (race runs at landing only, docs/testing.md R4)"
# The race detector also looks at compiled code, so a landing that changed
# none has nothing for it: no .go file (a test file too), no file a package
# embeds, and no file deleted (which may have been embedded, and the tree it
# left cannot tell). Every program and every test binary is then built from the
# source the base passed with, and only a test that opens a changed file by
# path can differ, which is what the selection holds. Such a landing tests
# without -race too: a design document once queued for 20 to 35 minutes
# behind other branches' race legs to run one root-package test (yardr-57x5).
# unraced says, once pick has run, whether a landing is one: it has a package
# to test, and nothing it changed is compiled. Every other landing ended in
# whole before this is asked; the checks for a stray, a deletion and an
# embedded file stay so that the answer is true of whoever asks.
unracedwhy="testing without -race"
unraced() {
  [ -s "$tmp/run" ] || return 1
  if grep -q -x -e '.*\.go' "$tmp/changed"; then
    return 1
  fi
  [ ! -s "$tmp/deleted" ] && [ ! -s "$tmp/embedded" ] && [ ! -s "$tmp/stray" ]
}
if [ -n "$YARDR_LANDING" ]; then
  # A landing that changes code runs the selection plus the six
  # black-box suites (docs/testing.md R5). What cannot be selected
  # still runs the whole suite: go.mod and go.sum move every package,
  # a file the table does not know may be read by any test, as in a
  # plain run, and a deleted file is no longer in any package's list
  # of what it embeds, so it cannot be told whether it was. A landing
  # that changes nothing at all is somebody asking for the whole
  # suite (CI on main, a release, the quiet run on the base). What is
  # compiled, for the selection: a .go file and a file a package
  # embeds. go list is asked only when no .go file changed, until the
  # pick below: the source it reads is then the base's.
  if [ -z "$changed" ]; then
    whole "nothing changed $since"
  fi
  file=$(printf '%s\n' "$changed" | grep -x -e go.mod -e go.sum | head -n 1)
  if [ -n "$file" ]; then
    whole "$file changed $since"
  fi
  file=$(git diff --no-renames --name-only --diff-filter=D "$from" | head -n 1)
  if [ -n "$file" ]; then
    whole "$file was deleted $since"
  fi
  pick
  if [ -s "$tmp/stray" ]; then
    read -r file <"$tmp/stray"
    whole "$file, which is read by no known package, changed $since"
  fi
  file=$(printf '%s\n' "$changed" | grep -x -e '.*\.go' | head -n 1)
  if [ -n "$file" ]; then
    whole "$file changed $since" selection
  fi
  if [ -s "$tmp/embedded" ]; then
    whole "$(cat "$tmp/embedded"), which a package embeds, changed $since" selection
  fi
  # Every compiled case above ended in whole: this landing changed nothing
  # compiled, and tests without -race when it tests anything.
  if unraced; then
    echo "test: YARDR_LANDING is set, and nothing compiled changed $since: $unracedwhy"
  else
    echo "test: YARDR_LANDING is set, and nothing compiled changed $since"
  fi
  listed
  built
else
  # go.mod or go.sum moves every package, which asks go for no list of them.
  # Any other change asks first, since a file no row knows moves every
  # package too and the first line says what is tested. It says how only when
  # something is: a run with nothing to test makes no claim about it, as a
  # landing of nothing compiled does not. Every go test below is plain.
  modchanged=
  if printf '%s\n' "$changed" | grep -qx -e go.mod -e go.sum; then
    modchanged=1
  else
    pick
  fi
  if [ -n "$modchanged" ] || [ -s "$tmp/run" ] || [ -s "$tmp/stray" ]; then
    echo "test: what changed $since: $plainwhy"
  else
    echo "test: what changed $since"
  fi
  listed
  built
  if [ -n "$modchanged" ]; then
    echo "test: go.mod or go.sum changed; testing every package"
    [ -z "$YARDR_TEST_PLAN" ] || exit 0
    # The whole suite, so the step queues on the race lock (lockplain).
    lockplain=1
    again go test ./...
    exit 0
  fi
  if [ -s "$tmp/stray" ]; then
    { read -r file; read -r more || more=; } <"$tmp/stray"
    echo "test: $file${more:+ (and $more more)} is read by no known package: testing everything"
    [ -z "$YARDR_TEST_PLAN" ] || exit 0
    # The whole suite, so the step queues on the race lock (lockplain).
    lockplain=1
    again go test ./...
    exit 0
  fi
fi
[ ! -s "$tmp/rows" ] || cat "$tmp/rows"
pkgs=$(sort "$tmp/run")
if [ -z "$pkgs" ]; then
  echo "test: no package changed since $(git rev-parse --short "$from"); no tests to run"
  exit 0
fi
# A run that gets here tests without -race: a plain run always does, and a
# landing gets here only when nothing compiled changed, every other landing
# having ended in whole.
# shellcheck disable=SC2086
echo "test: testing, without -race, what changed, what imports it and what reads it:" $pkgs
[ -z "$YARDR_TEST_PLAN" ] || exit 0
# lockplain queues the step below on the race lock, as class 1 behind
# landings: a selection that covers the whole suite is the overload two of
# them at once are (wholeplain). Smaller selections take no ticket, as ever.
# A run nested in another's leg never queues (YARDR_RACE_HELD, in again).
lockplain=
if wholeplain "$tmp/pkgs" "$tmp/run"; then
  lockplain=1
fi
# shellcheck disable=SC2086
again go test $pkgs
